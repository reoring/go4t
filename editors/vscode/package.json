{
  "name": "go4t",
  "displayName": "go4t",
  "description": "go4t diagnostics, hover, definitions and document symbols",
  "version": "0.1.0",
  "publisher": "go4t",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:go4t"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{ "id": "go4t", "aliases": ["go4t"], "extensions": [".gt"] }],
    "configuration": {
      "title": "go4t",
      "properties": {
        "go4t.executablePath": {
          "type": "string",
          "default": "go4t",
          "description": "Path to the go4t executable (started with the lsp argument)."
        }
      }
    }
  }
}
