{
  "name": "gofx",
  "displayName": "gofx",
  "description": "gofx diagnostics, hover, definitions and document symbols",
  "version": "0.1.0",
  "publisher": "gofx",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:gofx"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{ "id": "gofx", "aliases": ["gofx"], "extensions": [".gfx"] }],
    "configuration": {
      "title": "gofx",
      "properties": {
        "gofx.executablePath": {
          "type": "string",
          "default": "gofx",
          "description": "Path to the gofx executable (started with the lsp argument)."
        }
      }
    }
  }
}
