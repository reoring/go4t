package conc

import "std/list"

extern func fork[A](io IO[A]) IO[Fiber[A]] = "github.com/reoring/go4t/rt".Fork

extern func await[A](f Fiber[A]) IO[A] = "github.com/reoring/go4t/rt".Await

extern func cancel[A](f Fiber[A]) IO[Unit] = "github.com/reoring/go4t/rt".Cancel

extern func parMapIO[A, B](xs List[A], f func(A) IO[B]) IO[List[B]] = "github.com/reoring/go4t/rt".ParMapIO

extern func race[A](a IO[A], b IO[A]) IO[A] = "github.com/reoring/go4t/rt".Race

extern func parBoth[A, B](a IO[A], b IO[B]) IO[(A, B)] = "github.com/reoring/go4t/rt".ParBoth

extern func timeout[A](millis Int, io IO[A]) IO[Option[A]] = "github.com/reoring/go4t/rt".Timeout

extern func withTimeout[A](millis Int, io IO[A]) IO[A] = "github.com/reoring/go4t/rt".WithTimeout
