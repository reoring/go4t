package set

import "std/list"
import "std/prelude"
import "std/string"

extern func emptySet[A]() Set[A] = "github.com/reoring/go4t/rt".EmptySet

extern func setInsertBy[A](s Set[A], a A, cmp func(A, A) Ordering) Set[A] = "github.com/reoring/go4t/rt".SetInsert

extern func setDeleteBy[A](s Set[A], a A, cmp func(A, A) Ordering) Set[A] = "github.com/reoring/go4t/rt".SetDelete

extern func setMemberBy[A](s Set[A], a A, cmp func(A, A) Ordering) Bool = "github.com/reoring/go4t/rt".SetMember

extern func setSize[A](s Set[A]) Int = "github.com/reoring/go4t/rt".SetSize

extern func setFromListBy[A](xs List[A], cmp func(A, A) Ordering) Set[A] = "github.com/reoring/go4t/rt".SetFromList

extern func setToList[A](s Set[A]) List[A] = "github.com/reoring/go4t/rt".SetToList

extern func setUnionBy[A](a Set[A], b Set[A], cmp func(A, A) Ordering) Set[A] = "github.com/reoring/go4t/rt".SetUnion

extern func setIntersectionBy[A](a Set[A], b Set[A], cmp func(A, A) Ordering) Set[A] = "github.com/reoring/go4t/rt".SetIntersection

extern func setDifferenceBy[A](a Set[A], b Set[A], cmp func(A, A) Ordering) Set[A] = "github.com/reoring/go4t/rt".SetDifference

func setInsert[A Ord](s Set[A], a A) Set[A] {
  setInsertBy(s, a, func(x, y) => compare(x, y))
}

func setDelete[A Ord](s Set[A], a A) Set[A] {
  setDeleteBy(s, a, func(x, y) => compare(x, y))
}

func setMember[A Ord](s Set[A], a A) Bool {
  setMemberBy(s, a, func(x, y) => compare(x, y))
}

func setFromList[A Ord](xs List[A]) Set[A] {
  setFromListBy(xs, func(x, y) => compare(x, y))
}

func setUnion[A Ord](a Set[A], b Set[A]) Set[A] {
  setUnionBy(a, b, func(x, y) => compare(x, y))
}

func setIntersection[A Ord](a Set[A], b Set[A]) Set[A] {
  setIntersectionBy(a, b, func(x, y) => compare(x, y))
}

func setDifference[A Ord](a Set[A], b Set[A]) Set[A] {
  setDifferenceBy(a, b, func(x, y) => compare(x, y))
}

instance Show[Set[A]] given Show[A] {
  show(s) {
    "#{" + string.join(", ", map(setToList(s), func(a) => show(a))) + "}"
  }
}

instance Debug[Set[A]] given Debug[A] {
  debug(s) {
    "#{" + string.join(", ", map(setToList(s), func(a) => debug(a))) + "}"
  }
}

instance Eq[Set[A]] given Eq[A] {
  eq(a, b) {
    eq(setToList(a), setToList(b))
  }
}
