package map

import "std/list"
import "std/result"
import "std/string"
import "std/prelude"

extern func emptyMap[K, V]() Map[K, V] = "go4t/rt".EmptyMap

extern func mapInsertBy[K, V](m Map[K, V], k K, v V, cmp func(K, K) Ordering) Map[K, V] = "go4t/rt".MapInsert

extern func mapLookupBy[K, V](m Map[K, V], k K, cmp func(K, K) Ordering) Option[V] = "go4t/rt".MapLookup

extern func mapDeleteBy[K, V](m Map[K, V], k K, cmp func(K, K) Ordering) Map[K, V] = "go4t/rt".MapDelete

extern func mapMemberBy[K, V](m Map[K, V], k K, cmp func(K, K) Ordering) Bool = "go4t/rt".MapMember

extern func mapSize[K, V](m Map[K, V]) Int = "go4t/rt".MapSize

extern func mapFromListBy[K, V](xs List[(K, V)], cmp func(K, K) Ordering) Map[K, V] = "go4t/rt".MapFromList

extern func mapToList[K, V](m Map[K, V]) List[(K, V)] = "go4t/rt".MapToList

extern func mapKeys[K, V](m Map[K, V]) List[K] = "go4t/rt".MapKeys

extern func mapValues[K, V](m Map[K, V]) List[V] = "go4t/rt".MapValues

extern func mapUnionBy[K, V](a Map[K, V], b Map[K, V], cmp func(K, K) Ordering) Map[K, V] = "go4t/rt".MapUnion

extern func mapMap[K, V, W](m Map[K, V], f func(V) W) Map[K, W] = "go4t/rt".MapMap

extern func mapFold[K, V, B](m Map[K, V], init B, f func(B, K, V) B) B = "go4t/rt".MapFold

func mapInsert[K Ord, V](m Map[K, V], k K, v V) Map[K, V] {
  mapInsertBy(m, k, v, func(a, b) => compare(a, b))
}

func mapLookup[K Ord, V](m Map[K, V], k K) Option[V] {
  mapLookupBy(m, k, func(a, b) => compare(a, b))
}

func mapDelete[K Ord, V](m Map[K, V], k K) Map[K, V] {
  mapDeleteBy(m, k, func(a, b) => compare(a, b))
}

func mapMember[K Ord, V](m Map[K, V], k K) Bool {
  mapMemberBy(m, k, func(a, b) => compare(a, b))
}

func mapFromList[K Ord, V](xs List[(K, V)]) Map[K, V] {
  mapFromListBy(xs, func(a, b) => compare(a, b))
}

func mapAdjust[K Ord, V](m Map[K, V], k K, f func(V) V) Map[K, V] {
  match mapLookup(m, k) {
    None => m
    Some(v) => mapInsert(m, k, f(v))
  }
}

func mapAlter[K Ord, V](m Map[K, V], k K, f func(Option[V]) Option[V]) Map[K, V] {
  match f(mapLookup(m, k)) {
    None => mapDelete(m, k)
    Some(v) => mapInsert(m, k, v)
  }
}

func mapUnion[K Ord, V](a Map[K, V], b Map[K, V]) Map[K, V] {
  mapUnionBy(a, b, func(x, y) => compare(x, y))
}

func groupBy[K Ord, A](xs List[A], key func(A) K) Map[K, List[A]] {
  let reversed = fold(xs, emptyMap(), func(groups, a) => mapAlter(groups, key(a), func(previous) => Some(Cons(a, result.fromOption(previous, Nil)))))
  mapMap(reversed, func(group) => reverse(group))
}

instance Show[Map[K, V]] given Show[K], Show[V] {
  show(m) {
    "{" + string.join(", ", map(mapToList(m), func((k, v)) => show(k) + ": " + show(v))) + "}"
  }
}

instance Debug[Map[K, V]] given Debug[K], Debug[V] {
  debug(m) {
    "{" + string.join(", ", map(mapToList(m), func((k, v)) => debug(k) + ": " + debug(v))) + "}"
  }
}

instance Eq[Map[K, V]] given Eq[K], Eq[V] {
  eq(a, b) {
    eq(mapToList(a), mapToList(b))
  }
}

instance Functor[Map[K]] {
  fmap(m, f) {
    mapMap(m, f)
  }
}
