package float

import "std/prelude"

// The bounds are ordinary definitions, not externs, so laws may use them
// (`requires a < float.maxInt()`).
func minInt() Int {
  (-9223372036854775807 - 1)
}

func maxInt() Int {
  9223372036854775807
}

extern func abs(n Int) Int = "github.com/reoring/go4t/rt".AbsInt

extern func showFloat(f Float) String = "github.com/reoring/go4t/rt".ShowFloat

extern func debugFloat(f Float) String = "github.com/reoring/go4t/rt".DebugFloat

extern func eqFloat(a Float, b Float) Bool = "github.com/reoring/go4t/rt".EqFloat

extern func ltFloat(a Float, b Float) Bool = "github.com/reoring/go4t/rt".LtFloat

extern func toFloat(n Int) Float = "github.com/reoring/go4t/rt".ToFloat

extern func truncate(f Float) Int = "github.com/reoring/go4t/rt".Truncate

extern func floor(f Float) Int = "github.com/reoring/go4t/rt".Floor

extern func ceil(f Float) Int = "github.com/reoring/go4t/rt".Ceil

extern func round(f Float) Int = "github.com/reoring/go4t/rt".Round

extern func sqrt(f Float) Float = "github.com/reoring/go4t/rt".Sqrt

extern func pow(x Float, y Float) Float = "github.com/reoring/go4t/rt".Pow

extern func powInt(x Int, y Int) Int = "github.com/reoring/go4t/rt".PowInt

extern func parseFloat(s String) Option[Float] = "github.com/reoring/go4t/rt".ParseFloat

extern func showFloatFixed(f Float, decimals Int) String = "github.com/reoring/go4t/rt".ShowFloatFixed

extern func absFloat(f Float) Float = "github.com/reoring/go4t/rt".AbsFloat

extern func nan() Float = "github.com/reoring/go4t/rt".Nan

extern func isNaN(f Float) Bool = "github.com/reoring/go4t/rt".IsNaN

instance Show[Float] {
  show(a) {
    showFloat(a)
  }
}

instance Debug[Float] {
  debug(a) {
    debugFloat(a)
  }
}

instance Eq[Float] {
  eq(a, b) {
    eqFloat(a, b)
  }
}

instance Ord[Float] {
  compare(a, b) {
    if ltFloat(a, b) {
      LT
    } else if ltFloat(b, a) {
      GT
    } else {
      EQ
    }
  }
}
