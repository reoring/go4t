package float

import "std/prelude"

extern func minInt() Int = "gofx/rt".MinInt

extern func maxInt() Int = "gofx/rt".MaxInt

extern func abs(n Int) Int = "gofx/rt".AbsInt

extern func showFloat(f Float) String = "gofx/rt".ShowFloat

extern func eqFloat(a Float, b Float) Bool = "gofx/rt".EqFloat

extern func ltFloat(a Float, b Float) Bool = "gofx/rt".LtFloat

extern func toFloat(n Int) Float = "gofx/rt".ToFloat

extern func truncate(f Float) Int = "gofx/rt".Truncate

extern func floor(f Float) Int = "gofx/rt".Floor

extern func ceil(f Float) Int = "gofx/rt".Ceil

extern func round(f Float) Int = "gofx/rt".Round

extern func sqrt(f Float) Float = "gofx/rt".Sqrt

extern func pow(x Float, y Float) Float = "gofx/rt".Pow

extern func powInt(x Int, y Int) Int = "gofx/rt".PowInt

extern func parseFloat(s String) Option[Float] = "gofx/rt".ParseFloat

extern func showFloatFixed(f Float, decimals Int) String = "gofx/rt".ShowFloatFixed

extern func absFloat(f Float) Float = "gofx/rt".AbsFloat

extern func nan() Float = "gofx/rt".Nan

extern func isNaN(f Float) Bool = "gofx/rt".IsNaN

instance Show[Float] {
  show(a) {
    showFloat(a)
  }
}

instance Debug[Float] {
  debug(a) {
    show(a)
  }
}

instance Eq[Float] {
  eq(a, b) {
    eqFloat(a, b)
  }
}

instance Ord[Float] {
  compare(a, b) {
    if ltFloat(a, b) {
      LT
    } else if ltFloat(b, a) {
      GT
    } else {
      EQ
    }
  }
}
