package io

import "std/prelude"

type IoError = NotFound(String) | PermissionDenied(String) | AlreadyExists(String) | Timeout | Cancelled | Panic(String) | Network(String) | Failure(String) deriving Eq, Debug

// IoFailure keeps the existing IoError match surface alongside the original Go
// error handle. Failures from ioFail/ioRaise and recovered panics carry None.
type IoFailure = IoFailure{error: IoError, cause: Option[GoError]}

// Debug shows cause presence without inspecting or rendering the opaque handle.
instance Debug[IoFailure] {
  debug(f) {
    let causeText = match f.cause {
      None => "None"
      Some(_) => "Some(<GoError>)"
    }
    "IoFailure(" + debug(f.error) + ", " + causeText + ")"
  }
}

func cause(f IoFailure) Option[GoError] {
  f.cause
}

// The original Go message may differ from ioErrorMessage after classification.
extern func goErrorMessage(e GoError) String = "github.com/reoring/go4t/rt".GoErrorMessage

func ioErrorMessage(e IoError) String {
  match e {
    NotFound(msg) => msg
    PermissionDenied(msg) => msg
    AlreadyExists(msg) => msg
    Timeout => "context deadline exceeded"
    Cancelled => "context canceled"
    Panic(msg) => msg
    Network(msg) => msg
    Failure(msg) => msg
  }
}

instance Show[IoError] {
  show(e) {
    ioErrorMessage(e)
  }
}

extern func ioRaise[A](e IoError) IO[A] = "github.com/reoring/go4t/rt".Raise

// Re-raise the supplied constructor/message and the same Go cause handle.
// Nullary Timeout/Cancelled retain ioErrorMessage's canonical messages.
extern func ioRaiseCause[A](f IoFailure) IO[A] = "github.com/reoring/go4t/rt".RaiseCause

func ioFailWith[E Show, A](e E) IO[A] {
  ioFail(show(e))
}

extern func ioPure[A](a A) IO[A] = "github.com/reoring/go4t/rt".Pure

extern func ioBind[A, B](io IO[A], f func(A) IO[B]) IO[B] = "github.com/reoring/go4t/rt".Bind

// void discards a result so an action fits forEach and other IO[Unit] slots.
func void[A](io IO[A]) IO[Unit] {
  ioBind(io, func(_ignored) => ioPure(unit()))
}

extern func ioFail[A](msg String) IO[A] = "github.com/reoring/go4t/rt".Fail

extern func println(s String) IO[Unit] = "github.com/reoring/go4t/rt".Println

extern func readLine() IO[Option[String]] = "github.com/reoring/go4t/rt".ReadLine

extern func readAll() IO[String] = "github.com/reoring/go4t/rt".ReadAll

extern func args() IO[List[String]] = "github.com/reoring/go4t/rt".Args

extern func exit[A](code Int) IO[A] = "github.com/reoring/go4t/rt".Exit

extern func getEnv(name String) IO[Option[String]] = "github.com/reoring/go4t/rt".GetEnv

extern func tryIO[A](io IO[A]) IO[Result[IoError, A]] = "github.com/reoring/go4t/rt".TryIO

// Like tryIO, but retains the original Go error as Some in IoFailure.cause.
// Existing tryIO and Err(NotFound(_)) matches keep their original IoError shape.
extern func tryIOCause[A](io IO[A]) IO[Result[IoFailure, A]] = "github.com/reoring/go4t/rt".TryIOCause

extern func readFile(path String) IO[String] = "github.com/reoring/go4t/rt".ReadFile

extern func foldLines[B](path String, init B, step func(B, String) IO[B]) IO[B] = "github.com/reoring/go4t/rt".FoldLines

func forEachLine(path String, f func(String) IO[Unit]) IO[Unit] {
  foldLines(path, unit(), func(_ignored, line) => f(line))
}

extern func writeFile(path String, content String) IO[Unit] = "github.com/reoring/go4t/rt".WriteFile

extern func appendFile(path String, content String) IO[Unit] = "github.com/reoring/go4t/rt".AppendFile

extern func fileExists(path String) IO[Bool] = "github.com/reoring/go4t/rt".FileExists

extern func listDir(path String) IO[List[String]] = "github.com/reoring/go4t/rt".ListDir

extern func removeFile(path String) IO[Unit] = "github.com/reoring/go4t/rt".RemoveFile

extern func eprintln(s String) IO[Unit] = "github.com/reoring/go4t/rt".Eprintln

extern func print(s String) IO[Unit] = "github.com/reoring/go4t/rt".Print

extern func nowMillis() IO[Int] = "github.com/reoring/go4t/rt".NowMillis

extern func monotonicMillis() IO[Int] = "github.com/reoring/go4t/rt".MonotonicMillis

extern func formatTime(millis Int, layout String) String = "github.com/reoring/go4t/rt".FormatTime

extern func randomInt(lo Int, hi Int) IO[Int] = "github.com/reoring/go4t/rt".RandomInt

extern func randomFloat() IO[Float] = "github.com/reoring/go4t/rt".RandomFloat

extern func sleep(millis Int) IO[Unit] = "github.com/reoring/go4t/rt".Sleep

instance Functor[IO] {
  fmap(fa, f) {
    ioBind(fa, func(a) => ioPure(f(a)))
  }
}

instance Monad[IO] {
  pure(a) {
    ioPure(a)
  }

  bind(ma, f) {
    ioBind(ma, f)
  }
}
