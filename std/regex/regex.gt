package regex

import "std/list"

extern func regexMatch(pattern String, s String) Bool = "github.com/reoring/go4t/rt".RegexMatch

extern func regexFind(pattern String, s String) Option[String] = "github.com/reoring/go4t/rt".RegexFind

extern func regexFindAll(pattern String, s String) List[String] = "github.com/reoring/go4t/rt".RegexFindAll

extern func regexReplace(pattern String, s String, repl String) String = "github.com/reoring/go4t/rt".RegexReplace

extern func regexSplit(pattern String, s String) List[String] = "github.com/reoring/go4t/rt".RegexSplit

extern func regexCaptures(pattern String, s String) Option[List[String]] = "github.com/reoring/go4t/rt".RegexCaptures
