package list

import "std/prelude"
import "std/array"

type List[A] = Nil | Cons(A, List[A]) deriving Eq, Ord, Debug

instance Functor[List] {
  fmap(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => Cons(f(x), prelude.fmap(rest, f))
    }
  }
}

instance Monad[List] {
  pure(a) {
    Cons(a, Nil)
  }

  bind(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => append(f(x), prelude.bind(rest, f))
    }
  }
}

instance Foldable[List] {
  foldr(fa, init, f) {
    match fa {
      Nil => init
      Cons(a, rest) => f(a, prelude.foldr(rest, init, f))
    }
  }
}

instance Traversable[List] {
  traverse(fa, f) {
    match fa {
      Nil => prelude.pure(Nil)
      Cons(a, rest) => prelude.bind(f(a), func(b) => prelude.fmap(prelude.traverse(rest, f), func(bs) => Cons(b, bs)))
    }
  }
}

func foldl[F[_] Foldable, A, B](fa F[A], init B, f func(B, A) B) B {
  prelude.foldr(fa, func(b B) => b, func(a, next) => func(b) => next(f(b, a)))(init)
}

func toList[F[_] Foldable, A](fa F[A]) List[A] {
  prelude.foldr(fa, Nil, func(a, rest) => Cons(a, rest))
}

func foldMapList[F[_] Foldable, A, B](fa F[A], f func(A) List[B]) List[B] {
  prelude.foldr(fa, Nil, func(a, rest) => append(f(a), rest))
}

instance Show[List[A]] given Show[A] {
  show(xs) {
    match xs {
      Nil => "[]"
      Cons(x, rest) => "[" + fold(rest, show(x), func(acc, a) => acc + ", " + show(a)) + "]"
    }
  }
}

func forEach[M[_] Monad, A](xs List[A], f func(A) M[Unit]) M[Unit] {
  match xs {
    Nil => prelude.pure(unit())
    Cons(x, rest) => prelude.bind(f(x), func(_ignored) => forEach(rest, f))
  }
}

func mapM[M[_] Monad, A, B](xs List[A], f func(A) M[B]) M[List[B]] {
  match xs {
    Nil => prelude.pure(Nil)
    Cons(x, rest) => prelude.bind(f(x), func(y) => prelude.bind(mapM(rest, f), func(ys) => prelude.pure(Cons(y, ys))))
  }
}

func fold[A, B](xs List[A], init B, f func(B, A) B) B {
  match xs {
    Nil => init
    Cons(x, rest) => fold(rest, f(init, x), f)
  }
}

func length[A](xs List[A]) Int {
  fold(xs, 0, func(n, _x) => n + 1)
}

func append[A](xs List[A], ys List[A]) List[A] {
  match xs {
    Nil => ys
    Cons(x, rest) => Cons(x, append(rest, ys))
  }
}

func filter[A](xs List[A], p func(A) Bool) List[A] {
  match xs {
    Nil => Nil
    | Cons(x, rest) => if p(x) {
      Cons(x, filter(rest, p))
    } else {
      filter(rest, p)
    }
  }
}

func reverse[A](xs List[A]) List[A] {
  fold(xs, Nil, func(acc, x) => Cons(x, acc))
}

func zip[A, B](xs List[A], ys List[B]) List[(A, B)] {
  match (xs, ys) {
    (Cons(x, restX), Cons(y, restY)) => Cons((x, y), zip(restX, restY))
    _ => Nil
  }
}

func head[A](xs List[A]) Option[A] {
  match xs {
    Nil => None
    Cons(x, _) => Some(x)
  }
}

func tail[A](xs List[A]) List[A] {
  match xs {
    Nil => Nil
    Cons(_, rest) => rest
  }
}

func take[A](n Int, xs List[A]) List[A] {
  if n <= 0 {
    Nil
  } else {
    match xs {
      Nil => Nil
      Cons(x, rest) => Cons(x, take(n - 1, rest))
    }
  }
}

func drop[A](n Int, xs List[A]) List[A] {
  if n <= 0 {
    xs
  } else {
    match xs {
      Nil => Nil
      Cons(_, rest) => drop(n - 1, rest)
    }
  }
}

func sum(xs List[Int]) Int {
  fold(xs, 0, func(acc, x) => acc + x)
}

func concatMap[A, B](xs List[A], f func(A) List[B]) List[B] {
  prelude.bind(xs, f)
}

func catOptions[A](xs List[Option[A]]) List[A] {
  mapMaybe(xs, func(o) => o)
}

func mapMaybe[A, B](xs List[A], f func(A) Option[B]) List[B] {
  match xs {
    Nil => Nil
    | Cons(x, rest) => match f(x) {
      None => mapMaybe(rest, f)
      Some(y) => Cons(y, mapMaybe(rest, f))
    }
  }
}

func elem[A Eq](x A, xs List[A]) Bool {
  match xs {
    Nil => false
    Cons(y, rest) => eq(x, y) || elem(x, rest)
  }
}

func sortBy[A](xs List[A], cmp func(A, A) Ordering) List[A] {
  array.arrayToList(array.arraySortBy(array.arrayFromList(xs), cmp))
}

func sort[A Ord](xs List[A]) List[A] {
  sortBy(xs, compare)
}

func maximum[A Ord](xs List[A]) Option[A] {
  match xs {
    Nil => None
    | Cons(x, rest) => Some(fold(rest, x, func(best, a) => match compare(a, best) {
      GT => a
      _ => best
    }))
  }
}

func minimum[A Ord](xs List[A]) Option[A] {
  match xs {
    Nil => None
    | Cons(x, rest) => Some(fold(rest, x, func(best, a) => match compare(a, best) {
      LT => a
      _ => best
    }))
  }
}

func zipWith[A, B, C](xs List[A], ys List[B], f func(A, B) C) List[C] {
  zipWithAcc(xs, ys, f, Nil)
}

func zipWithAcc[A, B, C](xs List[A], ys List[B], f func(A, B) C, acc List[C]) List[C] {
  match (xs, ys) {
    (Cons(x, restX), Cons(y, restY)) => zipWithAcc(restX, restY, f, Cons(f(x, y), acc))
    _ => reverse(acc)
  }
}

func unzip[A, B](xs List[(A, B)]) (List[A], List[B]) {
  let (as, bs) = fold(xs, (Nil, Nil), func((as, bs), (a, b)) => (Cons(a, as), Cons(b, bs)))
  (reverse(as), reverse(bs))
}

func any[A](xs List[A], p func(A) Bool) Bool {
  match xs {
    Nil => false
    | Cons(x, rest) => if p(x) {
      true
    } else {
      any(rest, p)
    }
  }
}

func all[A](xs List[A], p func(A) Bool) Bool {
  match xs {
    Nil => true
    | Cons(x, rest) => if p(x) {
      all(rest, p)
    } else {
      false
    }
  }
}

func find[A](xs List[A], p func(A) Bool) Option[A] {
  match xs {
    Nil => None
    | Cons(x, rest) => if p(x) {
      Some(x)
    } else {
      find(rest, p)
    }
  }
}

func findIndex[A](xs List[A], p func(A) Bool) Option[Int] {
  findIndexFrom(xs, p, 0)
}

func findIndexFrom[A](xs List[A], p func(A) Bool, i Int) Option[Int] {
  match xs {
    Nil => None
    | Cons(x, rest) => if p(x) {
      Some(i)
    } else {
      findIndexFrom(rest, p, i + 1)
    }
  }
}

func partition[A](xs List[A], p func(A) Bool) (List[A], List[A]) {
  let (yes, no) = fold(xs, (Nil, Nil), func((yes, no), x) => if p(x) {
    (Cons(x, yes), no)
  } else {
    (yes, Cons(x, no))
  })
  (reverse(yes), reverse(no))
}

func nub[A Eq](xs List[A]) List[A] {
  reverse(fold(xs, Nil, func(seen, x) => if elem(x, seen) {
    seen
  } else {
    Cons(x, seen)
  }))
}

func range(lo Int, hi Int) List[Int] {
  rangeAcc(lo, hi, Nil)
}

func rangeAcc(lo Int, hi Int, acc List[Int]) List[Int] {
  if lo >= hi {
    acc
  } else {
    rangeAcc(lo, hi - 1, Cons(hi - 1, acc))
  }
}

func replicate[A](n Int, x A) List[A] {
  replicateAcc(n, x, Nil)
}

func replicateAcc[A](n Int, x A, acc List[A]) List[A] {
  if n <= 0 {
    acc
  } else {
    replicateAcc(n - 1, x, Cons(x, acc))
  }
}

func intercalate[A](sep List[A], xss List[List[A]]) List[A] {
  match xss {
    Nil => Nil
    Cons(xs, rest) => reverse(fold(rest, reverse(xs), func(acc, ys) => fold(ys, fold(sep, acc, func(zs, x) => Cons(x, zs)), func(zs, y) => Cons(y, zs))))
  }
}

func flatten[A](xss List[List[A]]) List[A] {
  reverse(fold(xss, Nil, func(acc, xs) => fold(xs, acc, func(ys, x) => Cons(x, ys))))
}

func last[A](xs List[A]) Option[A] {
  match xs {
    Nil => None
    Cons(x, Nil) => Some(x)
    Cons(_, rest) => last(rest)
  }
}

func init[A](xs List[A]) List[A] {
  initAcc(xs, Nil)
}

func initAcc[A](xs List[A], acc List[A]) List[A] {
  match xs {
    Nil => reverse(acc)
    Cons(_, Nil) => reverse(acc)
    Cons(x, rest) => initAcc(rest, Cons(x, acc))
  }
}

func splitAt[A](n Int, xs List[A]) (List[A], List[A]) {
  splitAtAcc(n, xs, Nil)
}

func splitAtAcc[A](n Int, xs List[A], acc List[A]) (List[A], List[A]) {
  if n <= 0 {
    (reverse(acc), xs)
  } else {
    match xs {
      Nil => (reverse(acc), Nil)
      Cons(x, rest) => splitAtAcc(n - 1, rest, Cons(x, acc))
    }
  }
}

func span[A](xs List[A], p func(A) Bool) (List[A], List[A]) {
  spanAcc(xs, p, Nil)
}

func spanAcc[A](xs List[A], p func(A) Bool, acc List[A]) (List[A], List[A]) {
  match xs {
    Nil => (reverse(acc), Nil)
    | Cons(x, rest) => if p(x) {
      spanAcc(rest, p, Cons(x, acc))
    } else {
      (reverse(acc), xs)
    }
  }
}

func takeWhile[A](xs List[A], p func(A) Bool) List[A] {
  fst(span(xs, p))
}

func dropWhile[A](xs List[A], p func(A) Bool) List[A] {
  match xs {
    Nil => Nil
    | Cons(x, rest) => if p(x) {
      dropWhile(rest, p)
    } else {
      xs
    }
  }
}

func lookup[K Eq, V](k K, xs List[(K, V)]) Option[V] {
  match xs {
    Nil => None
    | Cons((key, value), rest) => if eq(k, key) {
      Some(value)
    } else {
      lookup(k, rest)
    }
  }
}

func indexed[A](xs List[A]) List[(Int, A)] {
  indexedFrom(xs, 0, Nil)
}

func indexedFrom[A](xs List[A], i Int, acc List[(Int, A)]) List[(Int, A)] {
  match xs {
    Nil => reverse(acc)
    Cons(x, rest) => indexedFrom(rest, i + 1, Cons((i, x), acc))
  }
}

func iterate[A](n Int, x A, f func(A) A) List[A] {
  iterateAcc(n, x, f, Nil)
}

func iterateAcc[A](n Int, x A, f func(A) A, acc List[A]) List[A] {
  if n <= 0 {
    reverse(acc)
  } else if n == 1 {
    reverse(Cons(x, acc))
  } else {
    iterateAcc(n - 1, f(x), f, Cons(x, acc))
  }
}

func product(xs List[Int]) Int {
  fold(xs, 1, func(acc, x) => acc * x)
}

func count[A](xs List[A], p func(A) Bool) Int {
  fold(xs, 0, func(n, x) => if p(x) {
    n + 1
  } else {
    n
  })
}

func unfold[S, A](seed S, step func(S) Option[(A, S)]) List[A] {
  unfoldAcc(seed, step, Nil)
}

func unfoldAcc[S, A](seed S, step func(S) Option[(A, S)], acc List[A]) List[A] {
  match step(seed) {
    None => reverse(acc)
    Some((x, next)) => unfoldAcc(next, step, Cons(x, acc))
  }
}

func chunksOf[A](n Int, xs List[A]) List[List[A]] {
  chunksOfAcc(n, xs, Nil)
}

func chunksOfAcc[A](n Int, xs List[A], acc List[List[A]]) List[List[A]] {
  if n <= 0 {
    reverse(acc)
  } else {
    match xs {
      Nil => reverse(acc)
      | Cons(_, _) => {
        let (chunk, rest) = splitAt(n, xs)
        chunksOfAcc(n, rest, Cons(chunk, acc))
      }
    }
  }
}

func sortOn[A, K Ord](xs List[A], key func(A) K) List[A] {
  let keyed = map(xs, func(x) => (key(x), x))
  map(sortBy(keyed, func((a, _), (b, _)) => compare(a, b)), func((_, x)) => x)
}
