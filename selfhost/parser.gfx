package main

extern func isLower(s String) Bool = "gofx/rt".StartsLower
extern func isUpper(s String) Bool = "gofx/rt".StartsUpper

// Recursive-descent port of parser/parser.go. Parser state keeps the previous
// token position for the same-line record lookahead; failures carry original
// source positions, including when an interpolation starts a nested parser.
// SPEC 3.3 and frozen TypeParam allow one constraint, unlike the Go parser's
// permissive constraint list: a second identifier is diagnosed, never dropped.
// quote and lex are supplied by lexer.gfx; Unicode casing is shared with the
// checker through the runtime externs above. Constructor recognition remains
// ASCII A-Z, exactly as parser.go's isUpper (not Unicode IsUpper).
type PState = PrState{tokens: List[Token], previous: Pos, offset: Int}
type PResult[A] = PrSuccess(A, PState) | PrFailure(Diag)
type Parser[A] = PrParser(func(PState) PResult[A])

func runParser[A](parser Parser[A], state PState) PResult[A] {
  match parser { PrParser(run) => run(state) }
}

instance Functor[Parser] {
  fmap(parser, f) {
    PrParser(func(state) => match runParser(parser, state) {
      PrFailure(d) => PrFailure(d)
      PrSuccess(value, rest) => PrSuccess(f(value), rest)
    })
  }
}

instance Monad[Parser] {
  pure(value) { PrParser(func(state) => PrSuccess(value, state)) }
  bind(parser, f) {
    PrParser(func(state) => match runParser(parser, state) {
      PrFailure(d) => PrFailure(d)
      PrSuccess(value, rest) => runParser(f(value), rest)
    })
  }
}

// Alternatives restore all state. Only the do-bind left side is speculative;
// once '<-' has been consumed, failures in its expression must propagate.
func orElse[A](left Parser[A], right Parser[A]) Parser[A] {
  PrParser(func(state) => match runParser(left, state) {
    PrFailure(_) => runParser(right, state)
    success => success
  })
}

func optional[A](parser Parser[A]) Parser[Option[A]] {
  orElse(fmap(parser, Some), pure(None))
}

func many[A](parser Parser[A]) Parser[List[A]] {
  PrParser(func(state) => match runParser(parser, state) {
    PrFailure(_) => PrSuccess(Nil, state)
    PrSuccess(value, rest) => if rest.offset == state.offset {
      PrFailure(Diag{pos: prCurrent(state).pos, msg: "repeated parser must consume input"})
    } else {
      match runParser(many(parser), rest) {
        PrFailure(d) => PrFailure(d)
        PrSuccess(values, end) => PrSuccess(Cons(value, values), end)
      }
    }
  })
}

func sepBy[A, B](parser Parser[A], separator Parser[B]) Parser[List[A]] {
  orElse(do {
    first <- parser
    rest <- many(do { separator; parser })
    pure(Cons(first, rest))
  }, pure(Nil))
}

func prFail[A](pos Pos, msg String) Parser[A] {
  PrParser(func(state) => PrFailure(Diag{pos: pos, msg: msg}))
}

func prLift[A](result Result[A]) Parser[A] {
  PrParser(func(state) => match result {
    Err(d) => PrFailure(d)
    Ok(value) => PrSuccess(value, state)
  })
}

func prCurrent(state PState) Token {
  match state.tokens {
    Cons(t, _) => t
    Nil => Token{kind: TkEOF, text: "", pos: state.previous, parts: Nil}
  }
}

func prPeek() Parser[Token] { PrParser(func(state) => PrSuccess(prCurrent(state), state)) }

func prLookahead[A](parser Parser[A]) Parser[A] {
  PrParser(func(state) => match runParser(parser, state) {
    PrFailure(d) => PrFailure(d)
    PrSuccess(value, _) => PrSuccess(value, state)
  })
}

func prNext() Parser[Token] {
  PrParser(func(state) => match state.tokens {
    Cons(t, rest) if t.kind != TkEOF =>
      PrSuccess(t, PrState{tokens: rest, previous: t.pos, offset: state.offset + 1})
    _ => PrSuccess(prCurrent(state), state)
  })
}

func prMatches(t Token, kind TokKind, text String) Bool {
  (t.kind == kind || (kind == TkPunct && text == ";" && t.kind == TkSemi)) && t.text == text
}

func prIs(kind TokKind, text String) Parser[Bool] {
  fmap(prPeek(), func(t) => prMatches(t, kind, text))
}

func prAccept(kind TokKind, text String) Parser[Bool] {
  do {
    yes <- prIs(kind, text)
    if yes { do { prNext(); pure(true) } } else { pure(false) }
  }
}


// Token.Show intentionally labels semicolons as newlines; diagnostics instead
// use the reference parser's quoted token text (including explicit/inserted ';').
func prTokenText(t Token) String {
  if t.kind == TkEOF { "end of file" } else { quote(t.text) }
}

func expect(kind TokKind, text String) Parser[Token] {
  do {
    t <- prPeek()
    if prMatches(t, kind, text) { prNext() }
    else { prFail(t.pos, "expected " + quote(text) + ", found " + prTokenText(t)) }
  }
}

func prIdent() Parser[String] {
  do {
    t <- prPeek()
    if t.kind == TkIdent { do { prNext(); pure(t.text) } }
    else { prFail(t.pos, "expected identifier, found " + prTokenText(t)) }
  }
}

func prSkipSemis() Parser[Unit] {
  do {
    yes <- prAccept(TkPunct, ";")
    if yes { prSkipSemis() } else { pure(unit()) }
  }
}

// Required separated lists reject trailing separators. Delimited lists accept
// both empty input and trailing commas, matching the reference's distinct loops.
func prSeparated1[A](item func() Parser[A], separator String) Parser[List[A]] {
  do {
    value <- item()
    more <- prAccept(TkPunct, separator)
    rest <- if more { prSeparated1(item, separator) } else { pure(Nil) }
    pure(Cons(value, rest))
  }
}

func prDelimited[A](item func() Parser[A], close String) Parser[List[A]] {
  do {
    done <- prIs(TkPunct, close)
    if done { pure(Nil) } else { do {
      value <- item()
      more <- prAccept(TkPunct, ",")
      rest <- if more { prDelimited(item, close) } else { pure(Nil) }
      pure(Cons(value, rest))
    } }
  }
}

func prMembers[A](item func() Parser[A]) Parser[List[A]] {
  do {
    prSkipSemis()
    done <- prIs(TkPunct, "}")
    if done { pure(Nil) } else { do {
      value <- item()
      rest <- prMembers(item)
      pure(Cons(value, rest))
    } }
  }
}

func prRun[A](parser Parser[A], tokens List[Token], base Pos) Result[A] {
  match runParser(parser, PrState{tokens: tokens, previous: base, offset: 0}) {
    PrFailure(d) => Err(d)
    PrSuccess(value, _) => Ok(value)
  }
}

func parseFile(name String, src String) Result[File] {
  do {
    tokens <- lex(src, Pos{line: 1, col: 1})
    prRun(prFile(name), tokens, Pos{line: 1, col: 1})
  }
}

func parseExprSource(src String, base Pos) Result[Expr] {
  do {
    tokens <- lex(src, base)
    prRun(do {
      value <- prExpr()
      prSkipSemis()
      t <- prPeek()
      if t.kind == TkEOF { pure(value) }
      else { prFail(t.pos, "expected end of expression, found " + prTokenText(t)) }
    }, tokens, base)
  }
}

func prFile(name String) Parser[File] {
  do {
    prSkipSemis()
    expect(TkKeyword, "package")
    pkg <- prIdent()
    decls <- prDecls()
    pure(File{pkg: pkg, name: name, decls: decls})
  }
}

func prDecls() Parser[List[Decl]] {
  do {
    prSkipSemis()
    t <- prPeek()
    if t.kind == TkEOF { pure(Nil) } else { do {
      decl <- prDecl()
      rest <- prDecls()
      pure(Cons(decl, rest))
    } }
  }
}

func prDecl() Parser[Decl] {
  do {
    t <- prPeek()
    if t.kind != TkKeyword { prFail(t.pos, "expected declaration, found " + prTokenText(t)) }
    else { match t.text {
      "class" => prClassDecl()
      "instance" => prInstanceDecl()
      "type" => prTypeDecl()
      "func" => prFuncDecl(false)
      "extern" => do { prNext(); prFuncDecl(true) }
      _ => prFail(t.pos, "expected declaration, found " + prTokenText(t))
    } }
  }
}

func prUnderscore() Parser[Token] { expect(TkPunct, "_") }

func prTypeParam() Parser[TypeParam] {
  do {
    name <- prIdent()
    higher <- prAccept(TkPunct, "[")
    arity <- if higher { do {
      holes <- prSeparated1(prUnderscore, ",")
      expect(TkPunct, "]")
      pure(length(holes))
    } } else { pure(0) }
    t <- prPeek()
    constraint <- if t.kind == TkIdent { fmap(prIdent(), Some) } else { pure(None) }
    extra <- prPeek()
    if extra.kind == TkIdent { prFail(extra.pos, "type parameter may have at most one constraint") }
    else { pure(unit()) }
    pure(TypeParam{name: name, arity: arity, constraint: constraint})
  }
}

func prTypeParams() Parser[List[TypeParam]] {
  do {
    yes <- prAccept(TkPunct, "[")
    if yes { do {
      params <- prSeparated1(prTypeParam, ",")
      expect(TkPunct, "]")
      pure(params)
    } } else { pure(Nil) }
  }
}

func prParam() Parser[Param] {
  do { name <- prIdent(); typ <- prType(); pure(PName(name, Some(typ))) }
}

func prParams() Parser[List[Param]] {
  do {
    expect(TkPunct, "(")
    params <- prDelimited(prParam, ")")
    expect(TkPunct, ")")
    pure(params)
  }
}

func prMethodSig() Parser[MethodSig] {
  do {
    t <- prPeek()
    name <- prIdent()
    tparams <- prTypeParams()
    params <- prParams()
    ret <- prType()
    pure(MethodSig{pos: t.pos, name: name, tparams: tparams, params: params, ret: ret})
  }
}

func prClassDecl() Parser[Decl] {
  do {
    start <- prNext()
    name <- prIdent()
    expect(TkPunct, "[")
    param <- prTypeParam()
    expect(TkPunct, "]")
    hasSuper <- prAccept(TkPunct, ":")
    super <- if hasSuper { do {
      parent <- prIdent()
      expect(TkPunct, "[")
      arg <- prIdent()
      if arg != param.name { prFail(start.pos, "superclass must be applied to " + param.name) }
      else { pure(unit()) }
      expect(TkPunct, "]")
      pure(Some(parent))
    } } else { pure(None) }
    expect(TkPunct, "{")
    methods <- prMembers(prMethodSig)
    expect(TkPunct, "}")
    pure(DeclClass(ClassDecl{pos: start.pos, name: name, param: param, super: super, methods: methods}))
  }
}

func prHeadParams(seen List[String]) Parser[List[String]] {
  do {
    t <- prPeek()
    name <- prIdent()
    if elem(name, seen) { prFail(t.pos, "duplicate instance type parameter " + name) } else { pure(unit()) }
    more <- prAccept(TkPunct, ",")
    rest <- if more { prHeadParams(Cons(name, seen)) } else { pure(Nil) }
    pure(Cons(name, rest))
  }
}

func prInstanceHead() Parser[(String, List[String])] {
  do {
    t <- prPeek()
    tuple <- prAccept(TkPunct, "(")
    if tuple { do {
      params <- prHeadParams(Nil)
      expect(TkPunct, ")")
      if length(params) < 2 { prFail(t.pos, "tuple instance head needs at least two elements") }
      else { pure(("Tuple" + show(length(params)), params)) }
    } } else { do {
      name <- prIdent()
      applied <- prAccept(TkPunct, "[")
      params <- if applied { do {
        values <- prHeadParams(Nil)
        expect(TkPunct, "]")
        pure(values)
      } } else { pure(Nil) }
      pure((name, params))
    } }
  }
}

func prConstraint(params List[String]) Parser[Constraint] {
  do {
    t <- prPeek()
    className <- prIdent()
    expect(TkPunct, "[")
    p <- prPeek()
    param <- prIdent()
    if !elem(param, params) { prFail(p.pos, "undeclared instance type parameter " + param) } else { pure(unit()) }
    expect(TkPunct, "]")
    pure(Constraint{pos: t.pos, className: className, param: param})
  }
}

func prInstMethod() Parser[InstMethod] {
  do {
    t <- prPeek()
    name <- prIdent()
    expect(TkPunct, "(")
    params <- prDelimited(prIdent, ")")
    expect(TkPunct, ")")
    body <- prBlock()
    pure(InstMethod{pos: t.pos, name: name, params: params, body: body})
  }
}

func prInstanceDecl() Parser[Decl] {
  do {
    start <- prNext()
    className <- prIdent()
    expect(TkPunct, "[")
    (typeCon, params) <- prInstanceHead()
    expect(TkPunct, "]")
    t <- prPeek()
    hasGiven <- prAccept(TkKeyword, "given")
    context <- if hasGiven { do {
      if length(params) == 0 { prFail(t.pos, "given requires instance type parameters") } else { pure(unit()) }
      prSeparated1(func() => prConstraint(params), ",")
    } } else { pure(Nil) }
    expect(TkPunct, "{")
    methods <- prMembers(prInstMethod)
    expect(TkPunct, "}")
    pure(DeclInstance(InstanceDecl{pos: start.pos, className: className, typeCon: typeCon, params: params, context: context, methods: methods}))
  }
}

func prNamedType() Parser[(String, SType)] {
  do { name <- prIdent(); expect(TkPunct, ":"); typ <- prType(); pure((name, typ)) }
}

// Named fields tolerate layout semicolons before/after commas, but not a
// missing comma. The same loop serves record types and record expressions.
func prNamedFields[A](item func() Parser[A]) Parser[List[A]] {
  do {
    value <- item()
    prSkipSemis()
    comma <- prAccept(TkPunct, ",")
    rest <- if comma { do {
      prSkipSemis()
      done <- prIs(TkPunct, "}")
      if done { pure(Nil) } else { prNamedFields(item) }
    } } else { pure(Nil) }
    pure(Cons(value, rest))
  }
}

func prCtor() Parser[CtorDecl] {
  do {
    t <- prPeek()
    name <- prIdent()
    positional <- prAccept(TkPunct, "(")
    if positional { do {
      fields <- prDelimited(prType, ")")
      expect(TkPunct, ")")
      pure(CtorDecl{pos: t.pos, name: name, fields: fields, fieldNames: Nil})
    } } else { do {
      record <- prAccept(TkPunct, "{")
      if record { do {
        prSkipSemis()
        empty <- prIs(TkPunct, "}")
        if empty { prFail(t.pos, "record constructor needs at least one field") } else { pure(unit()) }
        fields <- prNamedFields(prNamedType)
        expect(TkPunct, "}")
        pure(CtorDecl{pos: t.pos, name: name, fields: fmap(fields, snd), fieldNames: fmap(fields, fst)})
      } } else { pure(CtorDecl{pos: t.pos, name: name, fields: Nil, fieldNames: Nil}) }
    } }
  }
}

func prTypeDecl() Parser[Decl] {
  do {
    t <- prNext()
    name <- prIdent()
    parameterized <- prAccept(TkPunct, "[")
    tparams <- if parameterized { do {
      names <- prSeparated1(prIdent, ",")
      expect(TkPunct, "]")
      pure(names)
    } } else { pure(Nil) }
    expect(TkPunct, "=")
    ctors <- prSeparated1(prCtor, "|")
    derived <- prAccept(TkKeyword, "deriving")
    derivings <- if derived { prSeparated1(prIdent, ",") } else { pure(Nil) }
    pure(DeclType(TypeDecl{pos: t.pos, name: name, tparams: tparams, ctors: ctors, derivings: derivings}))
  }
}

func prFuncDecl(isExtern Bool) Parser[Decl] {
  do {
    t <- expect(TkKeyword, "func")
    name <- prIdent()
    tparams <- prTypeParams()
    params <- prParams()
    ret <- prType()
    if isExtern { do {
      expect(TkPunct, "=")
      path <- prPeek()
      if path.kind != TkString { prFail(path.pos, "expected import path string, found " + prTokenText(path)) } else { pure(unit()) }
      prNext()
      expect(TkPunct, ".")
      goName <- prIdent()
      pure(DeclFunc(FuncDecl{pos: t.pos, name: name, tparams: tparams, params: params, ret: ret, body: None, externRef: Some(ExternRef{importPath: path.text, goName: goName})}))
    } } else { do {
      body <- prBlock()
      pure(DeclFunc(FuncDecl{pos: t.pos, name: name, tparams: tparams, params: params, ret: ret, body: Some(body), externRef: None}))
    } }
  }
}

func prType() Parser[SType] {
  do {
    t <- prPeek()
    if prMatches(t, TkKeyword, "func") { do {
      prNext()
      expect(TkPunct, "(")
      params <- prDelimited(prType, ")")
      expect(TkPunct, ")")
      ret <- prType()
      pure(STFunc(t.pos, params, ret))
    } } else if prMatches(t, TkPunct, "(") { do {
      prNext()
      first <- prType()
      tuple <- prAccept(TkPunct, ",")
      if tuple { do {
        rest <- prSeparated1(prType, ",")
        expect(TkPunct, ")")
        pure(STTuple(t.pos, Cons(first, rest)))
      } } else { do { expect(TkPunct, ")"); pure(first) } }
    } } else { do {
      name <- prIdent()
      applied <- prAccept(TkPunct, "[")
      args <- if applied { do {
        values <- prSeparated1(prType, ",")
        expect(TkPunct, "]")
        pure(values)
      } } else { pure(Nil) }
      pure(STName(t.pos, name, args))
    } }
  }
}

// Blocks preserve the reference parser's permissive adjacency: semicolons are
// skipped, not required, and only the last expression is the block's result.
func prBlock() Parser[Block] {
  do {
    t <- expect(TkPunct, "{")
    prSkipSemis()
    prBlockRest(t.pos, Nil)
  }
}

func prBlockRest(pos Pos, stmts List[Stmt]) Parser[Block] {
  do {
    t <- prPeek()
    if prMatches(t, TkPunct, "}") { prFail(t.pos, "block must end with an expression") }
    else if prMatches(t, TkKeyword, "let") { do {
      prNext()
      target <- prBinding()
      typ <- prAnnotation()
      expect(TkPunct, "=")
      value <- prExpr()
      prSkipSemis()
      prBlockRest(pos, Cons(SLet(t.pos, target, typ, value), stmts))
    } } else { do {
      value <- prExpr()
      prSkipSemis()
      done <- prAccept(TkPunct, "}")
      if done { pure(Block{pos: pos, stmts: reverse(stmts), result: value}) }
      else { prBlockRest(pos, Cons(SExpr(value), stmts)) }
    } }
  }
}

func prAnnotation() Parser[Option[SType]] {
  do {
    yes <- prAccept(TkPunct, ":")
    if yes { fmap(prType(), Some) } else { pure(None) }
  }
}

func prUpper(name String) Bool {
  let first = substring(name, 0, 1)
  first >= "A" && first <= "Z"
}

func prSecond() Parser[Token] {
  prLookahead(do { prNext(); prPeek() })
}

func prBinding() Parser[LetTarget] {
  do {
    t <- prPeek()
    following <- prSecond()
    if t.kind == TkIdent && isLower(t.text) && following.kind == TkPunct &&
       (following.text == "=" || following.text == ":" || following.text == "<-") {
      fmap(prIdent(), LName)
    } else { fmap(prPattern(), LPat) }
  }
}

func prExpr() Parser[Expr] {
  do {
    t <- prPeek()
    if t.kind == TkKeyword {
      match t.text {
        "func" => prLambda()
        "do" => do { prNext(); prDo(t.pos) }
        "match" => do { prNext(); prMatch(t.pos) }
        "if" => prIf()
        _ => prBinary(0)
      }
    } else { prBinary(0) }
  }
}

func prLambdaParam() Parser[Param] {
  do {
    t <- prPeek()
    following <- prSecond()
    if t.kind == TkIdent && !prUpper(t.text) && following.text != "@" { do {
      name <- prIdent()
      end <- prPeek()
      typ <- if prMatches(end, TkPunct, ",") || prMatches(end, TkPunct, ")") { pure(None) }
             else { fmap(prType(), Some) }
      pure(PName(name, typ))
    } } else { do {
      pat <- prPattern()
      end <- prPeek()
      if prMatches(end, TkPunct, ",") || prMatches(end, TkPunct, ")") { pure(PParam(pat)) }
      else { prFail(end.pos, "pattern parameters cannot be annotated") }
    } }
  }
}

func prLambda() Parser[Expr] {
  do {
    t <- prNext()
    expect(TkPunct, "(")
    params <- prDelimited(prLambdaParam, ")")
    expect(TkPunct, ")")
    expect(TkPunct, "=>")
    body <- prExpr()
    pure(ELambda(t.pos, params, body))
  }
}

func prBlockExpr() Parser[Expr] {
  do { block <- prBlock(); pure(EBlock(block.pos, block)) }
}

func prIf() Parser[Expr] {
  do {
    t <- expect(TkKeyword, "if")
    cond <- prExpr()
    yes <- prBlockExpr()
    expect(TkKeyword, "else")
    chained <- prIs(TkKeyword, "if")
    no <- if chained { prIf() } else { prBlockExpr() }
    pure(EIf(t.pos, cond, yes, no))
  }
}

func prDo(pos Pos) Parser[Expr] {
  do { expect(TkPunct, "{"); prSkipSemis(); prDoRest(pos, Nil) }
}

func prDoRest(pos Pos, stmts List[DoStmt]) Parser[Expr] {
  do {
    t <- prPeek()
    if prMatches(t, TkPunct, "}") { prFail(t.pos, "do block must end with an expression") }
    else if prMatches(t, TkKeyword, "let") { do {
      prNext()
      target <- prBinding()
      typ <- prAnnotation()
      expect(TkPunct, "=")
      value <- prExpr()
      prSkipSemis()
      prDoRest(pos, Cons(DoLet(t.pos, target, typ, value), stmts))
    } } else { do {
      binding <- optional(do {
        target <- prBinding()
        expect(TkPunct, "<-")
        pure(target)
      })
      match binding {
        Some(target) => do {
          value <- prExpr()
          prSkipSemis()
          prDoRest(pos, Cons(DoBind(t.pos, target, value), stmts))
        }
        None => do {
          value <- prExpr()
          prSkipSemis()
          done <- prAccept(TkPunct, "}")
          if done { pure(EDo(pos, reverse(stmts), value)) }
          else { prDoRest(pos, Cons(DoExpr(value), stmts)) }
        }
      }
    } }
  }
}

func prMatch(pos Pos) Parser[Expr] {
  do {
    value <- prExpr()
    expect(TkPunct, "{")
    prSkipSemis()
    prAccept(TkPunct, "|")
    prSkipSemis()
    arms <- prArms()
    expect(TkPunct, "}")
    match arms {
      Nil => prFail(pos, "match needs at least one arm")
      _ => pure(EMatch(pos, value, arms))
    }
  }
}

func prArmSeparators() Parser[Unit] {
  do {
    t <- prPeek()
    if prMatches(t, TkPunct, ";") || prMatches(t, TkPunct, "|") {
      do { prNext(); prArmSeparators() }
    } else { pure(unit()) }
  }
}

func prArms() Parser[List[Arm]] {
  do {
    t <- prPeek()
    if prMatches(t, TkPunct, "}") { pure(Nil) } else { do {
      pat <- prPattern()
      guarded <- prAccept(TkKeyword, "if")
      guard <- if guarded { fmap(prExpr(), Some) } else { pure(None) }
      expect(TkPunct, "=>")
      body <- prExpr()
      prArmSeparators()
      rest <- prArms()
      pure(Cons(Arm{pos: t.pos, pat: pat, guard: guard, body: body}, rest))
    } }
  }
}

func prPattern() Parser[Pattern] {
  do {
    t <- prPeek()
    match t.kind {
      TkIdent => prIdentPattern(t)
      TkInt => do { value <- prInteger(t, "bad integer literal "); pure(PInt(t.pos, value)) }
      TkString => do { prNext(); pure(PString(t.pos, t.text)) }
      TkKeyword if t.text == "true" || t.text == "false" =>
        do { prNext(); pure(PBool(t.pos, t.text == "true")) }
      TkPunct if t.text == "_" => do { prNext(); pure(PWild(t.pos)) }
      TkPunct if t.text == "(" => do {
        prNext()
        first <- prPattern()
        tuple <- prAccept(TkPunct, ",")
        if tuple { do {
          rest <- prSeparated1(prPattern, ",")
          expect(TkPunct, ")")
          pure(PTuple(t.pos, Cons(first, rest)))
        } } else { do { expect(TkPunct, ")"); pure(first) } }
      }
      _ => prFail(t.pos, "expected pattern, found " + prTokenText(t))
    }
  }
}

func prIdentPattern(t Token) Parser[Pattern] {
  do {
    prNext()
    alias <- prAccept(TkPunct, "@")
    if alias { do {
      if !isLower(t.text) { prFail(t.pos, "as-pattern name must be a lower-case identifier") }
      else { pure(unit()) }
      pat <- prPattern()
      pure(PAs(t.pos, t.text, pat))
    } } else { do {
      positional <- prAccept(TkPunct, "(")
      if positional { do {
        pats <- prDelimited(prPattern, ")")
        expect(TkPunct, ")")
        pure(PCtor(t.pos, t.text, pats))
      } } else if prUpper(t.text) { do {
        record <- prAccept(TkPunct, "{")
        if record { do {
          prSkipSemis()
          (fields, rest) <- prRecordPatternFields(Nil)
          expect(TkPunct, "}")
          if length(fields) == 0 && !rest { prFail(t.pos, "record pattern needs fields or ..") }
          else { pure(PRecord(t.pos, t.text, fields, rest)) }
        } } else { pure(PCtor(t.pos, t.text, Nil)) }
      } } else { pure(PVar(t.pos, t.text)) }
    } }
  }
}

func prRecordPatternFields(seen List[String]) Parser[(List[(String, Pattern)], Bool)] {
  do {
    t <- prPeek()
    if prMatches(t, TkPunct, "}") { pure((Nil, false)) }
    else if prMatches(t, TkPunct, "..") { do {
      prNext()
      prAccept(TkPunct, ",")
      prSkipSemis()
      done <- prIs(TkPunct, "}")
      if done { pure((Nil, true)) } else { prFail(t.pos, ".. must be last in record pattern") }
    } } else { do {
      name <- prIdent()
      if elem(name, seen) { prFail(t.pos, "duplicate field " + name + " in record pattern") }
      else { pure(unit()) }
      expect(TkPunct, ":")
      pat <- prPattern()
      prSkipSemis()
      more <- prAccept(TkPunct, ",")
      (fields, rest) <- if more { do {
        prSkipSemis()
        prRecordPatternFields(Cons(name, seen))
      } } else { pure((Nil, false)) }
      pure((Cons((name, pat), fields), rest))
    } }
  }
}

func prPrecedence(op String) Int {
  match op {
    "||" => 1
    "&&" => 2
    "==" => 3 | "!=" => 3 | "<" => 3 | "<=" => 3 | ">" => 3 | ">=" => 3
    "+" => 4 | "-" => 4
    "*" => 5 | "/" => 5 | "%" => 5
    _ => 0
  }
}

func prBinary(minPrec Int) Parser[Expr] {
  do { left <- prUnary(); prBinaryRest(left, minPrec) }
}

func prBinaryRest(left Expr, minPrec Int) Parser[Expr] {
  do {
    t <- prPeek()
    let prec = prPrecedence(t.text)
    if t.kind != TkPunct || prec <= minPrec { pure(left) } else { do {
      prNext()
      right <- prBinary(prec)
      prBinaryRest(EBinary(t.pos, t.text, left, right), minPrec)
    } }
  }
}

func prUnary() Parser[Expr] {
  do {
    t <- prPeek()
    if t.kind == TkPunct && (t.text == "-" || t.text == "!") { do {
      prNext()
      value <- prUnary()
      pure(EUnary(t.pos, t.text, value))
    } } else { do { value <- prPrimary(); prPostfix(value) } }
  }
}

func prInteger(t Token, prefix String) Parser[Int] {
  do {
    prNext()
    match parseInt(t.text) {
      Some(value) => pure(value)
      None => prFail(t.pos, prefix + t.text)
    }
  }
}

func prPostfix(value Expr) Parser[Expr] {
  do {
    t <- prPeek()
    if prMatches(t, TkPunct, "(") { do {
      prNext()
      args <- prDelimited(prExpr, ")")
      expect(TkPunct, ")")
      prPostfix(ECall(t.pos, value, args))
    } } else if prMatches(t, TkPunct, ".") { do {
      prNext()
      field <- prPeek()
      selected <- if field.kind == TkInt { do {
        index <- prInteger(field, "bad tuple index ")
        pure(ETupleField(t.pos, value, index))
      } } else { do { name <- prIdent(); pure(EField(t.pos, value, name)) } }
      prPostfix(selected)
    } } else { do {
      record <- prRecordAhead()
      if record { do {
        fields <- prRecordFields()
        prPostfix(ERecordUpdate(t.pos, value, fields))
      } } else { pure(value) }
    } }
  }
}

func prDropSemis(tokens List[Token]) List[Token] {
  match tokens {
    Cons(t, rest) if prMatches(t, TkPunct, ";") => prDropSemis(rest)
    _ => tokens
  }
}

func prRecordAhead() Parser[Bool] {
  PrParser(func(state) => {
    let t = prCurrent(state)
    let ahead = if state.offset == 0 || !prMatches(t, TkPunct, "{") || state.previous.line != t.pos.line {
      false
    } else {
      match state.tokens {
        Cons(_, rest) => match prDropSemis(rest) {
          Cons(name, Cons(colon, _)) => name.kind == TkIdent && prMatches(colon, TkPunct, ":")
          _ => false
        }
        _ => false
      }
    }
    PrSuccess(ahead, state)
  })
}

func prNamedExpr() Parser[(String, Expr)] {
  do { name <- prIdent(); expect(TkPunct, ":"); value <- prExpr(); pure((name, value)) }
}

func prRecordFields() Parser[List[(String, Expr)]] {
  do {
    expect(TkPunct, "{")
    prSkipSemis()
    fields <- prNamedFields(prNamedExpr)
    expect(TkPunct, "}")
    pure(fields)
  }
}

func prInterpolation(parts List[InterpPart]) Result[(List[String], List[Expr])] {
  match parts {
    Nil => Ok((Nil, Nil))
    Cons(IPText(text), rest) => do {
      (texts, exprs) <- prInterpolation(rest)
      pure((Cons(text, texts), exprs))
    }
    Cons(IPExpr(src, pos), rest) => do {
      value <- parseExprSource(src, pos)
      (texts, exprs) <- prInterpolation(rest)
      pure((texts, Cons(value, exprs)))
    }
  }
}

func prPrimary() Parser[Expr] {
  do {
    t <- prPeek()
    match t.kind {
      TkIdent => do {
        prNext()
        record <- prRecordAhead()
        if prUpper(t.text) && record { do {
          fields <- prRecordFields()
          pure(ERecordLit(t.pos, t.text, fields))
        } } else { pure(EIdent(t.pos, t.text)) }
      }
      TkInt => do { value <- prInteger(t, "bad integer literal "); pure(EInt(t.pos, value)) }
      TkString => do { prNext(); pure(EString(t.pos, t.text)) }
      TkInterp => do {
        prNext()
        (texts, exprs) <- prLift(prInterpolation(t.parts))
        pure(EInterp(t.pos, texts, exprs))
      }
      TkKeyword if t.text == "true" || t.text == "false" =>
        do { prNext(); pure(EBool(t.pos, t.text == "true")) }
      TkPunct if t.text == "(" => do {
        prNext()
        first <- prExpr()
        tuple <- prAccept(TkPunct, ",")
        if tuple { do {
          rest <- prSeparated1(prExpr, ",")
          expect(TkPunct, ")")
          pure(ETuple(t.pos, Cons(first, rest)))
        } } else { do { expect(TkPunct, ")"); pure(first) } }
      }
      TkPunct if t.text == "{" => prBlockExpr()
      TkPunct if t.text == "[" => do {
        prNext()
        elems <- prDelimited(prExpr, "]")
        expect(TkPunct, "]")
        pure(EList(t.pos, elems))
      }
      _ => prFail(t.pos, "expected expression, found " + prTokenText(t))
    }
  }
}

// Stable, complete S-expression dump for bootstrap/integration diagnostics.
// Positions and file names are retained; lists and options have explicit nodes.
func prDumpNode(tag String, fields List[String]) String {
  "(" + tag + (if length(fields) == 0 { "" } else { " " + join(" ", fields) }) + ")"
}

func prDumpList[A](values List[A], render func(A) String) String {
  prDumpNode("list", fmap(values, render))
}

func prDumpOption[A](value Option[A], render func(A) String) String {
  match value { None => "(none)" | Some(x) => prDumpNode("some", [render(x)]) }
}

func prDumpPos(pos Pos) String { prDumpNode("pos", [show(pos.line), show(pos.col)]) }

func prDumpSType(typ SType) String {
  match typ {
    STName(pos, name, args) => prDumpNode("type-name", [prDumpPos(pos), quote(name), prDumpList(args, prDumpSType)])
    STFunc(pos, params, ret) => prDumpNode("type-func", [prDumpPos(pos), prDumpList(params, prDumpSType), prDumpSType(ret)])
    STTuple(pos, elems) => prDumpNode("type-tuple", [prDumpPos(pos), prDumpList(elems, prDumpSType)])
  }
}

func prDumpTypeParam(param TypeParam) String {
  prDumpNode("type-param", [quote(param.name), show(param.arity), prDumpOption(param.constraint, quote)])
}

func prDumpParam(param Param) String {
  match param {
    PName(name, typ) => prDumpNode("param", [quote(name), prDumpOption(typ, prDumpSType)])
    PParam(pat) => prDumpNode("param-pattern", [prDumpPattern(pat)])
  }
}

func prDumpNamed[A](field (String, A), render func(A) String) String {
  prDumpNode("field", [quote(field.0), render(field.1)])
}

func prDumpPattern(pat Pattern) String {
  match pat {
    PCtor(pos, name, args) => prDumpNode("pat-ctor", [prDumpPos(pos), quote(name), prDumpList(args, prDumpPattern)])
    PVar(pos, name) => prDumpNode("pat-var", [prDumpPos(pos), quote(name)])
    PWild(pos) => prDumpNode("pat-wild", [prDumpPos(pos)])
    PInt(pos, value) => prDumpNode("pat-int", [prDumpPos(pos), show(value)])
    PString(pos, value) => prDumpNode("pat-string", [prDumpPos(pos), quote(value)])
    PBool(pos, value) => prDumpNode("pat-bool", [prDumpPos(pos), show(value)])
    PTuple(pos, elems) => prDumpNode("pat-tuple", [prDumpPos(pos), prDumpList(elems, prDumpPattern)])
    PRecord(pos, name, fields, rest) => prDumpNode("pat-record", [prDumpPos(pos), quote(name),
      prDumpList(fields, func(field) => prDumpNamed(field, prDumpPattern)), show(rest)])
    PAs(pos, name, inner) => prDumpNode("pat-as", [prDumpPos(pos), quote(name), prDumpPattern(inner)])
  }
}

func prDumpTarget(target LetTarget) String {
  match target {
    LName(name) => prDumpNode("name", [quote(name)])
    LPat(pat) => prDumpNode("pattern", [prDumpPattern(pat)])
  }
}

func prDumpStmt(stmt Stmt) String {
  match stmt {
    SLet(pos, target, typ, value) => prDumpNode("let", [prDumpPos(pos), prDumpTarget(target),
      prDumpOption(typ, prDumpSType), prDumpExpr(value)])
    SExpr(value) => prDumpNode("stmt", [prDumpExpr(value)])
  }
}

func prDumpBlock(block Block) String {
  prDumpNode("block", [prDumpPos(block.pos), prDumpList(block.stmts, prDumpStmt), prDumpExpr(block.result)])
}

func prDumpDo(stmt DoStmt) String {
  match stmt {
    DoBind(pos, target, value) => prDumpNode("bind", [prDumpPos(pos), prDumpTarget(target), prDumpExpr(value)])
    DoLet(pos, target, typ, value) => prDumpNode("do-let", [prDumpPos(pos), prDumpTarget(target),
      prDumpOption(typ, prDumpSType), prDumpExpr(value)])
    DoExpr(value) => prDumpNode("do-stmt", [prDumpExpr(value)])
  }
}

func prDumpArm(arm Arm) String {
  prDumpNode("arm", [prDumpPos(arm.pos), prDumpPattern(arm.pat),
    prDumpOption(arm.guard, prDumpExpr), prDumpExpr(arm.body)])
}

func prDumpExpr(expr Expr) String {
  match expr {
    EIdent(pos, name) => prDumpNode("ident", [prDumpPos(pos), quote(name)])
    EInt(pos, value) => prDumpNode("int", [prDumpPos(pos), show(value)])
    EString(pos, value) => prDumpNode("string", [prDumpPos(pos), quote(value)])
    EBool(pos, value) => prDumpNode("bool", [prDumpPos(pos), show(value)])
    EInterp(pos, texts, exprs) => prDumpNode("interp", [prDumpPos(pos), prDumpList(texts, quote), prDumpList(exprs, prDumpExpr)])
    EField(pos, value, name) => prDumpNode("select", [prDumpPos(pos), prDumpExpr(value), quote(name)])
    ETupleField(pos, value, index) => prDumpNode("select-tuple", [prDumpPos(pos), prDumpExpr(value), show(index)])
    ERecordLit(pos, name, fields) => prDumpNode("record", [prDumpPos(pos), quote(name),
      prDumpList(fields, func(field) => prDumpNamed(field, prDumpExpr))])
    ERecordUpdate(pos, value, fields) => prDumpNode("update", [prDumpPos(pos), prDumpExpr(value),
      prDumpList(fields, func(field) => prDumpNamed(field, prDumpExpr))])
    ECall(pos, fun, args) => prDumpNode("call", [prDumpPos(pos), prDumpExpr(fun), prDumpList(args, prDumpExpr)])
    ELambda(pos, params, body) => prDumpNode("lambda", [prDumpPos(pos), prDumpList(params, prDumpParam), prDumpExpr(body)])
    EBlock(pos, block) => prDumpNode("block-expr", [prDumpPos(pos), prDumpBlock(block)])
    EMatch(pos, value, arms) => prDumpNode("match", [prDumpPos(pos), prDumpExpr(value), prDumpList(arms, prDumpArm)])
    EIf(pos, cond, yes, no) => prDumpNode("if", [prDumpPos(pos), prDumpExpr(cond), prDumpExpr(yes), prDumpExpr(no)])
    EDo(pos, stmts, result) => prDumpNode("do", [prDumpPos(pos), prDumpList(stmts, prDumpDo), prDumpExpr(result)])
    EBinary(pos, op, left, right) => prDumpNode("binary", [prDumpPos(pos), quote(op), prDumpExpr(left), prDumpExpr(right)])
    EUnary(pos, op, value) => prDumpNode("unary", [prDumpPos(pos), quote(op), prDumpExpr(value)])
    EList(pos, elems) => prDumpNode("list-expr", [prDumpPos(pos), prDumpList(elems, prDumpExpr)])
    ETuple(pos, elems) => prDumpNode("tuple", [prDumpPos(pos), prDumpList(elems, prDumpExpr)])
  }
}

func prDumpMethod(method MethodSig) String {
  prDumpNode("method", [prDumpPos(method.pos), quote(method.name), prDumpList(method.tparams, prDumpTypeParam),
    prDumpList(method.params, prDumpParam), prDumpSType(method.ret)])
}

func prDumpConstraint(constraint Constraint) String {
  prDumpNode("constraint", [prDumpPos(constraint.pos), quote(constraint.className), quote(constraint.param)])
}

func prDumpInstMethod(method InstMethod) String {
  prDumpNode("instance-method", [prDumpPos(method.pos), quote(method.name),
    prDumpList(method.params, quote), prDumpBlock(method.body)])
}

func prDumpCtor(ctor CtorDecl) String {
  prDumpNode("ctor", [prDumpPos(ctor.pos), quote(ctor.name),
    prDumpList(ctor.fields, prDumpSType), prDumpList(ctor.fieldNames, quote)])
}

func prDumpExtern(ref ExternRef) String {
  prDumpNode("extern", [quote(ref.importPath), quote(ref.goName)])
}

func prDumpDecl(decl Decl) String {
  match decl {
    DeclClass(d) => prDumpNode("class", [prDumpPos(d.pos), quote(d.name), prDumpTypeParam(d.param),
      prDumpOption(d.super, quote), prDumpList(d.methods, prDumpMethod)])
    DeclInstance(d) => prDumpNode("instance", [prDumpPos(d.pos), quote(d.className), quote(d.typeCon),
      prDumpList(d.params, quote), prDumpList(d.context, prDumpConstraint), prDumpList(d.methods, prDumpInstMethod)])
    DeclType(d) => prDumpNode("type", [prDumpPos(d.pos), quote(d.name), prDumpList(d.tparams, quote),
      prDumpList(d.ctors, prDumpCtor), prDumpList(d.derivings, quote)])
    DeclFunc(d) => prDumpNode("func", [prDumpPos(d.pos), quote(d.name), prDumpList(d.tparams, prDumpTypeParam),
      prDumpList(d.params, prDumpParam), prDumpSType(d.ret),
      prDumpOption(d.body, prDumpBlock), prDumpOption(d.externRef, prDumpExtern)])
  }
}

func dumpFile(file File) String {
  prDumpNode("file", [quote(file.pkg), quote(file.name), prDumpList(file.decls, prDumpDecl)])
}
