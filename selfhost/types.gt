package main

import "std/prelude"
import "std/list"
import "std/result"
import "std/string"

// Semantic type operations. CheckState.subst is the only source of meta links.
// Ported from types/unify.go, types/check.go:366-425 and types/let.go:19-74,
// 151-209. Generalization leaves source metas untouched; its caller decides
// when a value-restricted let becomes rigid (types/let.go:267-277).

func typesKindString(k Kind) String {
  match k {
    KStar => "*"
    KArrow(n) => if n <= 0 { "() -> *" } else { "(" + string.repeat("*, ", n - 1) + "*) -> *" }
  }
}

func typesRequireKind(pos Pos, got Kind, want Kind) Check[Unit] {
  if got == want { prelude.pure(unit()) }
  else { checkFail(pos, "kind mismatch: got ${typesKindString(got)}, want ${typesKindString(want)}") }
}

// Pure inspection functions expect zonked types when inference links matter.
func kindOf(t Type) Kind {
  match t {
    TCon(_, k) => k
    TVar(_, k) => k
    TMeta(_, k) => k
    TApp(fun, args) => {
      let remaining = kindArity(kindOf(fun)) - length(args)
      if remaining > 0 { KArrow(remaining) } else { KStar }
    }
    TFunc(_, _) => KStar
  }
}

func typeString(t Type) String {
  match t {
    TCon(name, _) => name
    TVar(name, _) => name
    TMeta(id, _) => "?${id}"
    TApp(fun, args) => typeString(fun) + "[" + string.join(", ", prelude.fmap(args, typeString)) + "]"
    TFunc(params, ret) => "func(" + string.join(", ", prelude.fmap(params, typeString)) + ") " + typeString(ret)
  }
}

func zonk(t Type) Check[Type] {
  match t {
    TMeta(id, _) => do {
      link <- lookupMeta(id)
      match link {
        None => prelude.pure(t)
        Some(bound) => do {
          resolved <- zonk(bound)
          bindMeta(id, resolved)
          prelude.pure(resolved)
        }
      }
    }
    TApp(fun, args) => do {
      resolvedFun <- zonk(fun)
      resolvedArgs <- mapMCheck(args, zonk)
      prelude.pure(tApp(resolvedFun, resolvedArgs))
    }
    TFunc(params, ret) => do {
      resolvedParams <- mapMCheck(params, zonk)
      resolvedRet <- zonk(ret)
      prelude.pure(TFunc(resolvedParams, resolvedRet))
    }
    _ => prelude.pure(t)
  }
}

// Unification only normalizes the current head, rather than deep-zonking
// every subtree again at each recursive step (types/unify.go:53-73).
func typesPrune(t Type) Check[Type] {
  match t {
    TMeta(id, _) => do {
      link <- lookupMeta(id)
      match link {
        None => prelude.pure(t)
        Some(bound) => do {
          resolved <- typesPrune(bound)
          bindMeta(id, resolved)
          prelude.pure(resolved)
        }
      }
    }
    _ => prelude.pure(t)
  }
}

func typesNormalize(t Type) Check[Type] { do {
  resolved <- typesPrune(t)
  match resolved {
    TApp(fun, args) => do {
      resolvedFun <- typesNormalize(fun)
      match resolvedFun {
        TApp(_, _) => prelude.pure(tApp(resolvedFun, args))
        _ => if fun == resolvedFun { prelude.pure(resolved) } else { prelude.pure(tApp(resolvedFun, args)) }
      }
    }
    _ => prelude.pure(resolved)
  }
} }

func typesOccurs(id Int, t Type) Check[Bool] { do {
  resolved <- typesPrune(t)
  match resolved {
    TMeta(other, _) => prelude.pure(id == other)
    TApp(fun, args) => do {
      inHead <- typesOccurs(id, fun)
      if inHead { prelude.pure(true) } else { typesOccursAny(id, args) }
    }
    TFunc(params, ret) => do {
      inParams <- typesOccursAny(id, params)
      if inParams { prelude.pure(true) } else { typesOccurs(id, ret) }
    }
    _ => prelude.pure(false)
  }
} }

func typesOccursAny(id Int, ts List[Type]) Check[Bool] {
  match ts {
    Nil => prelude.pure(false)
    Cons(t, rest) => do {
      found <- typesOccurs(id, t)
      if found { prelude.pure(true) } else { typesOccursAny(id, rest) }
    }
  }
}

func typesBind(pos Pos, id Int, typ Type) Check[Bool] { do {
  occurs <- typesOccurs(id, typ)
  if occurs { do {
    resolved <- zonk(typ)
    checkFail(pos, "occurs check: ?${id} occurs in ${typeString(resolved)}")
  } } else { do {
    bindMeta(id, typ)
    prelude.pure(true)
  } }
} }

// Structural failure returns false so the outermost pair supplies the error.
// Occurs/kind failures keep their specific diagnostics (unify.go:106-171).
func unify(pos Pos, expected Type, actual Type) Check[Unit] { do {
  matched <- typesUnify(pos, expected, actual)
  if matched { prelude.pure(unit()) } else { do {
    e <- zonk(expected)
    a <- zonk(actual)
    checkFail(pos, "type mismatch: expected ${typeString(e)}, got ${typeString(a)}")
  } }
} }

func typesUnify(pos Pos, expected Type, actual Type) Check[Bool] { do {
  e <- typesNormalize(expected)
  a <- typesNormalize(actual)
  typesRequireKind(pos, kindOf(a), kindOf(e))
  match (e, a) {
    (TMeta(id, _), TMeta(other, _)) if id == other => prelude.pure(true)
    (TMeta(id, _), _) => typesBind(pos, id, a)
    (_, TMeta(id, _)) => typesBind(pos, id, e)
    (TCon(name, _), TCon(other, _)) => prelude.pure(name == other)
    (TVar(name, _), TVar(other, _)) => prelude.pure(name == other)
    (TApp(ef, ea), TApp(af, aa)) => {
      let extra = length(ea) - length(aa)
      if extra > 0 {
        typesUnifyApps(pos, tApp(ef, list.take(extra, ea)), list.drop(extra, ea), af, aa)
      } else if extra < 0 {
        typesUnifyApps(pos, ef, ea, tApp(af, list.take(-extra, aa)), list.drop(-extra, aa))
      } else { typesUnifyApps(pos, ef, ea, af, aa) }
    }
    (TFunc(ep, er), TFunc(ap, ar)) =>
      if length(ep) != length(ap) { prelude.pure(false) } else { do {
        paramsMatch <- typesUnifyList(pos, ep, ap)
        if paramsMatch { typesUnify(pos, er, ar) } else { prelude.pure(false) }
      } }
    _ => prelude.pure(false)
  }
} }

func typesUnifyApps(pos Pos, ef Type, ea List[Type], af Type, aa List[Type]) Check[Bool] { do {
  headsMatch <- typesUnify(pos, ef, af)
  if headsMatch { typesUnifyList(pos, ea, aa) } else { prelude.pure(false) }
} }

func typesUnifyList(pos Pos, expected List[Type], actual List[Type]) Check[Bool] {
  match (expected, actual) {
    (Nil, Nil) => prelude.pure(true)
    (Cons(e, es), Cons(a, as)) => do {
      matched <- typesUnify(pos, e, a)
      if matched { typesUnifyList(pos, es, as) } else { prelude.pure(false) }
    }
    _ => prelude.pure(false)
  }
}

func substTVars(mapping TreeMap[String, Type], t Type) Type {
  match t {
    TVar(name, _) => result.fromOption(mapLookup(mapping, name), t)
    TApp(fun, args) => tApp(substTVars(mapping, fun), prelude.fmap(args, func(arg) => substTVars(mapping, arg)))
    TFunc(params, ret) => TFunc(prelude.fmap(params, func(param) => substTVars(mapping, param)), substTVars(mapping, ret))
    _ => t
  }
}

// Accumulate ids in a tree for ascending unique freeMetas, and collect kinds
// in a separate left-to-right traversal for first-appearance generalization.
func typesMetaSet(t Type, found TreeMap[Int, Kind]) TreeMap[Int, Kind] {
  match t {
    TMeta(id, k) => mapInsert(found, id, k)
    TApp(fun, args) => fold(args, typesMetaSet(fun, found), func(acc, arg) => typesMetaSet(arg, acc))
    TFunc(params, ret) => typesMetaSet(ret, fold(params, found, func(acc, param) => typesMetaSet(param, acc)))
    _ => found
  }
}

func freeMetas(t Type) Check[List[Int]] { do {
  resolved <- zonk(t)
  prelude.pure(mapKeys(typesMetaSet(resolved, MEmpty)))
} }

func instantiate(sch Scheme) Check[(Type, List[(String, Type)])] { do {
  entries <- mapMCheck(sch.tparams, func(param) => do {
    meta <- freshMeta(snd(param))
    prelude.pure((fst(param), meta))
  })
  let mapping = mapFromList(entries)
  let constraints = prelude.fmap(sch.constraints, func(c) =>
    (fst(c), substTVars(mapping, TVar(snd(c), KStar))))
  prelude.pure((substTVars(mapping, sch.typ), constraints))
} }

type TypesGeneralization = TypesGeneralization{mapping: TreeMap[Int, Type], revParams: List[(String, Kind)], next: Int}

func typesGeneralizeMetas(t Type, fixed List[Int], collected TypesGeneralization) TypesGeneralization {
  match t {
    TMeta(id, k) =>
      if list.elem(id, fixed) || mapMember(collected.mapping, id) { collected }
      else {
        let name = "t${collected.next}"
        TypesGeneralization{
          mapping: mapInsert(collected.mapping, id, TVar(name, k)),
          revParams: Cons((name, k), collected.revParams), next: collected.next + 1
        }
      }
    TApp(fun, args) => typesGeneralizeList(args, fixed, typesGeneralizeMetas(fun, fixed, collected))
    TFunc(params, ret) => typesGeneralizeMetas(ret, fixed, typesGeneralizeList(params, fixed, collected))
    _ => collected
  }
}

func typesGeneralizeList(ts List[Type], fixed List[Int], collected TypesGeneralization) TypesGeneralization {
  fold(ts, collected, func(acc, t) => typesGeneralizeMetas(t, fixed, acc))
}

func typesReplaceMetas(mapping TreeMap[Int, Type], t Type) Type {
  match t {
    TMeta(id, _) => result.fromOption(mapLookup(mapping, id), t)
    TApp(fun, args) => tApp(typesReplaceMetas(mapping, fun), prelude.fmap(args, func(arg) => typesReplaceMetas(mapping, arg)))
    TFunc(params, ret) => TFunc(prelude.fmap(params, func(param) => typesReplaceMetas(mapping, param)), typesReplaceMetas(mapping, ret))
    _ => t
  }
}

func typesGeneralizeConstraints(constraints List[(String, Type)], mapping TreeMap[Int, Type]) Check[(List[(String, String)], List[(String, Type)])] {
  match constraints {
    Nil => prelude.pure((Nil, Nil))
    Cons(c, rest) => do {
      arg <- zonk(snd(c))
      restResult <- typesGeneralizeConstraints(rest, mapping)
      match arg {
        TMeta(id, _) => match mapLookup(mapping, id) {
          Some(TVar(name, _)) => prelude.pure((Cons((fst(c), name), fst(restResult)), snd(restResult)))
          _ => prelude.pure((fst(restResult), Cons(c, snd(restResult))))
        }
        _ => prelude.pure((fst(restResult), Cons(c, snd(restResult))))
      }
    }
  }
}

func generalize(fixed List[Int], constraints List[(String, Type)], t Type) Check[(Scheme, List[(String, Type)])] { do {
  resolved <- zonk(t)
  let collected = typesGeneralizeMetas(resolved, fixed, TypesGeneralization{mapping: MEmpty, revParams: Nil, next: 0})
  let mapping = collected.mapping
  splitConstraints <- typesGeneralizeConstraints(constraints, mapping)
  let sch = Scheme{
    tparams: reverse(collected.revParams), constraints: fst(splitConstraints),
    typ: typesReplaceMetas(mapping, resolved)
  }
  prelude.pure((sch, snd(splitConstraints)))
} }

func typesValueType(scope TreeMap[String, Type], t SType) Check[Type] { do {
  resolved <- resolveSType(scope, t)
  typesRequireKind(stypePos(t), kindOf(resolved), KStar)
  prelude.pure(resolved)
} }

func typesResolveName(scope TreeMap[String, Type], pos Pos, name String) Check[Type] {
  match mapLookup(scope, name) {
    Some(t) => zonk(t)
    None => do {
      env <- askEnv()
      match mapLookup(env.typeKinds, name) {
        Some(k) => prelude.pure(TCon(name, k))
        None => checkFail(pos, "unknown type ${name}")
      }
    }
  }
}

func resolveSType(scope TreeMap[String, Type], t SType) Check[Type] {
  resolveSTypeVisited(scope, t, Nil)
}

func typesValueVisited(scope TreeMap[String, Type], t SType, seen List[String]) Check[Type] {
  do {
    resolved <- resolveSTypeVisited(scope, t, seen)
    typesRequireKind(stypePos(t), kindOf(resolved), KStar)
    prelude.pure(resolved)
  }
}

func resolveSTypeVisited(scope TreeMap[String, Type], t SType, seen List[String]) Check[Type] {
  match t {
    STName(pos, name, args) => do {
      env <- askEnv()
      match (mapLookup(env.aliases, name), mapLookup(scope, name)) {
        (Some(a), None) => do {
          whenCheck(list.elem(name, seen), checkFail(pos, "type alias cycle involving ${name}"))
          whenCheck(length(args) != length(a.tparams), checkFail(pos, "alias ${name} requires ${length(a.tparams)} type arguments"))
          resolved <- mapMCheck(args, func(arg) => typesValueVisited(scope, arg, seen))
          resolveSTypeVisited(mapFromList(list.zip(a.tparams, resolved)), a.body, Cons(name, seen))
        }
        _ => do {
          base <- typesResolveName(scope, pos, name)
          whenCheck(length(args) > kindArity(kindOf(base)), checkFail(pos, "kind mismatch applying ${name} to ${length(args)} arguments"))
          resolved <- mapMCheck(args, func(arg) => typesValueVisited(scope, arg, seen))
          prelude.pure(tApp(base, resolved))
        }
      }
    }
    STFunc(_, params, ret) => do {
      resultType <- typesValueVisited(scope, ret, seen)
      parameters <- mapMCheck(params, func(param) => typesValueVisited(scope, param, seen))
      prelude.pure(TFunc(parameters, resultType))
    }
    STTuple(pos, elems) => do {
      whenCheck(length(elems) < 2, checkFail(pos, "tuple arity must be >= 2"))
      fields <- mapMCheck(elems, func(item) => typesValueVisited(scope, item, seen))
      prelude.pure(tTuple(fields))
    }
  }
}

// Origins and obligations belong to the body checker, not the substitution.
// Check explicit class ambiguity before any defaults (types/resolve.go:22-34).
// checkWarn stores reverse chronological order, so emit in source order and
// leave the established CheckState.warnings convention intact.
type TypesDefault = TypesDefault{meta: Type, pos: Pos, what: String}

func typesDefaultOrigin(origins TreeMap[Int, (Pos, String)], id Int) Check[(Pos, String)] {
  match mapLookup(origins, id) {
    Some(origin) => prelude.pure(origin)
    None => checkFail(noPos(), "missing default origin for ?${id}")
  }
}

func typesCheckDefaultConstraint(origins TreeMap[Int, (Pos, String)], constraint (String, Type)) Check[Unit] { do {
  arg <- zonk(snd(constraint))
  match mapKeys(typesMetaSet(arg, MEmpty)) {
    Nil => prelude.pure(unit())
    Cons(id, _) => do {
      origin <- typesDefaultOrigin(origins, id)
      checkFail(fst(origin), "unresolved class constraint ${fst(constraint)}[${typeString(arg)}]")
    }
  }
} }

func typesDefaultOne(entry TypesDefault) Check[Unit] {
  match entry.meta {
    TMeta(id, KStar) => do {
      checkWarn(entry.pos, "type of ${entry.what} defaulted to Unit; add an annotation or use the value")
      bindMeta(id, tUnit())
    }
    TMeta(_, k) => checkFail(entry.pos, "cannot infer type constructor of kind ${typesKindString(k)}")
    _ => prelude.pure(unit())
  }
}

func defaultMetas(metas List[Type], origins TreeMap[Int, (Pos, String)], constraints List[(String, Type)]) Check[Unit] { do {
  forEachCheck(constraints, func(constraint) => typesCheckDefaultConstraint(origins, constraint))
  resolved <- mapMCheck(metas, zonk)
  let remaining = fold(resolved, MEmpty, func(found, t) => typesMetaSet(t, found))
  defaults <- mapMCheck(mapToList(remaining), func(entry) => do {
    origin <- typesDefaultOrigin(origins, fst(entry))
    prelude.pure(TypesDefault{meta: TMeta(fst(entry), snd(entry)), pos: fst(origin), what: snd(origin)})
  })
  forEachCheck(list.sortBy(defaults, func(a, b) => compare(a.pos, b.pos)), typesDefaultOne)
} }
