package main

import "std/list"
import "std/result"
import "std/io"

// ===== main.gt — driver (owner: supervisor) =====
// Usage: prog FILE.gt|DIR... [-o OUT.go]
// Loads checkout std modules and file-local imports before checking and generation.
// Without -o the Go source goes to stdout.
// Diagnostics: `file:line:col: message` on stderr, exit 1.


type CliArgs = CliArgs{inputs: List[String], output: Option[String]}

func parseArgs(args List[String], acc CliArgs) CliArgs {
  match args {
    Nil => acc{inputs: reverse(acc.inputs)}
    Cons("-o", Cons(path, rest)) => parseArgs(rest, acc{output: Some(path)})
    Cons(file, rest) => parseArgs(rest, acc{inputs: Cons(file, acc.inputs)})
  }
}

func fail[A](msg String) IO[A] {
  do {
    eprintln(msg)
    io.exit(1)
  }
}

func located(file String, d Diag) String {
  if d.pos.line == 0 { "${file}:1:1: ${d.msg}" } else { "${file}:${d}" }
}

func parseInput(file String) IO[File] {
  do {
    src <- io.readFile(file)
    match parseFile(file, src) {
      CompileErr(d) => fail(located(file, d))
      CompileOk(f) => ioPure(f)
    }
  }
}

func main() IO[Unit] {
  do {
    argv <- io.args()
    let cli = parseArgs(argv, CliArgs{inputs: Nil, output: None})
    files <- match cli.inputs {
      Nil => fail("usage: selfhost FILE.gt|DIR... [-o OUT.go]")
      inputs => loadProgram(inputs)
    }
    let primary = result.fromOption(head(cli.inputs), "main.gt")
    program <- match checkProgram(files) {
      CompileErr(d) => fail(located(primary, d))
      CompileOk(p) => ioPure(p)
    }
    list.forEach(program.warnings, func(w) => eprintln("${primary}:${w.pos}: warning: ${w.msg}"))
    source <- match generate(program, "main") {
      CompileErr(d) => fail(located(primary, d))
      CompileOk(s) => ioPure(s)
    }
    match cli.output {
      None => println(source)
      Some(path) => io.writeFile(path, source)
    }
  }
}
