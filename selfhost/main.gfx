package main

// ===== main.gfx — driver (owner: supervisor) =====
// Usage: prog FILE.gfx... [-o OUT.go]
// Reads the prelude from $GOFX_PRELUDE (default prelude/prelude.gfx), parses
// every input, checks, generates Go. Without -o the Go source goes to stdout.
// Diagnostics: `file:line:col: message` on stderr, exit 1.

extern func readFile(path String) IO[String] = "gofx/rt".ReadFile
extern func writeFile(path String, content String) IO[Unit] = "gofx/rt".WriteFile
extern func eprintln(s String) IO[Unit] = "gofx/rt".Eprintln

type CliArgs = CliArgs{inputs: List[String], output: Option[String]}

func parseArgs(args List[String], acc CliArgs) CliArgs {
  match args {
    Nil => acc{inputs: reverse(acc.inputs)}
    Cons("-o", Cons(path, rest)) => parseArgs(rest, acc{output: Some(path)})
    Cons(file, rest) => parseArgs(rest, acc{inputs: Cons(file, acc.inputs)})
  }
}

func fail[A](msg String) IO[A] {
  do {
    eprintln(msg)
    exit(1)
  }
}

func located(file String, d Diag) String {
  if d.pos.line == 0 { "${file}:1:1: ${d.msg}" } else { "${file}:${d}" }
}

func parseInput(file String) IO[File] {
  do {
    src <- readFile(file)
    match parseFile(file, src) {
      Err(d) => fail(located(file, d))
      Ok(f) => ioPure(f)
    }
  }
}

func main() IO[Unit] {
  do {
    argv <- args()
    let cli = parseArgs(argv, CliArgs{inputs: Nil, output: None})
    preludeEnv <- getEnv("GOFX_PRELUDE")
    let preludePath = fromOption(preludeEnv, "prelude/prelude.gfx")
    prelude <- parseInput(preludePath)
    files <- match cli.inputs {
      Nil => fail("usage: selfhost FILE.gfx... [-o OUT.go]")
      inputs => mapM(inputs, parseInput)
    }
    let primary = fromOption(head(cli.inputs), "main.gfx")
    program <- match checkProgram(Cons(prelude, files)) {
      Err(d) => fail(located(primary, d))
      Ok(p) => ioPure(p)
    }
    forEach(program.warnings, func(w) => eprintln("${primary}:${w.pos}: warning: ${w.msg}"))
    source <- match generate(program, "main") {
      Err(d) => fail(located(primary, d))
      Ok(s) => ioPure(s)
    }
    match cli.output {
      None => println(source)
      Some(path) => writeFile(path, source)
    }
  }
}
