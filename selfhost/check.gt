package main

import "std/prelude"
import "std/list"

// ===== check.gt — the checker monad (contract; owner: supervisor) =====
// Check[A] threads CheckState and short-circuits on the first Diag.

type CheckState = CheckState{nextMeta: Int, subst: TreeMap[Int, Type], warnings: List[Diag], env: Env}

type Check[A] = Check(func(CheckState) (CompileResult[A], CheckState))

func runCheck[A](c Check[A], s CheckState) (CompileResult[A], CheckState) {
  match c { Check(run) => run(s) }
}

func initialState(env Env) CheckState {
  CheckState{nextMeta: 0, subst: MEmpty, warnings: Nil, env: env}
}

instance Functor[Check] {
  fmap(c, f) {
    Check(func(s) => match runCheck(c, s) {
      (CompileErr(e), s2) => (CompileErr(e), s2)
      (CompileOk(a), s2) => (CompileOk(f(a)), s2)
    })
  }
}

instance Monad[Check] {
  pure(a) { Check(func(s) => (CompileOk(a), s)) }
  bind(c, f) {
    Check(func(s) => match runCheck(c, s) {
      (CompileErr(e), s2) => (CompileErr(e), s2)
      (CompileOk(a), s2) => runCheck(f(a), s2)
    })
  }
}

func checkFail[A](pos Pos, msg String) Check[A] {
  Check(func(s) => (CompileErr(Diag{pos: pos, msg: msg}), s))
}

func checkWarn(pos Pos, msg String) Check[Unit] {
  Check(func(s) => (CompileOk(unit()), s{warnings: Cons(Diag{pos: pos, msg: msg}, s.warnings)}))
}

func getState() Check[CheckState] { Check(func(s) => (CompileOk(s), s)) }

func putState(s2 CheckState) Check[Unit] { Check(func(s) => (CompileOk(unit()), s2)) }

func modifyState(f func(CheckState) CheckState) Check[Unit] { Check(func(s) => (CompileOk(unit()), f(s))) }

func askEnv() Check[Env] { Check(func(s) => (CompileOk(s.env), s)) }

func setEnv(env Env) Check[Unit] { modifyState(func(s) => s{env: env}) }

func modifyEnv(f func(Env) Env) Check[Unit] { modifyState(func(s) => s{env: f(s.env)}) }

func liftResult[A](r CompileResult[A]) Check[A] { Check(func(s) => (r, s)) }

// freshMeta allocates an unbound inference variable of the given kind.
func freshMeta(k Kind) Check[Type] {
  Check(func(s) => (CompileOk(TMeta(s.nextMeta, k)), s{nextMeta: s.nextMeta + 1}))
}

// freshName allocates a unique local name (prefix + counter) for desugaring.
func freshName(prefix String) Check[String] {
  Check(func(s) => (CompileOk("${prefix}_${s.nextMeta}"), s{nextMeta: s.nextMeta + 1}))
}

// bindMeta records id := t in the substitution (callers check occurs/kinds).
func bindMeta(id Int, t Type) Check[Unit] {
  modifyState(func(s) => s{subst: mapInsert(s.subst, id, t)})
}

func lookupMeta(id Int) Check[Option[Type]] {
  Check(func(s) => (CompileOk(mapLookup(s.subst, id)), s))
}

// mapMCheck / forEachCheck: Check-specific spellings of the prelude mapM/forEach.
func mapMCheck[A, B](xs List[A], f func(A) Check[B]) Check[List[B]] { list.mapM(xs, f) }

func forEachCheck[A](xs List[A], f func(A) Check[Unit]) Check[Unit] { list.forEach(xs, f) }

func foldCheck[A, B](xs List[A], init B, f func(B, A) Check[B]) Check[B] {
  match xs {
    Nil => prelude.pure(init)
    Cons(x, rest) => do {
      acc <- f(init, x)
      foldCheck(rest, acc, f)
    }
  }
}

func whenCheck(cond Bool, c Check[Unit]) Check[Unit] { if cond { c } else { prelude.pure(unit()) } }
