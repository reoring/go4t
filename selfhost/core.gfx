package main

// ===== core.gfx — elaborated, dictionary-explicit IR (contract; owner: supervisor) =====
// The checker (decls.gfx + infer.gfx) lowers the surface AST into Core; the
// code generator (cg_decls.gfx + cg_expr.gfx) prints Core as Go. Core has no
// types: everything is erased to Go `any`, exactly as in codegen/*.go.
//
// Desugarings performed by the checker (so codegen never sees them):
//   blocks           -> nested CLet / CLetDict / CMatch (pattern lets)
//   do               -> CCall(CMethod("bind", monadDict), [m, CLambda([x], ...)])
//                       with the final expression kept as is
//   lambda patterns  -> CLambda(fresh names, CMatch(...))
//   list literals    -> CCtor("List", "Cons"/"Nil", ...)
//   == != < <= > >=  -> CCall(CMethod("eq"/"compare", dict), ...) wrapped in
//                       CPrim("not"/"ordLt"/"ordLe"/"ordGt"/"ordGe", ...)
//   record patterns  -> CPCtor with positional sub-patterns (CPWild for `..`)
//   record literals  -> CCtor with fields in declaration order

type Core = CLocal(String)                              // local variable / parameter
          | CGlobal(String, List[DictRef])              // top-level function (incl. extern) applied to its dictionaries
          | CMethod(String, DictRef)                    // class method selected from a dictionary
          | CCtorFn(String, String)                     // constructor used as a function value: (data, ctor)
          | CCtor(String, String, List[Core])           // saturated constructor application: (data, ctor, fields)
          | CInt(Int)
          | CString(String)
          | CBool(Bool)
          | CUnit
          | CInterp(List[String], List[(DictRef, Core)]) // texts (n+1) and (Show dict, expr) parts
          | CField(Core, String, String, Int)           // record field: (value, data, ctor, index)
          | CTupleField(Core, Int, Int)                 // (value, arity, index)
          | CRecordUpdate(Core, String, String, Int, List[(Int, Core)])  // (value, data, ctor, fieldCount, replaced)
          | CCall(Core, List[Core])
          | CLambda(List[String], Core)
          | CLet(String, Core, Core)                    // let name = value; body
          | CLetDict(String, List[(String, String)], Core, Core)  // generalised let with constraints: (name, dict params (tparam, class), value, body)
          | CMatch(Core, List[CArm])
          | CIf(Core, Core, Core)
          | CPrim(String, List[Core])                   // see primNames
          | CTuple(List[Core])                          // arity >= 2

// primNames: addInt subInt mulInt divInt modInt negInt addString not and or
// ordLt ordLe ordGt ordGe (the ord* prims take one Ordering argument).
// `and`/`or` are short-circuit.
func primNames() List[String] {
  ["addInt", "subInt", "mulInt", "divInt", "modInt", "negInt", "addString", "not", "and", "or", "ordLt", "ordLe", "ordGt", "ordGe"]
}

type CArm = CArm{pat: CPat, guard: Option[Core], body: Core}

type CPat = CPWild
          | CPVar(String)
          | CPInt(Int)
          | CPString(String)
          | CPBool(Bool)
          | CPCtor(String, String, List[CPat])          // (data, ctor, positional sub-patterns)
          | CPTuple(List[CPat])
          | CPAs(String, CPat)

// ----- program -----
type CoreCtor = CoreCtor{name: String, arity: Int, fieldNames: List[String]}

type CoreData = CoreData{name: String, ctors: List[CoreCtor]}

// CoreClass.methods: (method name, parameter count).
type CoreClass = CoreClass{name: String, super: Option[String], methods: List[(String, Int)]}

// CoreInstance: context entries (tparam, class) become dictionary fields;
// superArgs feed the embedded superclass dictionary (one per entry of the
// superclass instance's context).
type CoreInstance = CoreInstance{class: String, typeCon: String, context: List[(String, String)], superArgs: List[DictRef], methods: List[CoreMethod]}

type CoreMethod = CoreMethod{name: String, params: List[String], body: Core}

type CoreFunc = CoreFunc{name: String, dictParams: List[(String, String)], params: List[String], body: Core}
              | CoreExtern{name: String, importPath: String, goName: String, arity: Int}

// Program: everything codegen needs, in deterministic order (sorted by name
// for datas/classes/funcs; instances sorted by instanceKey).
type Program = Program{datas: List[CoreData], classes: List[CoreClass], instances: List[CoreInstance], funcs: List[CoreFunc], warnings: List[Diag]}
