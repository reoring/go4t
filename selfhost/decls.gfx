package main

// Declaration checking follows the Go checker's passes: reserve every namespace,
// validate superclass graphs, resolve signatures, then collect instances. No AST
// is changed, so the same files can be checked repeatedly. Tables are ordered Maps;
// bodies are checked in source order and only the finished Program is sorted.
func buildEnv(files List[File]) Check[Unit] {
  let ds = concatMap(files, func(f) => f.decls)
  do {
    forEachCheck(ds, declsValidateDeriving)
    forEachCheck(ds, declsCollectName)
    forEachCheck(ds, declsCheckSuperclass)
    forEachCheck(ds, declsCollectSignature)
    forEachCheck(files, declsCollectFileInstances)
    forEachCheck(ds, declsCheckDerivedOrd)
    env <- askEnv()
    forEachCheck(mapValues(env.instances), declsSetSuperArgs)
    declsCheckMain()
  }
}

func declsCheckName(pos Pos, name String) Check[Unit] {
  whenCheck(startsWith(name, "dict_") || startsWith(name, "ext_"), checkFail(pos, "identifier ${quote(name)} uses reserved prefix"))
}

func declsCapitalised(name String) Bool { isUpper(name) }

func declsCheckValueName(pos Pos, name String) Check[Unit] {
  do {
    declsCheckName(pos, name)
    whenCheck(!isLower(name), checkFail(pos, "value name must start with a lower-case letter"))
  }
}

func declsRequire[A](value Option[A], pos Pos, message String) Check[A] {
  match value { Some(x) => pure(x) | None => checkFail(pos, message) }
}

func declsTypeKind(env Env, name String) Option[Kind] {
  match mapLookup(env.typeKinds, name) {
    Some(k) => Some(k)
    None => match isTupleCon(name) {
      Some(n) if name == tupleConName(n) => Some(KArrow(n))
      _ => None
    }
  }
}

func declsReserveType(pos Pos, name String) Check[Unit] {
  do {
    declsCheckName(pos, name)
    env <- askEnv()
    whenCheck(isSome(declsTypeKind(env, name)) || mapMember(env.classes, name), checkFail(pos, "duplicate declaration ${name}"))
  }
}

func declsReserveValue(pos Pos, name String) Check[Unit] {
  do {
    declsCheckValueName(pos, name)
    env <- askEnv()
    whenCheck(mapMember(env.funcs, name) || mapMember(env.methods, name), checkFail(pos, "duplicate declaration ${name}"))
  }
}

func declsCheckTypeParams(pos Pos, names List[String]) Check[Unit] {
  fmap(foldCheck(names, mapEmpty(), func(seen, name) => do {
    declsCheckName(pos, name)
    whenCheck(mapMember(seen, name), checkFail(pos, "duplicate type parameter ${name}"))
    pure(mapInsert(seen, name, true))
  }), func(ignored) => unit())
}

func declsCollectName(d Decl) Check[Unit] {
  match d {
    DeclClass(c) => do {
      declsReserveType(c.pos, c.name)
      declsCheckName(c.pos, c.param.name)
      let info = ClassInfo{name: c.name, param: c.param.name, paramKind: arityKind(c.param.arity), super: c.super, methods: Nil, pos: c.pos}
      modifyEnv(func(e) => e{classes: mapInsert(e.classes, c.name, info)})
      methods <- mapMCheck(c.methods, func(m) => do {
        declsReserveValue(m.pos, m.name)
        let mi = MethodInfo{name: m.name, className: c.name, scheme: monoScheme(tUnit()), arity: length(m.params)}
        modifyEnv(func(e) => e{methods: mapInsert(e.methods, m.name, mi)})
        pure(mi)
      })
      modifyEnv(func(e) => e{classes: mapInsert(e.classes, c.name, info{methods: methods})})
    }
    DeclType(d) => do {
      declsReserveType(d.pos, d.name)
      declsCheckTypeParams(d.pos, d.tparams)
      modifyEnv(func(e) => e{typeKinds: mapInsert(e.typeKinds, d.name, arityKind(length(d.tparams)))})
      ctors <- mapMCheck(zipWithIndex(d.ctors), func(pair) => match pair {
        (i, c) => do {
          declsCheckName(c.pos, c.name)
          whenCheck(!declsCapitalised(c.name), checkFail(c.pos, "constructor name must be capitalised"))
          env <- askEnv()
          whenCheck(mapMember(env.ctors, c.name), checkFail(c.pos, "duplicate declaration ${c.name}"))
          foldCheck(c.fieldNames, mapEmpty(), func(seen, name) => do {
            declsCheckValueName(c.pos, name)
            whenCheck(mapMember(seen, name), checkFail(c.pos, "duplicate field ${name} in constructor ${c.name}"))
            pure(mapInsert(seen, name, true))
          })
          let ci = CtorInfo{name: c.name, data: d.name, tparams: d.tparams, fields: Nil, fieldNames: c.fieldNames, index: i, pos: c.pos}
          modifyEnv(func(e) => e{ctors: mapInsert(e.ctors, c.name, ci)})
          pure(ci)
        }
      })
      let di = DataInfo{name: d.name, tparams: d.tparams, ctors: ctors, pos: d.pos}
      modifyEnv(func(e) => e{datas: mapInsert(e.datas, d.name, di)})
    }
    DeclFunc(f) => do {
      declsReserveValue(f.pos, f.name)
      let fi = FuncInfo{name: f.name, scheme: monoScheme(tUnit()), decl: f}
      modifyEnv(func(e) => e{funcs: mapInsert(e.funcs, f.name, fi)})
    }
    DeclInstance(_) => pure(unit())
  }
}

func superclassChain(className String) Check[List[String]] {
  declsSuperclassChain(className, Nil)
}

func declsSuperclassChain(className String, visited List[String]) Check[List[String]] {
  do {
    env <- askEnv()
    c <- declsRequire(mapLookup(env.classes, className), noPos(), "unknown class ${className}")
    whenCheck(elem(className, visited), checkFail(c.pos, "superclass cycle involving ${className}"))
    match c.super {
      None => pure([className])
      Some(parentName) => do {
        parent <- declsRequire(mapLookup(env.classes, parentName), c.pos, "unknown superclass ${parentName}")
        typesRequireKind(c.pos, c.paramKind, parent.paramKind)
        rest <- declsSuperclassChain(parentName, Cons(className, visited))
        pure(Cons(className, rest))
      }
    }
  }
}

func declsCheckSuperclass(d Decl) Check[Unit] {
  match d {
    DeclClass(c) => do {
      whenCheck(isSome(c.param.constraint), checkFail(c.pos, "class parameter constraints must use the superclass declaration"))
      superclassChain(c.name)
      pure(unit())
    }
    _ => pure(unit())
  }
}

func declsValueType(scope Map[String, Type], t SType) Check[Type] {
  do {
    resolved <- resolveSType(scope, t)
    typesRequireKind(stypePos(t), kindOf(resolved), KStar)
    pure(resolved)
  }
}

func declsAddTypeParam(pos Pos, scope Map[String, Type], p TypeParam) Check[Map[String, Type]] {
  do {
    declsCheckName(pos, p.name)
    whenCheck(mapMember(scope, p.name), checkFail(pos, "duplicate type parameter ${p.name}"))
    match p.constraint {
      None => pure(unit())
      Some(name) => do {
        env <- askEnv()
        c <- declsRequire(mapLookup(env.classes, name), pos, "unknown class ${name}")
        typesRequireKind(pos, arityKind(p.arity), c.paramKind)
      }
    }
    pure(mapInsert(scope, p.name, TVar(p.name, arityKind(p.arity))))
  }
}

func declsConstraints(ps List[TypeParam]) List[(String, String)] {
  concatMap(ps, func(p) => match p.constraint { None => Nil | Some(c) => [(c, p.name)] })
}

func declsScheme(pos Pos, ps List[TypeParam], params List[Param], ret SType, initial Map[String, Type]) Check[Scheme] {
  do {
    scope <- foldCheck(ps, initial, func(s, p) => declsAddTypeParam(pos, s, p))
    resolved <- foldCheck(params, (mapEmpty(), Nil), func(acc, p) => match p {
      PName(name, annotation) => do {
        declsCheckValueName(pos, name)
        whenCheck(mapMember(fst(acc), name), checkFail(pos, "duplicate parameter ${name}"))
        syntax <- declsRequire(annotation, pos, "missing type annotation for parameter ${name}")
        t <- declsValueType(scope, syntax)
        pure((mapInsert(fst(acc), name, true), Cons(t, snd(acc))))
      }
      PParam(_) => checkFail(pos, "function declarations require named parameters")
    })
    result <- declsValueType(scope, ret)
    pure(Scheme{tparams: fmap(ps, func(p) => (p.name, arityKind(p.arity))), constraints: declsConstraints(ps), typ: TFunc(reverse(snd(resolved)), result)})
  }
}

func declsCollectSignature(d Decl) Check[Unit] {
  match d {
    DeclClass(c) => do {
      env <- askEnv()
      info <- declsRequire(mapLookup(env.classes, c.name), c.pos, "unknown class ${c.name}")
      methods <- mapMCheck(c.methods, func(m) => do {
        sch <- declsScheme(m.pos, m.tparams, m.params, m.ret, mapFromList([(info.param, TVar(info.param, info.paramKind))]))
        let full = sch{tparams: Cons((info.param, info.paramKind), sch.tparams), constraints: Cons((c.name, info.param), sch.constraints)}
        let mi = MethodInfo{name: m.name, className: c.name, scheme: full, arity: length(m.params)}
        modifyEnv(func(e) => e{methods: mapInsert(e.methods, m.name, mi)})
        pure(mi)
      })
      modifyEnv(func(e) => e{classes: mapInsert(e.classes, c.name, info{methods: methods})})
    }
    DeclType(d) => do {
      let scope = mapFromList(fmap(d.tparams, func(p) => (p, TVar(p, KStar))))
      ctors <- mapMCheck(d.ctors, func(c) => do {
        env <- askEnv()
        ci <- declsRequire(mapLookup(env.ctors, c.name), c.pos, "unknown constructor ${c.name}")
        fields <- mapMCheck(c.fields, func(t) => declsValueType(scope, t))
        let resolved = ci{fields: fields}
        modifyEnv(func(e) => e{ctors: mapInsert(e.ctors, c.name, resolved)})
        pure(resolved)
      })
      let info = DataInfo{name: d.name, tparams: d.tparams, ctors: ctors, pos: d.pos}
      modifyEnv(func(e) => e{datas: mapInsert(e.datas, d.name, info)})
    }
    DeclFunc(f) => do {
      sch <- declsScheme(f.pos, f.tparams, f.params, f.ret, mapEmpty())
      let info = FuncInfo{name: f.name, scheme: sch, decl: f}
      modifyEnv(func(e) => e{funcs: mapInsert(e.funcs, f.name, info)})
    }
    DeclInstance(_) => pure(unit())
  }
}

func declsValidateDeriving(d Decl) Check[Unit] {
  match d {
    DeclType(t) => fmap(foldCheck(t.derivings, Nil, func(seen, className) => do {
      whenCheck(!elem(className, ["Eq", "Ord", "Show"]), checkFail(t.pos, "cannot derive ${className} for ${t.name}: unknown class"))
      whenCheck(elem(className, seen), checkFail(t.pos, "duplicate deriving class ${className} for ${t.name}"))
      whenCheck((className == "Eq" || className == "Ord") && any(t.ctors, func(c) => any(c.fields, func(f) => match f { STFunc(_, _, _) => true | _ => false })), checkFail(t.pos, "cannot derive ${className} for ${t.name}: field of function type"))
      pure(Cons(className, seen))
    }), func(ignored) => unit())
    _ => pure(unit())
  }
}

func declsCollectFileInstances(file File) Check[Unit] {
  do {
    forEachCheck(file.decls, func(d) => match d { DeclInstance(i) => declsCollectInstance(i, false) | _ => pure(unit()) })
    forEachCheck(file.decls, func(d) => match d {
      DeclType(t) => forEachCheck(t.derivings, func(c) => {
        let contexts = fmap(t.tparams, func(p) => Constraint{pos: t.pos, className: c, param: p})
        declsCollectInstance(InstanceDecl{pos: t.pos, className: c, typeCon: t.name, params: t.tparams, context: contexts, methods: Nil}, true)
      })
      _ => pure(unit())
    })
  }
}

func declsCollectInstance(d InstanceDecl, derived Bool) Check[Unit] {
  do {
    env <- askEnv()
    c <- declsRequire(mapLookup(env.classes, d.className), d.pos, "unknown class ${d.className}")
    k <- declsRequire(declsTypeKind(env, d.typeCon), d.pos, "unknown type constructor ${d.typeCon}")
    let count = length(d.params)
    whenCheck(count > kindArity(k), checkFail(d.pos, "kind mismatch applying ${d.typeCon} to ${count} arguments"))
    let residual = arityKind(kindArity(k) - count)
    if count == 0 { typesRequireKind(d.pos, k, c.paramKind) } else { typesRequireKind(d.pos, c.paramKind, residual) }
    let key = instanceKey(c.name, d.typeCon)
    whenCheck(mapMember(env.instances, key), checkFail(d.pos, "duplicate instance ${c.name}[${d.typeCon}]"))
    declsCheckTypeParams(d.pos, d.params)
    foldCheck(d.context, mapEmpty(), func(seen, constraint) => do {
      required <- declsRequire(mapLookup(env.classes, constraint.className), constraint.pos, "unknown class ${constraint.className}")
      whenCheck(!elem(constraint.param, d.params), checkFail(constraint.pos, "unknown instance type parameter ${constraint.param}"))
      whenCheck(mapMember(seen, constraint.param), checkFail(constraint.pos, "at most one constraint per type parameter ${constraint.param}"))
      typesRequireKind(constraint.pos, KStar, required.paramKind)
      pure(mapInsert(seen, constraint.param, true))
    })
    let partial = kindArity(residual) > 0
    let info = InstanceInfo{className: c.name, typeCon: d.typeCon, fixed: if partial { d.params } else { Nil }, params: if partial { Nil } else { d.params }, context: fmap(d.context, func(x) => (x.className, x.param)), superArgs: Nil, methods: d.methods, derived: derived, pos: d.pos}
    modifyEnv(func(e) => e{instances: mapInsert(e.instances, key, info)})
    if derived { pure(unit()) } else { declsCheckMethods(info, c) }
  }
}

func declsCheckMethods(inst InstanceInfo, c ClassInfo) Check[Unit] {
  do {
    env <- askEnv()
    seen <- foldCheck(inst.methods, mapEmpty(), func(seen, im) => do {
      declsCheckValueName(im.pos, im.name)
      forEachCheck(im.params, func(name) => declsCheckValueName(im.pos, name))
      m <- declsRequire(mapLookup(env.methods, im.name), im.pos, "unknown method ${im.name} in instance ${c.name}")
      whenCheck(m.className != c.name, checkFail(im.pos, "unknown method ${im.name} in instance ${c.name}"))
      whenCheck(mapMember(seen, im.name), checkFail(im.pos, "duplicate method ${im.name}"))
      whenCheck(length(im.params) != m.arity, checkFail(im.pos, "arity mismatch for method ${im.name}: want ${m.arity} parameters, got ${length(im.params)}"))
      pure(mapInsert(seen, im.name, true))
    })
    forEachCheck(c.methods, func(m) => whenCheck(!mapMember(seen, m.name), checkFail(inst.pos, "missing method ${m.name} in instance ${c.name}")))
  }
}

func declsHeadParams(inst InstanceInfo) List[String] {
  if isNone(head(inst.fixed)) { inst.params } else { inst.fixed }
}

func declsInstanceHead(env Env, inst InstanceInfo) Type {
  let k = fromOption(declsTypeKind(env, inst.typeCon), KStar)
  tApp(TCon(inst.typeCon, k), fmap(declsHeadParams(inst), func(p) => TVar(p, KStar)))
}

func declsCheckDerivedOrd(d Decl) Check[Unit] {
  match d {
    DeclType(t) if elem("Ord", t.derivings) => do {
      env <- askEnv()
      whenCheck(!mapMember(env.instances, instanceKey("Eq", t.name)), checkFail(t.pos, "deriving Ord for ${t.name} requires an Eq instance"))
    }
    _ => pure(unit())
  }
}

// Catch only to add dictionary context or rephrase superclass failures. State
// (notably substitutions) is preserved; errors never turn into success values.
func declsMapError[A](action Check[A], f func(Diag) Diag) Check[A] {
  Check(func(s) => match runCheck(action, s) {
    (Err(e), s2) => (Err(f(e)), s2)
    (Ok(a), s2) => (Ok(a), s2)
  })
}

func declsSetSuperArgs(inst InstanceInfo) Check[Unit] {
  do {
    env <- askEnv()
    c <- declsRequire(mapLookup(env.classes, inst.className), inst.pos, "unknown class ${inst.className}")
    match c.super {
      None => pure(unit())
      Some(name) => do {
        parent <- declsRequire(mapLookup(env.instances, instanceKey(name, inst.typeCon)), inst.pos, "no instance ${name}[${inst.typeCon}] (required superclass)")
        let message = "superclass instance ${name}[${inst.typeCon}] context is not implied"
        whenCheck(length(inst.fixed) != length(parent.fixed) || length(inst.params) != length(parent.params), checkFail(inst.pos, message))
        let mapping = mapFromList(zip(declsHeadParams(parent), fmap(declsHeadParams(inst), func(p) => TVar(p, KStar))))
        args <- declsMapError(mapMCheck(parent.context, func(pair) => do {
          t <- declsRequire(mapLookup(mapping, snd(pair)), inst.pos, message)
          resolveDict(inst.context, fst(pair), t)
        }), func(e) => Diag{pos: inst.pos, msg: message})
        modifyEnv(func(e) => e{instances: mapInsert(e.instances, instanceKey(inst.className, inst.typeCon), inst{superArgs: args})})
      }
    }
  }
}

func declsCheckMain() Check[Unit] {
  do {
    env <- askEnv()
    match mapLookup(env.funcs, "main") {
      Some(f) if length(f.scheme.tparams) == 0 && f.scheme.typ == TFunc(Nil, tIO(tUnit())) => pure(unit())
      Some(f) => checkFail(f.decl.pos, "main must have type func() IO[Unit]")
      None => checkFail(Pos{line: 1, col: 1}, "main must have type func() IO[Unit]")
    }
  }
}

func resolveDict(bounds List[(String, String)], className String, t Type) Check[DictRef] {
  do {
    resolved <- zonk(t)
    match resolved {
      TVar(name, _) => declsResolveRigid(className, name, bounds, "")
      TApp(fun, args) => declsResolveHead(bounds, className, resolved, fun, args)
      _ => declsResolveHead(bounds, className, resolved, resolved, Nil)
    }
  }
}

func declsProjectDict(chain List[String], wanted String, dict DictRef) Option[DictRef] {
  match chain {
    Nil => None
    Cons(c, rest) => if c == wanted { Some(dict) } else {
      match rest { Nil => None | Cons(parent, _) => declsProjectDict(rest, wanted, DSuper(parent, dict)) }
    }
  }
}

func declsResolveRigid(className String, name String, remaining List[(String, String)], bound String) Check[DictRef] {
  match remaining {
    Nil => if bound == "" {
      checkFail(noPos(), "no instance ${className}[${name}] (type parameter ${name} has no class constraints)")
    } else {
      checkFail(noPos(), "no instance ${className}[${name}] (type parameter ${name} is constrained only by ${bound})")
    }
    Cons((c, p), rest) => if p != name { declsResolveRigid(className, name, rest, bound) } else {
      do {
        chain <- superclassChain(c)
        match declsProjectDict(chain, className, DParam(name, c)) {
          Some(dict) => pure(dict)
          None => declsResolveRigid(className, name, rest, c)
        }
      }
    }
  }
}

func declsResolveHead(bounds List[(String, String)], className String, whole Type, fun Type, args List[Type]) Check[DictRef] {
  do {
    env <- askEnv()
    match fun {
      TCon(name, _) => match mapLookup(env.instances, instanceKey(className, name)) {
        Some(inst) if length(declsHeadParams(inst)) == length(args) => do {
          let mapping = mapFromList(zip(declsHeadParams(inst), args))
          dictionaries <- mapMCheck(inst.context, func(pair) => declsMapError(do {
            t <- declsRequire(mapLookup(mapping, snd(pair)), inst.pos, "unknown instance type parameter ${snd(pair)}")
            resolveDict(bounds, fst(pair), t)
          }, func(e) => e{msg: e.msg + " (required by instance ${inst.className}[${typeString(declsInstanceHead(env, inst))}])"}))
          pure(DInstance(className, name, dictionaries))
        }
        _ => checkFail(noPos(), "no instance ${className}[${typeString(whole)}]")
      }
      _ => checkFail(noPos(), "no instance ${className}[${typeString(whole)}]")
    }
  }
}

// Deriving emits the same matches as types/derive.go, directly as Core. Field
// dictionaries use normal resolution, including recursive and nested instances.
func declsCtorPattern(c CtorInfo, prefix String) CPat {
  CPCtor(c.data, c.name, fmap(range(0, length(c.fields)), func(i) => if prefix == "" { CPWild } else { CPVar("${prefix}${i}") }))
}

func declsArm(pat CPat, body Core) CArm { CArm{pat: pat, guard: None, body: body} }

func declsOrdering(name String) Core { CCtor("Ordering", name, Nil) }

func declsDerivedFields(inst InstanceInfo, c CtorInfo, method String) Check[List[Core]] {
  mapMCheck(zipWithIndex(c.fields), func(pair) => match pair {
    (i, t) => do {
      dict <- declsMapError(resolveDict(inst.context, inst.className, t), func(e) => e{pos: inst.pos})
      pure(CCall(CMethod(method, dict, Nil, 2), [CLocal("x${i}"), CLocal("y${i}")]))
    }
  })
}

func declsDerivedEq(inst InstanceInfo, data DataInfo) Check[Core] {
  do {
    arms <- mapMCheck(data.ctors, func(c) => do {
      fields <- declsDerivedFields(inst, c, "eq")
      let body = match fields { Nil => CBool(true) | Cons(x, rest) => fold(rest, x, func(a, b) => CPrim("and", [a, b])) }
      pure(declsArm(CPTuple([declsCtorPattern(c, "x"), declsCtorPattern(c, "y")]), body))
    })
    let fallback = if length(data.ctors) > 1 { [declsArm(CPWild, CBool(false))] } else { Nil }
    pure(CMatch(CTuple([CLocal("a"), CLocal("b")]), append(arms, fallback)))
  }
}

func declsDerivedOrd(inst InstanceInfo, data DataInfo) Check[Core] {
  do {
    groups <- mapMCheck(data.ctors, func(c) => do {
      fields <- declsDerivedFields(inst, c, "compare")
      let body = fold(reverse(fields), declsOrdering("EQ"), func(rest, cmp) => CMatch(cmp, [declsArm(CPCtor("Ordering", "EQ", Nil), rest), declsArm(CPVar("o"), CLocal("o"))]))
      let same = declsArm(CPTuple([declsCtorPattern(c, "x"), declsCtorPattern(c, "y")]), body)
      let tags = if c.index < length(data.ctors) - 1 {
        [declsArm(CPTuple([declsCtorPattern(c, ""), CPWild]), declsOrdering("LT")), declsArm(CPTuple([CPWild, declsCtorPattern(c, "")]), declsOrdering("GT"))]
      } else { Nil }
      pure(Cons(same, tags))
    })
    pure(CMatch(CTuple([CLocal("a"), CLocal("b")]), concatMap(groups, func(xs) => xs)))
  }
}

func declsDerivedShow(inst InstanceInfo, data DataInfo) Check[Core] {
  do {
    arms <- mapMCheck(data.ctors, func(c) => do {
      parts <- mapMCheck(zipWithIndex(c.fields), func(pair) => match pair {
        (i, t) => do {
          dict <- declsMapError(resolveDict(inst.context, "Show", t), func(e) => e{pos: inst.pos})
          pure((dict, CLocal("x${i}")))
        }
      })
      let record = length(c.fieldNames) > 0
      let texts = fmap(range(0, length(c.fields)), func(i) => {
        let prefix = if i == 0 { c.name + (if record { "{" } else { "(" }) } else { ", " }
        prefix + (if record { fromOption(nth(c.fieldNames, i), "") + ": " } else { "" })
      })
      let body = if length(c.fields) == 0 { CString(c.name) } else { CInterp(append(texts, [if record { "}" } else { ")" }]), parts) }
      pure(declsArm(declsCtorPattern(c, "x"), body))
    })
    pure(CMatch(CLocal("a"), arms))
  }
}

func declsDictParams(constraints List[(String, String)]) List[(String, String)] {
  fmap(constraints, func(pair) => (snd(pair), fst(pair)))
}

func declsDerivedInstance(inst InstanceInfo) Check[CoreInstance] {
  do {
    env <- askEnv()
    data <- declsRequire(mapLookup(env.datas, inst.typeCon), inst.pos, "unknown type ${inst.typeCon}")
    body <- match inst.className {
      "Eq" => declsDerivedEq(inst, data)
      "Ord" => declsDerivedOrd(inst, data)
      "Show" => declsDerivedShow(inst, data)
      _ => checkFail(inst.pos, "cannot derive ${inst.className} for ${inst.typeCon}: unknown class")
    }
    let name = if inst.className == "Eq" { "eq" } else if inst.className == "Ord" { "compare" } else { "show" }
    let params = if inst.className == "Show" { ["a"] } else { ["a", "b"] }
    pure(CoreInstance{className: inst.className, typeCon: inst.typeCon, context: declsDictParams(inst.context), superArgs: inst.superArgs, methods: [CoreMethod{name: name, dictParams: Nil, params: params, body: body}]})
  }
}

func declsCoreData(data DataInfo) CoreData {
  CoreData{name: data.name, ctors: fmap(data.ctors, func(c) => CoreCtor{name: c.name, arity: length(c.fields), fieldNames: c.fieldNames})}
}

func declsCoreClass(c ClassInfo) CoreClass {
  CoreClass{name: c.name, super: c.super, methods: fmap(c.methods, func(m) => CoreMethodSig{name: m.name, dictParams: declsDictParams(tail(m.scheme.constraints)), arity: m.arity})}
}

func declsCoreFunction(f FuncInfo) Check[CoreFunc] {
  match f.decl.externRef {
    Some(ex) => pure(CoreExtern{name: f.name, importPath: ex.importPath, goName: ex.goName, arity: length(f.decl.params)})
    None => do {
      body <- inferFuncBody(f)
      pure(CoreFunc{name: f.name, dictParams: declsDictParams(f.scheme.constraints), params: fmap(f.decl.params, func(p) => match p { PName(name, _) => name | PParam(_) => "" }), body: body})
    }
  }
}

func declsCoreInstance(inst InstanceInfo) Check[CoreInstance] {
  if inst.derived { declsDerivedInstance(inst) } else {
    do {
      env <- askEnv()
      c <- declsRequire(mapLookup(env.classes, inst.className), inst.pos, "unknown class ${inst.className}")
      declsCheckMethods(inst, c)
      methods <- mapMCheck(inst.methods, func(im) => do {
        m <- declsRequire(mapLookup(env.methods, im.name), im.pos, "unknown method ${im.name} in instance ${inst.className}")
        body <- inferInstanceMethod(inst, m, im)
        pure(CoreMethod{name: im.name, dictParams: declsDictParams(tail(m.scheme.constraints)), params: im.params, body: body})
      })
      pure(CoreInstance{className: inst.className, typeCon: inst.typeCon, context: declsDictParams(inst.context), superArgs: inst.superArgs, methods: methods})
    }
  }
}

func declsCheckFile(file File, acc (Map[String, CoreFunc], Map[String, CoreInstance])) Check[(Map[String, CoreFunc], Map[String, CoreInstance])] {
  do {
    env <- askEnv()
    checked <- foldCheck(file.decls, acc, func(acc, d) => match d {
      DeclFunc(f) => do {
        info <- declsRequire(mapLookup(env.funcs, f.name), f.pos, "unknown function ${f.name}")
        core <- declsCoreFunction(info)
        pure((mapInsert(fst(acc), f.name, core), snd(acc)))
      }
      DeclInstance(i) => do {
        let key = instanceKey(i.className, i.typeCon)
        info <- declsRequire(mapLookup(env.instances, key), i.pos, "unknown instance ${key}")
        core <- declsCoreInstance(info)
        pure((fst(acc), mapInsert(snd(acc), key, core)))
      }
      _ => pure(acc)
    })
    foldCheck(file.decls, checked, func(acc, d) => match d {
      DeclType(t) => foldCheck(t.derivings, acc, func(acc, c) => do {
        let key = instanceKey(c, t.name)
        info <- declsRequire(mapLookup(env.instances, key), t.pos, "unknown instance ${key}")
        core <- declsCoreInstance(info)
        pure((fst(acc), mapInsert(snd(acc), key, core)))
      })
      _ => pure(acc)
    })
  }
}

func checkProgram(files List[File]) Result[Program] {
  fst(runCheck(do {
    buildEnv(files)
    checked <- foldCheck(files, (mapEmpty(), mapEmpty()), func(acc, file) => declsCheckFile(file, acc))
    state <- getState()
    pure(Program{datas: fmap(mapValues(state.env.datas), declsCoreData), classes: fmap(mapValues(state.env.classes), declsCoreClass), instances: mapValues(snd(checked)), funcs: mapValues(fst(checked)), warnings: reverse(state.warnings)})
  }, initialState(emptyEnv())))
}
