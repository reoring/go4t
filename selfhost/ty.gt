package main

import "std/string"

// ===== ty.gt — semantic types, schemes, global environment (contract; owner: supervisor) =====
// Mirrors Go types/types.go. Meta variables are immutable here: a TMeta(id, k)
// is resolved through CheckState.subst (check.gt), never in place.

type Kind = KStar | KArrow(Int)        // KArrow(n): (*, ..n.. ) -> *
  deriving Eq, Debug

type Type = TCon(String, Kind)         // builtin or data type constructor
          | TVar(String, Kind)         // rigid type parameter
          | TMeta(Int, Kind)           // inference variable; see subst
          | TApp(Type, List[Type])     // flat application; fun is TCon/TVar/TMeta, never TApp
          | TFunc(List[Type], Type)
  deriving Eq, Debug

// Constructor application that keeps TApp flat (App in Go: TApp(TApp(f, a), b) => TApp(f, a ++ b)).
func tApp(fun Type, args List[Type]) Type {
  match args {
    Nil => fun
    _ => match fun {
      TApp(inner, prev) => TApp(inner, append(prev, args))
      _ => TApp(fun, args)
    }
  }
}

func tInt() Type { TCon("Int", KStar) }
func tFloat() Type { TCon("Float", KStar) }
func tString() Type { TCon("String", KStar) }
func tBool() Type { TCon("Bool", KStar) }
func tUnit() Type { TCon("Unit", KStar) }
func tIOCon() Type { TCon("IO", KArrow(1)) }
func tIO(a Type) Type { TApp(tIOCon(), [a]) }
func tListCon() Type { TCon("List", KArrow(1)) }
func tList(a Type) Type { TApp(tListCon(), [a]) }
func tOption(a Type) Type { TApp(TCon("Option", KArrow(1)), [a]) }
func tupleConName(n Int) String { "Tuple${n}" }
func tTupleCon(n Int) Type { TCon(tupleConName(n), KArrow(n)) }
func tTuple(elems List[Type]) Type { TApp(tTupleCon(length(elems)), elems) }

// isTupleCon returns the arity when the constructor name is TupleN (N >= 2).
func isTupleCon(name String) Option[Int] {
  if string.startsWith(name, "Tuple") {
    match string.parseInt(string.substring(name, 5, string.strLength(name))) {
      Some(n) if n >= 2 => Some(n)
      _ => None
    }
  } else { None }
}

func kindArity(k Kind) Int {
  match k {
    KStar => 0
    KArrow(n) => n
  }
}

func arityKind(n Int) Kind { if n == 0 { KStar } else { KArrow(n) } }

// Scheme: forall tparams [constraints] . typ. tparams carry rigid TVar names
// with kinds; constraints pair a class with the name of one of the tparams.
type Scheme = Scheme{tparams: List[(String, Kind)], constraints: List[(String, String)], typ: Type}

func monoScheme(t Type) Scheme { Scheme{tparams: Nil, constraints: Nil, typ: t} }

// ----- global environment (built by decls.gt, read everywhere) -----
type ClassInfo = ClassInfo{name: String, param: String, paramKind: Kind, super: Option[String], methods: List[MethodInfo], pos: Pos}

// MethodInfo.scheme quantifies the class parameter first (with the class as
// its constraint) followed by the method's own type parameters.
type MethodInfo = MethodInfo{name: String, className: String, scheme: Scheme, arity: Int}

type DataInfo = DataInfo{name: String, tparams: List[String], ctors: List[CtorInfo], pos: Pos}

// CtorInfo.fields are expressed over TVar(tparam) of the owning data type;
// fieldNames is Nil for positional constructors. index is the declaration order.
type CtorInfo = CtorInfo{name: String, data: String, tparams: List[String], fields: List[Type], fieldNames: List[String], index: Int, pos: Pos}

// InstanceInfo: `instance class[typeCon[fixed..., params...]] given context`.
// context entries are (class, tvar). superArgs are the dictionaries the
// superclass instance needs, one per entry of the superclass instance context.
// methods are the surface bodies (None for derived instances, whose Core
// bodies are produced directly by decls.gt).
type InstanceInfo = InstanceInfo{className: String, typeCon: String, fixed: List[String], params: List[String], context: List[(String, String)], superArgs: List[DictRef], methods: List[InstMethod], derived: Bool, pos: Pos}

type FuncInfo = FuncInfo{name: String, scheme: Scheme, decl: FuncDecl}

// instanceKey builds the lookup key for Env.instances.
func instanceKey(className String, typeCon String) String { "${className}/${typeCon}" }

type Env = Env{
  aliases: TreeMap[String, AliasDecl],
  classes: TreeMap[String, ClassInfo],
  methods: TreeMap[String, MethodInfo],        // method name -> owning class method
  datas: TreeMap[String, DataInfo],
  ctors: TreeMap[String, CtorInfo],
  funcs: TreeMap[String, FuncInfo],
  instances: TreeMap[String, InstanceInfo],    // instanceKey(class, typeCon)
  typeKinds: TreeMap[String, Kind]             // every type-namespace name (builtins + datas) -> kind
}

func emptyEnv() Env {
  Env{
    aliases: MEmpty, classes: MEmpty, methods: MEmpty, datas: MEmpty, ctors: MEmpty, funcs: MEmpty,
    instances: MEmpty,
    typeKinds: mapFromList([("Int", KStar), ("Float", KStar), ("String", KStar), ("Bool", KStar), ("Unit", KStar), ("GoError", KStar), ("IO", KArrow(1)), ("Map", KArrow(2)), ("Set", KArrow(1)), ("Array", KArrow(1)), ("Fiber", KArrow(1)), ("Ref", KArrow(1)), ("MutMap", KArrow(2))])
  }
}

// ----- dictionaries (shared by checker and codegen) -----
// DInstance(class, typeCon, args): instance dictionary with one arg per context entry.
// DParam(param, class): dictionary parameter of the enclosing function/instance/let.
// DSuper(class, sub): the `class` dictionary embedded in the subclass dictionary `sub`.
type DictRef = DInstance(String, String, List[DictRef])
             | DParam(String, String)
             | DSuper(String, DictRef)
  deriving Eq, Debug

instance Show[Kind] {
  show(k) { match k { KStar => "KStar" | KArrow(n) => "KArrow(${n})" } }
}

instance Show[Type] {
  show(t) {
    match t {
      TCon(n, k) => "TCon(${n}, ${k})"
      TVar(n, k) => "TVar(${n}, ${k})"
      TMeta(n, k) => "TMeta(${n}, ${k})"
      TApp(f, xs) => "TApp(${f}, ${xs})"
      TFunc(ps, ret) => "TFunc(${ps}, ${ret})"
    }
  }
}

instance Show[DictRef] {
  show(d) {
    match d {
      DInstance(c, t, ds) => "DInstance(${c}, ${t}, ${ds})"
      DParam(p, c) => "DParam(${p}, ${c})"
      DSuper(c, d) => "DSuper(${c}, ${d})"
    }
  }
}
