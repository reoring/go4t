package main

// Declaration half of the Core -> Go backend. Program lists are already sorted;
// constructors, methods and dictionary parameters retain their declaration order.
// Expression generation shares one fresh-name counter across the whole program.
func generate(prog Program, goPackage String) Result[String] {
  let pkg = if goPackage == "" { "main" } else { goPackage }
  if !cgDeclPackageName(pkg) {
    Err(Diag{pos: noPos(), msg: "invalid Go package name " + genQuote(pkg)})
  } else if !any(prog.funcs, func(f) => match f { CoreFunc(name, _, _, _) => name == "main" | CoreExtern(name, _, _, _) => name == "main" }) {
    Err(Diag{pos: noPos(), msg: "program has no main function"})
  } else {
    let imports = fold(prog.funcs, CGDImports{paths: MEmpty, externs: MEmpty, lines: Nil, next: 1}, cgDeclImport)
    let ctx = GenCtx{
      instances: mapFromList(fmap(prog.instances, func(i) => (instanceKey(i.className, i.typeCon), i))),
      classes: mapFromList(fmap(prog.classes, func(c) => (c.name, c))),
      datas: mapFromList(fmap(prog.datas, func(d) => (d.name, d))),
      externs: imports.externs, receiver: None, receiverDicts: Nil
    }
    let bodies = append(concatMap(prog.instances, func(i) => fmap(i.methods, func(m) => m.body)), concatMap(prog.funcs, cgDeclFuncBodies))
    let arities = mapKeys(mapFromList(fmap(append(concatMap(bodies, collectTupleArities), concatMap(prog.instances, cgDeclInstanceTuples)), func(n) => (n, unit()))))
    let header = "// Code generated by gofx. DO NOT EDIT.\npackage " + pkg + "\nimport (\n\"gofx/rt\"\n" + strConcat(reverse(imports.lines)) + ")\n"
    let helpers = strConcat(fmap(arities, cgDeclTuple)) + (if any(bodies, usesOrdering) { cgDeclOrdering() } else { "" })
    Ok(header + helpers + fst(runGen(cgDeclProgram(ctx, prog), 0)))
  }
}

// Imports are numbered by first appearance in sorted funcs, not by import path.
type CGDImports = CGDImports{paths: Map[String, String], externs: Map[String, String], lines: List[String], next: Int}

func cgDeclImport(acc CGDImports, f CoreFunc) CGDImports {
  match f {
    CoreFunc(_, _, _, _) => acc
    CoreExtern(name, path, goName, _) => {
      let alias = fromOption(mapLookup(acc.paths, path), "ext_${acc.next}")
      let known = mapMember(acc.paths, path)
      CGDImports{
        paths: if known { acc.paths } else { mapInsert(acc.paths, path, alias) },
        externs: mapInsert(acc.externs, name, alias + "." + goName),
        lines: if known { acc.lines } else { Cons(alias + " " + genQuote(path) + "\n", acc.lines) },
        next: if known { acc.next } else { acc.next + 1 }
      }
    }
  }
}

func cgDeclFuncBodies(f CoreFunc) List[Core] {
  match f { CoreFunc(_, _, _, body) => [body] | CoreExtern(_, _, _, _) => Nil }
}

// Declaration types are erased in Core. Tuple structs are needed only for Core
// expressions/patterns/dictionaries and tuple instance heads, not annotations.
func cgDeclInstanceTuples(inst CoreInstance) List[Int] {
  match isTupleCon(inst.typeCon) { Some(n) => [n] | None => Nil }
}

func cgDeclProgram(ctx GenCtx, prog Program) Gen[String] {
  do {
    instances <- mapM(prog.instances, func(i) => cgDeclInstance(ctx, i))
    funcs <- mapM(prog.funcs, func(f) => cgDeclFunc(ctx, f))
    pure(strConcat(fmap(prog.datas, cgDeclData)) + cgDeclShapes(ctx) + strConcat(fmap(prog.classes, cgDeclClass)) + strConcat(instances) + strConcat(funcs) + "func main() { rt.RunMain(main_()) }\n")
  }
}

func cgDeclFields(arity Int) String {
  strConcat(fmap(range(0, arity), func(n) => "F${n} any\n"))
}

func cgDeclTuple(arity Int) String {
  "type Tuple${arity} struct {\n" + cgDeclFields(arity) + "}\n"
}

func cgDeclData(data CoreData) String {
  "type " + data.name + " interface { is" + data.name + "() }\n" + strConcat(fmap(data.ctors, func(ctor) => {
    let name = ctorGoName(data.name, ctor.name)
    "type " + name + " struct {" + (if ctor.arity > 0 { "\n" } else { "" }) + cgDeclFields(ctor.arity) + "}\nfunc (*" + name + ") is" + data.name + "() {}\n"
  }))
}

func cgDeclDictParams(params List[(String, String)]) List[String] {
  fmap(params, func(p) => "dict_" + fst(p) + " " + snd(p))
}

func cgDeclAnonymous(arity Int) List[String] {
  fmap(range(0, arity), func(n) => "a${n}")
}

func cgDeclAnyParams(names List[String]) List[String] {
  fmap(names, func(name) => name + " any")
}

func cgDeclClass(c CoreClass) String {
  let super = match c.super { Some(name) => name + "\n" | None => "" }
  "type " + c.name + " interface {\n" + super + strConcat(fmap(c.methods, func(m) => exported(m.name) + "(" + join(", ", append(cgDeclDictParams(m.dictParams), cgDeclAnyParams(cgDeclAnonymous(m.arity)))) + ") any\n")) + "}\n"
}

func cgDeclInstance(ctx GenCtx, inst CoreInstance) Gen[String] {
  let name = instanceGoName(inst.className, inst.typeCon)
  let super = match mapLookup(ctx.classes, inst.className) {
    Some(c) => match c.super { Some(s) => [instanceGoName(s, inst.typeCon)] | None => Nil }
    None => Nil
  }
  let fields = append(super, cgDeclDictParams(inst.context))
  let definition = "type " + name + " struct {" + (if length(fields) == 0 { "" } else { "\n" + join("\n", fields) + "\n" }) + "}\n"
  do {
    methods <- mapM(inst.methods, func(m) => cgDeclMethod(ctx, inst, m))
    pure(definition + strConcat(methods))
  }
}

func cgDeclMethod(ctx GenCtx, inst CoreInstance, method CoreMethod) Gen[String] {
  // Explicit method dictionaries shadow context fields with the same parameter.
  let localDicts = fmap(method.dictParams, fst)
  let methodCtx = ctx{receiver: Some("dictself"), receiverDicts: filter(inst.context, func(p) => !elem(fst(p), localDicts))}
  let params = append(cgDeclDictParams(method.dictParams), cgDeclAnyParams(fmap(method.params, mangle)))
  do {
    body <- genExpr(methodCtx, method.body)
    pure("func (dictself " + instanceGoName(inst.className, inst.typeCon) + ") " + exported(method.name) + "(" + join(", ", params) + ") any {\nreturn " + body + "\n}\n")
  }
}

func cgDeclFunc(ctx GenCtx, f CoreFunc) Gen[String] {
  match f {
    CoreFunc(name, dictParams, params, expr) => do {
      body <- genExpr(ctx, expr)
      pure("func " + mangle(name) + "(" + join(", ", append(cgDeclDictParams(dictParams), cgDeclAnyParams(fmap(params, mangle)))) + ") any {\nreturn " + body + "\n}\n")
    }
    CoreExtern(name, _, _, arity) => {
      // CoreExtern retains arity, not surface parameter names.
      let args = cgDeclAnonymous(arity)
      let target = fromOption(mapLookup(ctx.externs, name), "")
      pure("func " + mangle(name) + "(" + join(", ", cgDeclAnyParams(args)) + ") any {\nreturn " + target + "(" + join(", ", args) + ")\n}\n")
    }
  }
}

func cgDeclHasCtor(data CoreData, name String, arity Int) Bool {
  any(data.ctors, func(c) => c.name == name && c.arity == arity)
}

// Register only the standard shapes, exactly as the reference generator does.
func cgDeclShapes(ctx GenCtx) String {
  match (mapLookup(ctx.datas, "List"), mapLookup(ctx.datas, "Option")) {
    (Some(listData), Some(optionData)) => if cgDeclHasCtor(listData, "Cons", 2) && cgDeclHasCtor(listData, "Nil", 0) && cgDeclHasCtor(optionData, "Some", 1) && cgDeclHasCtor(optionData, "None", 0) {
      "func init() {\nrt.Shapes = rt.ShapeFuncs{\n" +
      "Cons: func(h, t any) any { return &" + ctorGoName("List", "Cons") + "{F0: h, F1: t} },\n" +
      "Nil: func() any { return &" + ctorGoName("List", "Nil") + "{} },\n" +
      "Some: func(a any) any { return &" + ctorGoName("Option", "Some") + "{F0: a} },\n" +
      "None: func() any { return &" + ctorGoName("Option", "None") + "{} },\n" +
      "Uncons: func(l any) (any, any, bool) {\nif c, ok := l.(*" + ctorGoName("List", "Cons") + "); ok { return c.F0, c.F1, true }\nreturn nil, nil, false\n},\n}\n}\n"
    } else { "" }
    _ => ""
  }
}

func cgDeclOrdering() String {
  "func ord_lt(o any) bool { _, ok := o.(*Ordering_LT); return ok }\n" +
  "func ord_le(o any) bool { _, ok := o.(*Ordering_GT); return !ok }\n" +
  "func ord_gt(o any) bool { _, ok := o.(*Ordering_GT); return ok }\n" +
  "func ord_ge(o any) bool { _, ok := o.(*Ordering_LT); return !ok }\n"
}

func cgDeclPackageName(name String) Bool {
  name != "_" && isGoIdentifier(name)
}

extern func isGoIdentifier(s String) Bool = "gofx/rt".IsGoIdentifier
