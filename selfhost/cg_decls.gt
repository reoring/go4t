package main

import "std/prelude"
import "std/list"
import "std/result"
import "std/string"

// Declaration half of the Core -> Go backend. Program lists are already sorted;
// constructors, methods and dictionary parameters retain their declaration order.
// Expression generation shares one fresh-name counter across the whole program.
func generate(prog Program, goPackage String) CompileResult[String] {
  let pkg = if goPackage == "" { "main" } else { goPackage }
  if !cgDeclPackageName(pkg) {
    CompileErr(Diag{pos: noPos(), msg: "invalid Go package name " + genQuote(pkg)})
  } else if !any(prog.funcs, func(f) => match f { CoreFunc(name, _, _, _) => name == "main" | CoreExtern(name, _, _, _) => name == "main" }) {
    CompileErr(Diag{pos: noPos(), msg: "program has no main function"})
  } else {
    let imports = fold(prog.funcs, CGDImports{paths: MEmpty, externs: MEmpty, lines: Nil, next: 1}, cgDeclImport)
    let ctx = GenCtx{
      instances: mapFromList(prelude.fmap(prog.instances, func(i) => (instanceKey(i.className, i.typeCon), i))),
      classes: mapFromList(prelude.fmap(prog.classes, func(c) => (c.name, c))),
      datas: mapFromList(prelude.fmap(prog.datas, func(d) => (d.name, d))),
      externs: imports.externs, receiver: None, receiverDicts: Nil
    }
    let bodies = append(list.concatMap(prog.instances, func(i) => prelude.fmap(i.methods, func(m) => m.body)), list.concatMap(prog.funcs, cgDeclFuncBodies))
    let arities = mapKeys(mapFromList(prelude.fmap(append(if mapMember(ctx.datas, "List") && mapMember(ctx.datas, "Option") { [2, 3] } else { Nil }, append(list.concatMap(bodies, collectTupleArities), list.concatMap(prog.instances, cgDeclInstanceTuples))), func(n) => (n, unit()))))
    let header = "// Code generated by go4t. DO NOT EDIT.\npackage " + pkg + "\nimport (\n\"go4t/rt\"\n" + string.strConcat(reverse(imports.lines)) + ")\n"
    let helpers = string.strConcat(prelude.fmap(arities, cgDeclTuple)) + (if any(bodies, usesOrdering) { cgDeclOrdering() } else { "" })
    CompileOk(header + helpers + fst(runGen(cgDeclProgram(ctx, prog), 0)))
  }
}

// Imports are numbered by first appearance in sorted funcs, not by import path.
type CGDImports = CGDImports{paths: TreeMap[String, String], externs: TreeMap[String, String], lines: List[String], next: Int}

func cgDeclImport(acc CGDImports, f CoreFunc) CGDImports {
  match f {
    CoreFunc(_, _, _, _) => acc
    CoreExtern(name, path, goName, _) => {
      let bindingAlias = result.fromOption(mapLookup(acc.paths, path), "ext_${acc.next}")
      let known = mapMember(acc.paths, path)
      CGDImports{
        paths: if known { acc.paths } else { mapInsert(acc.paths, path, bindingAlias) },
        externs: mapInsert(acc.externs, name, bindingAlias + "." + goName),
        lines: if known { acc.lines } else { Cons(bindingAlias + " " + genQuote(path) + "\n", acc.lines) },
        next: if known { acc.next } else { acc.next + 1 }
      }
    }
  }
}

func cgDeclFuncBodies(f CoreFunc) List[Core] {
  match f { CoreFunc(_, _, _, body) => [body] | CoreExtern(_, _, _, _) => Nil }
}

// Declaration types are erased in Core. Tuple structs are needed only for Core
// expressions/patterns/dictionaries and tuple instance heads, not annotations.
func cgDeclInstanceTuples(inst CoreInstance) List[Int] {
  match isTupleCon(inst.typeCon) { Some(n) => [n] | None => Nil }
}

func cgDeclProgram(ctx GenCtx, prog Program) Gen[String] {
  do {
    instances <- list.mapM(prog.instances, func(i) => cgDeclInstance(ctx, i))
    funcs <- list.mapM(prog.funcs, func(f) => cgDeclFunc(ctx, f))
    prelude.pure(string.strConcat(prelude.fmap(prog.datas, cgDeclData)) + cgDeclShapes(ctx) + string.strConcat(prelude.fmap(prog.classes, cgDeclClass)) + string.strConcat(instances) + string.strConcat(funcs) + "func main() { rt.RunMain(main_()) }\n")
  }
}

func cgDeclFields(arity Int) String {
  string.strConcat(prelude.fmap(range(0, arity), func(n) => "F${n} any\n"))
}

func cgDeclTuple(arity Int) String {
  "type Tuple${arity} struct {\n" + cgDeclFields(arity) + "}\n"
}

func cgDeclData(data CoreData) String {
  "type " + data.name + " interface { is" + data.name + "() }\n" + string.strConcat(prelude.fmap(data.ctors, func(ctor) => {
    let name = ctorGoName(data.name, ctor.name)
    "type " + name + " struct {" + (if ctor.arity > 0 { "\n" } else { "" }) + cgDeclFields(ctor.arity) + "}\nfunc (*" + name + ") is" + data.name + "() {}\n"
  }))
}

func cgDeclDictParams(params List[(String, String)]) List[String] {
  cgDictParams(params)
}

func cgDeclAnonymous(arity Int) List[String] {
  prelude.fmap(range(0, arity), func(n) => "a${n}")
}

func cgDeclAnyParams(names List[String]) List[String] {
  prelude.fmap(names, func(name) => name + " any")
}

func cgDeclClass(c CoreClass) String {
  let super = match c.super { Some(name) => name + "\n" | None => "" }
  "type " + c.name + " interface {\n" + super + string.strConcat(prelude.fmap(c.methods, func(m) => exported(m.name) + "(" + string.join(", ", append(cgDeclDictParams(m.dictParams), cgDeclAnyParams(cgDeclAnonymous(m.arity)))) + ") any\n")) + "}\n"
}

func cgDeclInstance(ctx GenCtx, inst CoreInstance) Gen[String] {
  let name = instanceGoName(inst.className, inst.typeCon)
  let super = match mapLookup(ctx.classes, inst.className) {
    Some(c) => match c.super { Some(s) => [instanceGoName(s, inst.typeCon)] | None => Nil }
    None => Nil
  }
  let fields = append(super, cgDeclDictParams(inst.context))
  let definition = "type " + name + " struct {" + (if length(fields) == 0 { "" } else { "\n" + string.join("\n", fields) + "\n" }) + "}\n"
  do {
    methods <- list.mapM(inst.methods, func(m) => cgDeclMethod(ctx, inst, m))
    prelude.pure(definition + string.strConcat(methods))
  }
}

func cgDeclMethod(ctx GenCtx, inst CoreInstance, method CoreMethod) Gen[String] {
  // Explicit method dictionaries shadow context fields with the same parameter.
  let localDicts = prelude.fmap(method.dictParams, fst)
  let methodCtx = ctx{receiver: Some("dictself"), receiverDicts: filter(inst.context, func(p) => !list.elem(fst(p), localDicts))}
  let params = append(cgDeclDictParams(method.dictParams), cgDeclAnyParams(prelude.fmap(method.params, mangle)))
  do {
    body <- genExpr(methodCtx, method.body)
    prelude.pure("func (dictself " + instanceGoName(inst.className, inst.typeCon) + ") " + exported(method.name) + "(" + string.join(", ", params) + ") any {\nreturn " + body + "\n}\n")
  }
}

func cgDeclFunc(ctx GenCtx, f CoreFunc) Gen[String] {
  match f {
    CoreFunc(name, dictParams, params, expr) => do {
      body <- genExpr(ctx, expr)
      prelude.pure("func " + mangle(name) + "(" + string.join(", ", append(cgDeclDictParams(dictParams), cgDeclAnyParams(prelude.fmap(params, mangle)))) + ") any {\nreturn " + body + "\n}\n")
    }
    CoreExtern(name, _, _, arity) => {
      // CoreExtern retains arity, not surface parameter names.
      let args = cgDeclAnonymous(arity)
      let target = result.fromOption(mapLookup(ctx.externs, name), "")
      prelude.pure("func " + mangle(name) + "(" + string.join(", ", cgDeclAnyParams(args)) + ") any {\nreturn " + target + "(" + string.join(", ", args) + ")\n}\n")
    }
  }
}

func cgDeclHasCtor(data CoreData, name String, arity Int) Bool {
  any(data.ctors, func(c) => c.name == name && c.arity == arity)
}

// Register only the standard shapes, exactly as the reference generator does.
func cgDeclShapes(ctx GenCtx) String {
  match (mapLookup(ctx.datas, "List"), mapLookup(ctx.datas, "Option")) {
    (Some(listData), Some(optionData)) => if cgDeclHasCtor(listData, "Cons", 2) && cgDeclHasCtor(listData, "Nil", 0) && cgDeclHasCtor(optionData, "Some", 1) && cgDeclHasCtor(optionData, "None", 0) {
      "func init() {\nrt.Shapes = rt.ShapeFuncs{\n" +
      "Cons: func(h, t any) any { return &" + ctorGoName("List", "Cons") + "{F0: h, F1: t} },\n" +
      "Nil: func() any { return &" + ctorGoName("List", "Nil") + "{} },\n" +
      "Some: func(a any) any { return &" + ctorGoName("Option", "Some") + "{F0: a} },\n" +
      "None: func() any { return &" + ctorGoName("Option", "None") + "{} },\n" +
      "Uncons: func(l any) (any, any, bool) {\nif c, ok := l.(*" + ctorGoName("List", "Cons") + "); ok { return c.F0, c.F1, true }\nreturn nil, nil, false\n},\n" +
      "OptionValue: func(v any) (any, bool) { if s, ok := v.(*Option_Some); ok { return s.F0, true }; return nil, false },\n" +
      (if mapMember(ctx.datas, "Result") { "Ok: func(a any) any { return &Result_Ok{F0: a} },\nErr: func(e any) any { return &Result_Err{F0: e} },\n" } else { "" }) +
      "Tuple2: func(a, b any) any { return &Tuple2{F0:a,F1:b} },\nUntuple2: func(p any) (any, any) { t:=p.(*Tuple2); return t.F0,t.F1 },\n" +
      "Tuple3: func(a,b,c any) any { return &Tuple3{F0:a,F1:b,F2:c} },\nUntuple3: func(p any) (any,any,any) { t:=p.(*Tuple3); return t.F0,t.F1,t.F2 },\n" +
      (if mapMember(ctx.datas, "Ordering") { "OrderingOf: func(o any) int { switch o.(type) { case *Ordering_LT: return -1; case *Ordering_GT: return 1; default: return 0 } },\n" } else { "" }) +
      cgDeclIoShapes(ctx) + cgDeclJsonShapes(ctx) + "}\n}\n"
    } else { "" }
    _ => ""
  }
}

func cgDeclIoShapes(ctx GenCtx) String {
  match mapLookup(ctx.datas, "Mstd_io__IoError") {
    None => ""
    Some(data) => {
      let make = string.strConcat(map(data.ctors, func(c) => "case " + genQuote(moduleDisplayName(c.name)) + ": return " + cgConstruct(ctorGoName(data.name, c.name), if c.arity == 0 { Nil } else { ["msg"] }) + "\n"))
      let view = string.strConcat(map(data.ctors, func(c) => "case *" + ctorGoName(data.name, c.name) + ": return " + genQuote(moduleDisplayName(c.name)) + ", " + (if c.arity == 0 { "\"\"" } else { "e.F0.(string)" }) + "\n"))
      "IoError: func(kind,msg string) any { switch kind {\n" + make + "}; panic(\"unknown IoError kind\") },\n" +
      "IoErrorOf: func(v any) (string,string) { switch e:=v.(type) {\n" + view + "}; panic(\"invalid IoError\") },\n"
    }
  }
}

func cgDeclOrdering() String {
  "func ord_lt(o any) bool { _, ok := o.(*Ordering_LT); return ok }\n" +
  "func ord_le(o any) bool { _, ok := o.(*Ordering_GT); return !ok }\n" +
  "func ord_gt(o any) bool { _, ok := o.(*Ordering_GT); return ok }\n" +
  "func ord_ge(o any) bool { _, ok := o.(*Ordering_LT); return !ok }\n"
}

func cgDeclPackageName(name String) Bool {
  name != "_" && isGoIdentifier(name)
}

extern func isGoIdentifier(s String) Bool = "go4t/rt".IsGoIdentifier

func cgDeclJsonShapes(ctx GenCtx) String {
  match mapLookup(ctx.datas, jsonName("Json")) {
    None => ""
    Some(data) => {
      let creates = string.strConcat(map(data.ctors, func(c) => moduleDisplayName(c.name) + ": func(" + (if c.arity == 0 { "" } else { "v any" }) + ") any { return " + cgConstruct(ctorGoName(data.name, c.name), if c.arity == 0 { Nil } else { ["v"] }) + " },\n"))
      let kinds = [("JNull", "null"), ("JBool", "bool"), ("JInt", "integer"), ("JNum", "number"), ("JStr", "string"), ("JArr", "array"), ("JObj", "object")]
      let views = string.strConcat(map(data.ctors, func(c) => "case *" + ctorGoName(data.name, c.name) + ": return " + genQuote(result.fromOption(lookupAssoc(kinds, moduleDisplayName(c.name)), "")) + ", " + (if c.arity == 0 { "nil" } else { "x.F0" }) + "\n"))
      creates + "JsonView: func(v any) (string, any) { switch x:=v.(type) {\n" + views + "}; panic(\"invalid Json\") },\n"
    }
  }
}
