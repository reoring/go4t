package main
import "std/list"

func shuffled(n Int, seed Int, xs List[Int]) List[Int] {
  if n == 0 { xs } else {
    let next = (seed * 48271) % 2147483647
    shuffled(n - 1, next, Cons(next, xs))
  }
}

func main() IO[Unit] {
  let sorted = list.sort(shuffled(1000000, 1, Nil))
  println(show(length(sorted)))
}
