package main

law int(a Int, b Int) { ((a == b, a != b), ((a < b, a <= b), (a > b, a >= b))) == ((true, true), ((true, true), (true, true))) }
law string(a String, b String) { ((a == b, a != b), ((a < b, a <= b), (a > b, a >= b))) == ((true, true), ((true, true), (true, true))) }
law bool(a Bool, b Bool) { ((a == b, a != b), ((a < b, a <= b), (a > b, a >= b))) == ((true, true), ((true, true), (true, true))) }
law raw(a Int, b Int) { (if a < b { 1 } else { 2 }) == 0 }
law rawShow(a Int) { show(a) == "" }
func main() IO[Unit] { ioPure(unit()) }

proof int(a, b) { refl }
proof string(a, b) { refl }
proof bool(a, b) { refl }
proof raw(a, b) { refl }
proof rawShow(a) { refl }
