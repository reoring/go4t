package main

import "std/map"
import "std/list"

law lookupInserted[A](m Map[Int, A], k Int, value A) {
  map.mapLookup(map.mapInsert(m, k, value), k) == Some(value)
}
proof lookupInserted(m, k, value) { refl }

law mapShadow[A](m Map[Int, A], k Int, first A, last A) {
  map.mapInsert(map.mapInsert(m, k, first), k, last) == map.mapInsert(m, k, last)
}
proof mapShadow(m, k, first, last) { refl }

law countAll[A](xs List[A]) { list.count(xs, func(_x) => true) == length(xs) }
proof countAll(xs) { induction xs }

law reverseCons[A](x A, xs List[A]) {
  reverse(Cons(x, xs)) == append(reverse(xs), Cons(x, Nil))
}
proof reverseCons(x, xs) { refl }

law unzipCons[A, B](x A, y B, xs List[(A, B)]) {
  list.unzip(Cons((x, y), xs)) == (match list.unzip(xs) { (left, right) => (Cons(x, left), Cons(y, right)) })
}
proof unzipCons(x, y, xs) { refl }

func main() IO[Unit] { ioPure(unit()) }
