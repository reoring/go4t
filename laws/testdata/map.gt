package main

import "std/map"
import "std/list"

type Key = Key(Int, Bool) deriving Eq, Ord, Debug
type Box[A] = Box(A) deriving Eq, Ord, Debug
func emptyInts() Map[Int, Int] { map.emptyMap() }
func emptyBools() Map[Bool, Int] { map.emptyMap() }

law lookupInserted(m Map[Int, Int], k Int, v Int) { map.mapLookup(map.mapInsert(m, k, v), k) == Some(v) }
proof lookupInserted(m, k, v) { refl }

law lookupOther(m Map[Int, Int], k Int, k2 Int, v Int) {
  map.mapLookup(map.mapInsert(m, k, v), k2) == (if k2 == k { Some(v) } else { map.mapLookup(m, k2) })
}
proof lookupOther(m, k, k2, v) { if k2 == k { refl } else { refl } }

law memberInserted(m Map[String, Int], k String, v Int) { map.mapMember(map.mapInsert(m, k, v), k) == true }
proof memberInserted(m, k, v) { refl }

law memberOther(m Map[Int, Int], k Int, k2 Int, v Int) {
  map.mapMember(map.mapInsert(m, k, v), k2) == (if k2 == k { true } else { map.mapMember(m, k2) })
}
proof memberOther(m, k, k2, v) { if k2 == k { refl } else { refl } }

law shadow(m Map[Int, Int], k Int, a Int, b Int) { map.mapInsert(map.mapInsert(m, k, a), k, b) == map.mapInsert(m, k, b) }
proof shadow(m, k, a, b) { refl }

law insertOrder(m Map[Int, Int], k Int, k2 Int, a Int, b Int) {
  map.mapLookup(map.mapInsert(map.mapInsert(m, k, a), k2, b), k) == (if k == k2 { Some(b) } else { Some(a) })
}
proof insertOrder(m, k, k2, a, b) { if k == k2 { refl } else { refl } }

law sizeInsert(m Map[Int, Int], k Int, v Int) {
  map.mapSize(map.mapInsert(m, k, v)) == (if map.mapMember(m, k) { map.mapSize(m) } else { map.mapSize(m) + 1 })
}
proof sizeInsert(m, k, v) { if map.mapMember(m, k) { refl } else { refl } }

law deleteInserted(m Map[Int, Int], k Int, v Int) { map.mapDelete(map.mapInsert(m, k, v), k) == map.mapDelete(m, k) }
proof deleteInserted(m, k, v) { refl }

law deleteOther(m Map[Int, Int], k Int, k2 Int, v Int) {
  map.mapDelete(map.mapInsert(m, k, v), k2) == (if k2 == k { map.mapDelete(m, k2) } else { map.mapInsert(map.mapDelete(m, k2), k, v) })
}
proof deleteOther(m, k, k2, v) { if k2 == k { refl } else { refl } }

law emptyLookup(k Int) { map.mapLookup(emptyInts(), k) == None }
proof emptyLookup(k) { refl }
law emptyMember(k Bool) { map.mapMember(emptyBools(), k) == false }
proof emptyMember(k) { refl }
law literalLookup(k Int) { map.mapLookup(map.mapFromList([(2, 20), (1, 10)]), k) == (if k == 1 { Some(10) } else if k == 2 { Some(20) } else { None }) }
proof literalLookup(k) { if k == 1 { refl } else { if k == 2 { refl } else { refl } } }
law literalMember(k Int) { map.mapMember(map.mapFromList([(2, 20), (1, 10)]), k) == (if k == 1 { true } else if k == 2 { true } else { false }) }
proof literalMember(k) { if k == 1 { refl } else { if k == 2 { refl } else { refl } } }
law literalSize() { map.mapSize(map.mapFromList([(2, 20), (1, 10), (2, 30)])) == 2 }
proof literalSize() { refl }
law literalDelete() { map.mapToList(map.mapDelete(map.mapFromList([(2, 20), (1, 10)]), 2)) == [(1, 10)] }
proof literalDelete() { refl }
law literalOrder(v Int) { map.mapToList(map.mapFromList([(2, 20), (-1, v), (2, 30)])) == [(-1, v), (2, 30)] }
proof literalOrder(v) { refl }
law literalStrings() { map.mapKeys(map.mapFromList([("z", 1), ("a", 2), ("日本", 3), ("", 4)])) == ["", "a", "z", "日本"] }
proof literalStrings() { refl }
law literalBools() { map.mapValues(map.mapFromList([(true, 1), (false, 2)])) == [2, 1] }
proof literalBools() { refl }
law literalTuples() { map.mapKeys(map.mapFromList([((2, false), 1), ((1, true), 2), ((1, false), 3)])) == [(1, false), (1, true), (2, false)] }
proof literalTuples() { refl }
law literalFold(v Int) { map.mapFold(map.mapFromList([(2, 20), (1, v)]), 0, func(acc, k, value) => acc * 10 + value + k) == (v + 1) * 10 + 22 }
proof literalFold(v) { refl }
law literalMap(v Int) { map.mapToList(map.mapMap(map.mapFromList([(2, v), (1, 10)]), func(n) => n + 1)) == [(1, 11), (2, v + 1)] }
proof literalMap(v) { refl }
law literalUnion(v Int) { map.mapToList(map.mapUnion(map.mapFromList([(2, v), (1, 10)]), map.mapFromList([(2, 30), (3, 40)]))) == [(1, 10), (2, v), (3, 40)] }
proof literalUnion(v) { refl }
law literalEq() { (map.mapFromList([(2, 20), (1, 10)]) == map.mapFromList([(1, 10), (2, 20)])) == true }
proof literalEq() { refl }

law symbolicFromList(k Int, k2 Int, a Int, b Int) { map.mapFromList([(k, a), (k2, b)]) == map.mapInsert(map.mapInsert(map.emptyMap(), k, a), k2, b) }
proof symbolicFromList(k, k2, a, b) { refl }
law fromListTail(k Int, v Int, rest List[(Int, Int)]) { map.mapFromList(Cons((k, v), rest)) == map.mapFromList(Cons((k, v + 0), rest)) }
proof fromListTail(k, v, rest) { match rest { Nil => refl; Cons(_, _) => refl } }

law adjustInserted(m Map[Int, Int], k Int, v Int) { map.mapAdjust(map.mapInsert(m, k, v), k, func(n) => n + 1) == map.mapInsert(m, k, v + 1) }
proof adjustInserted(m, k, v) { refl }
law alterInserted(m Map[Int, Int], k Int, v Int) { map.mapAlter(map.mapInsert(m, k, v), k, func(previous) => match previous { None => None; Some(n) => Some(n + 1) }) == map.mapInsert(m, k, v + 1) }
proof alterInserted(m, k, v) { refl }
law derivedKey(k Key, v Int) { map.mapLookup(map.mapInsert(map.emptyMap(), k, v), k) == Some(v) }
proof derivedKey(k, v) { refl }
law composedKey(k Box[Key], k2 Box[Key], v Int) { map.mapLookup(map.mapInsert(map.emptyMap(), k, v), k2) == (if k2 == k { Some(v) } else { None }) }
proof composedKey(k, k2, v) { if k2 == k { refl } else { refl } }
law tupleKey(m Map[(Int, Bool), Int], k (Int, Bool), k2 (Int, Bool), v Int) { map.mapLookup(map.mapInsert(m, k, v), k2) == (if k2 == k { Some(v) } else { map.mapLookup(m, k2) }) }
proof tupleKey(m, k, k2, v) { if k2 == k { refl } else { refl } }

// Recursive derived dictionaries must leave neutral key comparisons as calls,
// then resume when random substitution or a proof match supplies constructors.
law recursiveKey(m Map[List[Int], Int], k List[Int], k2 List[Int], v Int) {
  map.mapLookup(map.mapInsert(m, k, v), k2) == (if k2 == k { Some(v) } else { map.mapLookup(m, k2) })
}
proof recursiveKey(m, k, k2, v) { if k2 == k { refl } else { refl } }

func main() IO[Unit] { ioPure(unit()) }
