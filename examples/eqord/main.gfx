package main
import "std/float"
import "std/list"
import "std/string"


type AccountId = AccountId(String)

instance Show[AccountId] {
  show(id) { match id { AccountId(value) => value } }
}

instance Eq[AccountId] {
  eq(a, b) { match (a, b) { (AccountId(x), AccountId(y)) => x == y } }
}

// Declaration order is not the ordering: Low < Normal < High.
type Priority = High | Normal | Low

func priorityRank(p Priority) Int {
  match p { Low => 0 | Normal => 1 | High => 2 }
}

instance Show[Priority] {
  show(p) { match p { Low => "Low" | Normal => "Normal" | High => "High" } }
}

instance Eq[Priority] {
  eq(a, b) { priorityRank(a) == priorityRank(b) }
}

instance Ord[Priority] {
  compare(a, b) { compare(priorityRank(a), priorityRank(b)) }
}

func describe(o Option[Int]) String {
  match o {
    Some(x) if x > 10 => "large ${x}"
    Some(x) => "small ${x}"
    None => "none"
  }
}

func main() IO[Unit] {
  let alice = AccountId("A-1")
  let ids = [alice, AccountId("B-2"), AccountId("A-1")]
  let priorities = [High, Low, Normal, Low]
  let xs: List[Int] = []
  let names = ["Ada", "Bob", "Cara"]
  let scores = [42, 7, 99]
  do {
    println("accounts: ${filter(ids, func(id) => id == alice)}")
    println("priorities: ${list.sort(priorities)}")
    println("contains: ${list.elem(Normal, priorities)} / ${list.elem(AccountId("Z-9"), ids)}")
    println("maximum: ${list.maximum(priorities)}")
    println("minimum: ${list.minimum(priorities)}")
    println("empty: ${xs} / ${head(xs)} / ${tail(xs)} / ${list.maximum(xs)}")
    let numbers: List[Int] = [1, 2, 3]
    println("head/tail: ${head(numbers)} / ${tail(numbers)}")
    println("take/drop: ${list.take(2, numbers)} / ${list.drop(2, numbers)}")
    println("sum: ${list.sum(numbers)}")
    println("concatMap: ${list.concatMap(numbers, func(n) => [n, n * 10])}")
    println("descending: ${list.sortBy(numbers, func(a, b) => compare(b, a))}")
    println("tuples: ${filter(list.zip(names, scores), func(p) => p == ("Ada", 42))}")
    list.forEach(list.zip(names, scores), func((n, s)) => println("${n}: ${s}"))
    println("guard: ${describe(Some(42))} / ${describe(Some(7))} / ${describe(None)}")
    println("starts with 1: ${xs != Nil && head(xs) == Some(1)} / ${numbers != Nil && head(numbers) == Some(1)}")
    // Neither division by zero is evaluated.
    println("short-circuit: ${false && 1 / 0 == 0} / ${true || 1 / 0 == 0}")
    println("bounds: ${float.minInt()} / ${float.maxInt()}")
  }
}
