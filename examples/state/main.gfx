package main
import "std/list"
import "std/prelude"
import "std/state"


func counter() state.State[Int, Int] {
  do {
    before <- state.get()
    state.put(before + 1)
    state.modify(func(n) => n * 2)
    after <- state.get()
    prelude.pure(after - before)
  }
}

func push(value Int) state.State[List[Int], Unit] {
  state.modify(func(xs) => Cons(value, xs))
}

func pop() state.State[List[Int], Option[Int]] {
  do {
    xs <- state.get()
    match xs {
      | Nil => prelude.pure(None)
      | Cons(x, rest) => do {
          state.put(rest)
          prelude.pure(Some(x))
        }
    }
  }
}

func stack() state.State[List[Int], Option[Int]] {
  do {
    list.forEach([3, 5], push)
    pop()
  }
}

func main() IO[Unit] {
  do {
    let (v, s) = state.runState(counter(), 10)
    println("counter: ${(v, s)}")
    println("value:   ${state.evalState(counter(), 10)}")
    println("state:   ${state.execState(counter(), 10)}")
    println("mapped:  ${state.runState(prelude.fmap(counter(), func(n) => n * 10), 10)}")
    println("stack:   ${state.runState(stack(), [1])}")
    println("empty:   ${state.runState(pop(), [])}")
    list.forEach(["first", "second", "third"], func(label) => println("IO: ${label}"))
  }
}
