package main
import "std/list"
import "std/prelude"


type Tree[A] = Leaf(A) | Branch(Tree[A], Tree[A])
  deriving Functor, Foldable, Traversable, Debug

// The display form belongs to the application, independently of Debug.
instance Show[Tree[A]] given Show[A] {
  show(tree) {
    match tree {
      Leaf(a) => show(a)
      Branch(left, right) => "(" + show(left) + " | " + show(right) + ")"
    }
  }
}

func positive(n Int) Option[Int] {
  if n > 0 { Some(n * 10) } else { None }
}

func main() IO[Unit] {
  let tree = Branch(Leaf(1), Branch(Leaf(2), Leaf(3)))
  do {
    println("display: ${tree}")
    println("debug: ${debug(tree)}")
    println("mapped: ${prelude.fmap(tree, func(n) => n + 1)}")
    println("foldr: ${prelude.foldr(tree, 0, func(n, total) => n + total)}")
    println("traverse: ${prelude.traverse(tree, positive)}")
    println("failure: ${prelude.traverse(Branch(Leaf(1), Leaf(0)), positive)}")
    println("toList: ${list.toList(tree)}")
    println("foldl: ${list.foldl(tree, 0, func(acc, n) => acc * 10 + n)}")
    println("foldMapList: ${list.foldMapList(tree, func(n) => [n, n])}")
    println("strings: ${debug(Leaf("hello\nworld"))}")
  }
}
