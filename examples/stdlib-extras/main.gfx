package main
import "std/conc"
import "std/lazy"
import "std/list"
import "std/regex"
import "std/result"
import "std/string"


type Log = Log{level: String, service: String, message: String}

func parseLog(line String) Option[Log] {
  match regex.regexCaptures("^([A-Z]+) (.*)$", line) {
    Some(Cons(level, Cons(payload, Nil))) => match string.splitOnce("=", payload) {
      Some((service, message)) => Some(Log{level: level, service: service, message: message})
      None => None
    }
    _ => None
  }
}

func main() IO[Unit] {
  let input = "INFO worker=started\nWARN api=slow request\nnot a log\nINFO cache=warm\nERROR api=timeout"
  let (accepted, rejected) = list.partition(map(string.lines(input), parseLog), result.isSome)
  let logs = list.concatMap(accepted, func(entry) => match entry { Some(log) => [log] | None => Nil })
  let sorted = list.sortOn(logs, func(log) => log.service)
  let pages = list.chunksOf(2, list.indexed(sorted))
  let expensive = lazy.delay(func(_) => list.sum(list.range(1, 10001)))
  do {
    println("accepted ${length(accepted)}, rejected ${length(rejected)}")
    println(string.padRight("#", 3) + " | " + string.padRight("SERVICE", 8) + " | " + string.padRight("LEVEL", 5) + " | MESSAGE")
    list.forEach(list.indexed(pages), func((page, rows)) => do {
      println("-- page ${page + 1} --")
      list.forEach(rows, func((i, log)) => println(
        string.padRight(show(i + 1), 3) + " | " + string.padRight(log.service, 8) + " | " + string.padRight(log.level, 5) + " | " + log.message))
    })
    println("deferred checksum: ${lazy.force(expensive)}")
  }
}
