package main

import "std/io"
import "std/list"
import "std/string"
import core "go:k8s.io/api/core/v1"
import policy "go:k8s.io/api/policy/v1"
import meta "go:k8s.io/apimachinery/pkg/apis/meta/v1"
import kube "go:k8s.io/client-go/kubernetes"
import corev1 "go:k8s.io/client-go/kubernetes/typed/core/v1"

// Drain is the controller's view of one NodeDrain request.
type Drain = Drain{node: String, requested: Bool, deadline: Deadline, lastBlock: Option[String]} deriving Eq, Debug

type Outcome = Outcome{action: Action, drain: Drain} deriving Eq, Debug

// ---- observe ------------------------------------------------------------------

func listPodsOnNode(pods corev1.PodInterface, node String) IO[List[core.Pod]] {
  do {
    listed <- pods |> corev1.podInterfaceList(_, meta.newListOptions(){fieldSelector: "spec.nodeName=" + node})
    match listed {
      None => Nil
      Some(l) => l.items
    }
  }
}

func getNode(nodes corev1.NodeInterface, name String) IO[Option[core.Node]] {
  do {
    fetched <- io.tryIO(corev1.nodeInterfaceGet(nodes, name, meta.newGetOptions()))
    match fetched {
      Ok(node) => node
      Err(io.NotFound(_)) => None
      Err(e) => io.ioRaise(e)
    }
  }
}

func observe(cs kube.Clientset, d Drain) IO[Observed] {
  do {
    client <- kube.clientsetCoreV1(cs)
    nodes <- corev1.coreV1InterfaceNodes(client)
    pods <- corev1.coreV1InterfacePods(client, "")
    node <- getNode(nodes, d.node)
    onNode <- listPodsOnNode(pods, d.node)
    now <- io.nowMillis()
    Observed{
      requested: d.requested,
      node: projectNode(node),
      cordonedByUs: cordonedByUs(node),
      pods: map(onNode, project),
      evictionBlocked: d.lastBlock,
      deadline: d.deadline,
      nowNanos: now * 1000000
    }
  }
}

// ---- apply --------------------------------------------------------------------

func patchNode(nodes corev1.NodeInterface, name String, body String) IO[Unit] {
  io.void(corev1.nodeInterfacePatch(nodes, name, "application/merge-patch+json", body, meta.newPatchOptions(), []))
}

func cordonPatch(unschedulable Bool) String {
  let annotation = if unschedulable { "\"true\"" } else { "null" }
  "{\"metadata\":{\"annotations\":{\"" + cordonAnnotation() + "\":" + annotation + "}},\"spec\":{\"unschedulable\":" + show(unschedulable) + "}}"
}

func evict(pods corev1.PodInterface, name String) IO[Option[String]] {
  let eviction = policy.newEviction(){kind: "Eviction", aPIVersion: "policy/v1", name: name}
  do {
    attempt <- io.tryIO(corev1.podInterfaceEvictV1(pods, Some(eviction)))
    match attempt {
      Ok(_) => None
      | Err(e) => {
        let message = io.ioErrorMessage(e)
        if string.startsWith(message, "TooManyRequests:") {
          Some(message)
        } else {
          io.ioRaise(e)
        }
      }
    }
  }
}

func apply(cs kube.Clientset, d Drain, action Action) IO[Drain] {
  do {
    client <- kube.clientsetCoreV1(cs)
    nodes <- corev1.coreV1InterfaceNodes(client)
    match action {
      Cordon => do { patchNode(nodes, d.node, cordonPatch(true)); d }
      Uncordon => do { patchNode(nodes, d.node, cordonPatch(false)); d }
      | Evict(ns, name) => do {
        pods <- corev1.coreV1InterfacePods(client, ns)
        blocked <- evict(pods, name)
        d{lastBlock: blocked}
      }
      Wait(_) => d{lastBlock: None}
      _ => d
    }
  }
}

func reconcile(cs kube.Clientset, d Drain) IO[Outcome] {
  do {
    o <- observe(cs, d)
    let action = decide(o)
    next <- apply(cs, d, action)
    Outcome(action, next)
  }
}

// The Go shell owns construction, scheduling and execution of these IO values.
func main() IO[Unit] { ioPure(unit()) }
