package main

extern func parseURL(raw String) IO[URL] = "gofx/examples/typed-extern/shim".ParseURL

func main() IO[Unit] {
  do {
    println(strToUpper("gofx meets Go"))
    println(strRepeat("na", 3))
    println(show(strFields("typed externs   keep lists")))
    url <- parseURL("https://gofx.example:8443/guide")
    println(uRLHostname(url))
    println(uRLString(url))
  }
}
