package main

import "std/io"
import "std/list"
import "std/prelude"
import "std/result"
import "std/string"

// Validation is pure. A failed parse or nonpositive value skips every later bind.
func positive(text String, label String) Result[String, Int] {
  do {
    n <- result.okOr(string.parseInt(text), label + ": expected an integer")
    if n > 0 {
      Ok(n)
    } else {
      Err(label + ": must be positive")
    }
  }
}

func validate(config String) Result[String, Int] {
  match string.words(config) {
    | Cons(first, Cons(second, Nil)) => do {
      a <- positive(first, "first")
      b <- positive(second, "second")
      prelude.pure(a + b)
    }
    _ => Err("expected two integers")
  }
}

func main() IO[Unit] {
  do {
    argv <- io.args()
    let configPath = result.fromOption(head(argv), "examples/io-effects/missing.conf")
    let output = result.fromOption(head(tail(argv)), "io-effects")
    loaded <- io.tryIO(io.readFile(configPath))
    let config = result.fromResult(loaded, "3 4")
    println(match loaded {
      Err(_) => "config: defaults (read failed)"
      Ok(_) => "config: file"
    })
    lineCount <- io.tryIO(io.foldLines(configPath, 0, func(n, _line) => ioPure(n + 1)))
    println(match lineCount {
      Ok(n) => "config lines: ${n}"
      Err(_) => "config lines: unavailable"
    })
    let result = validate(config)
    println("validation: ${result}")
    println("early error: ${validate("bad also-bad")}")
    io.writeFile(output + ".report.txt", "sum: ${result}\n")
    timestamp <- io.nowMillis()
    io.appendFile(output + ".log", io.formatTime(timestamp, "2006-01-02T15:04:05.000Z") + " sum: ${result}\n")
    println("wrote report and appended timestamped log")
  }
}
