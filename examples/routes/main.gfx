package main

import "std/list"
import "std/prelude"

// 最短経路探索: 不変のリストだけで Dijkstra 法を実装する。
// 前提: 所要時間は非負。優先キューは整列リストなので小規模な路線向け。
// 通常11分、Market閉鎖15分、Park遅延12分。孤立駅への経路は None。
// 実行: go run ./cmd/gofx run examples/routes/main.gfx
type Station = Home | Market | Park | Museum | Harbor | Island deriving Eq, Debug

// Station labels are also the user-facing names; keep list display compact.
instance Show[Station] {
  show(station) {
    debug(station)
  }
}

type Road = Road{from: Station, to: Station, minutes: Int}

type Route = Route{stops: List[Station], minutes: Int}

// previous は逆順の経路。先頭への追加で経路の末尾コピーを避ける。
type Visit = Visit{station: Station, minutes: Int, previous: List[Station]}

func enqueue(visit Visit, queue List[Visit]) List[Visit] {
  match queue {
    Nil => [visit]
    Cons(front, _) if visit.minutes < front.minutes => Cons(visit, queue)
    Cons(front, rest) => Cons(front, enqueue(visit, rest))
  }
}

func search(roads List[Road], goal Station, queue List[Visit], settled List[Station]) Option[Route] {
  match queue {
    Nil => None
    Cons(current, rest) if list.elem(current.station, settled) => search(roads, goal, rest, settled)
    | Cons(current, _) if current.station == goal => Some(Route{
      stops: reverse(Cons(current.station, current.previous)),
      minutes: current.minutes
    })
    | Cons(current, rest) => {
      let visited = Cons(current.station, settled)
      let outgoing = filter(roads, func(r) => r.from == current.station && !list.elem(r.to, visited))
      let previous = Cons(current.station, current.previous)
      let frontier = fold(outgoing, rest, func(q, r) => enqueue(Visit{
        station: r.to,
        minutes: current.minutes + r.minutes,
        previous: previous
      }, q))
      search(roads, goal, frontier, visited)
    }
  }
}

func shortest(roads List[Road], start Station, goal Station) Option[Route] {
  search(roads, goal, [Visit{station: start, minutes: 0, previous: []}], [])
}

// Option の do: どちらかの区間が到達不能なら全体が None になる。
func via(roads List[Road], start Station, waypoint Station, goal Station) Option[Route] {
  do {
    first <- shortest(roads, start, waypoint)
    second <- shortest(roads, waypoint, goal)
    prelude.pure(Route{
      stops: append(first.stops, tail(second.stops)),
      minutes: first.minutes + second.minutes
    })
  }
}

func printRoute(label String, result Option[Route]) IO[Unit] {
  match result {
    Some(route) => println("${label}: ${route.minutes} min, ${route.stops}")
    None => println("${label}: unreachable")
  }
}

func main() IO[Unit] {
  // 各区間を往復可能にする。直行便より乗り継ぎが速いネットワーク。
  let roads = list.concatMap([(Home, Harbor, 20), (Home, Market, 4), (Home, Park, 2), (Park, Market, 1), (Market, Museum, 5), (Park, Museum, 10), (Museum, Harbor, 3)], func((a, b, minutes)) => [Road{
    from: a,
    to: b,
    minutes: minutes
  }, Road{from: b, to: a, minutes: minutes}])
  let marketClosed = filter(roads, func(r) => r.from != Market && r.to != Market)
  // レコード更新も元の道路は変更しない。
  let slowPark = map(roads, func(r) => if r.from == Park || r.to == Park {
    r{minutes: r.minutes + 10}
  } else {
    r
  })
  do {
    printRoute("fastest", shortest(roads, Home, Harbor))
    printRoute("return trip", shortest(roads, Harbor, Home))
    printRoute("Market closed", shortest(marketClosed, Home, Harbor))
    printRoute("Park delayed", shortest(slowPark, Home, Harbor))
    printRoute("via Museum", via(roads, Home, Museum, Harbor))
    printRoute("already there", shortest(roads, Home, Home))
    printRoute("isolated island", shortest(roads, Home, Island))
    printRoute("via island", via(roads, Home, Island, Harbor))
    printRoute("empty network", shortest([], Home, Harbor))
  }
}
