package main

import "std/string"

func main() IO[Unit] {
  let pieces = string.split(",", "  red, green ,blue  ")
  let cleaned = map(pieces, func(piece) => string.trim(piece))
  let text = string.join(" / ", cleaned)
  do {
    println("split: ${pieces}")
    println("join/trim: " + text)
    println("upper: " + string.toUpper(text))
    println("replace: " + string.replace("banana", "na", "NA"))
    println("substring: " + string.substring("Aé界Z", 1, 3))
    println("chars: ${string.chars("Aé界")}")
    println("repeat: " + string.repeat("ha", 3))
    println("parse: ${string.parseInt("42")} / ${string.parseInt("oops")}")
    println("padded: [" + string.showPadLeft(42, 5) + "]")
    println("length: ${string.strLength("Aé界")}")
  }
}
