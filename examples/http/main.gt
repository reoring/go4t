package main

import "std/http"
import "std/json"
import "std/conc"
import "std/chan"
import "std/io"
import "std/list"
import "std/string"

type Health = Health{ok: Bool} deriving json.Encode

type Sum = Sum{sum: Int} deriving json.Encode, json.Decode

func number(query List[(String, String)], name String) Result[String, Int] {
  match list.lookup(name, query) {
    None => Err("missing query parameter: " + name)
    | Some(text) => match string.parseInt(text) {
      None => Err("invalid integer: " + name)
      Some(n) => Ok(n)
    }
  }
}

func sum(query List[(String, String)]) Result[String, Sum] {
  do {
    a <- number(query, "a")
    b <- number(query, "b")
    Ok(Sum(a + b))
  }
}

func handle(r http.Request) IO[http.Response] {
  ioPure(if r.method == "GET" && r.path == "/health" {
    http.jsonResponse(200, Health(true))
  } else if r.method == "GET" && r.path == "/sum" {
    match sum(r.query) {
      Ok(value) => http.jsonResponse(200, value)
      Err(message) => http.response(400, message)
    }
  } else {
    http.response(404, "not found")
  })
}

func fetchSum(ports RecvChan[Int]) IO[Unit] {
  do {
    bound <- conc.withTimeout(1000, chan.recv(ports))
    port <- match bound {
      Some(port) => ioPure(port)
      None => ioFail("server readiness channel closed")
    }
    let url = "http://127.0.0.1:" + show(port)
    r <- http.get(url + "/sum?a=1&b=2")
    let decoded: Result[String, Sum] = do {
      value <- json.parseJson(r.body)
      json.decode(value)
    }
    match decoded {
      Ok(value) => println("sum: " + show(value.sum))
      Err(message) => ioFail(message)
    }
  }
}

func main() IO[Unit] {
  do {
    argv <- io.args()
    let port = match argv {
      [] => 0
      | [text, ..] => match string.parseInt(text) {
        Some(n) => n
        None => 0
      }
    }
    ports <- chan.make(1)
    server <- conc.fork(http.serveOnReady("127.0.0.1", port, handle, func(actualPort) => chan.send(chan.asSend(ports), actualPort)))
    result <- io.tryIO(fetchSum(chan.asRecv(ports)))
    conc.cancel(server)
    match result {
      Ok(_) => ioPure(unit())
      Err(e) => io.ioRaise(e)
    }
  }
}
