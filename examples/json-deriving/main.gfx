package main

type Item = Item{sku: String, qty: Int, price: Float} deriving Encode, Decode
type Order = Order{id: Int, customer: String, items: List[Item], note: Option[String]} deriving Encode, Decode
type Status = Pending | Shipped(String) deriving Encode, Decode

func main() IO[Unit] {
  let order = Order{
    id: 42,
    customer: "Ada",
    items: [Item{sku: "GO-1", qty: 2, price: 12.5}],
    note: Some("Leave at reception")
  }
  let roundTrip: Result[String, Order] = bind(parseJson(toJson(encode(order))), decode)
  let bad = "{\"id\":42,\"customer\":\"Ada\",\"items\":[{\"sku\":\"a\",\"qty\":1,\"price\":2},{\"sku\":\"b\",\"qty\":1,\"price\":2},{\"sku\":false,\"qty\":1,\"price\":2}],\"note\":null}"
  let malformed: Result[String, Order] = bind(parseJson(bad), decode)
  let status: Result[String, Status] = bind(parseJson(toJson(encode(Shipped("TRACK-7")))), decode)
  do {
    println(match roundTrip { Ok(value) => "round-trip: " + show(toJson(encode(value)) == toJson(encode(order))); Err(e) => e })
    println(toJsonPretty(encode(order)))
    println(toJson(encode(Pending)))
    println(match status { Ok(value) => toJson(encode(value)); Err(e) => e })
    println(match malformed { Err(e) => e; Ok(_) => "unexpected success" })
  }
}
