package main

import "std/list"
import "std/string"

func nonEmpty(s String) Bool {
  string.trim(s) |> (_ != "")
}

func add(a Int, b Int) Int {
  a + b
}

func main() IO[Unit] {
  let input = " pear \n\n apple\n banana \n   \n"
  let cleaned = string.lines(input)
    |> filter(_, nonEmpty)
    |> map(_, string.trim)
    |> list.sortBy(_, compare)
    |> string.join("\n", _)
  let increment = add(1, _)
  let less = (_ < _)
  let equalApple = (_ == "apple")
  let scores = [1, 2, 3]
    |> map(_, (_ + 1))
    |> map(_, (2 * _))
    |> map(_, show)
    |> string.join(", ", _)
  do {
    println(cleaned)
    println("scores: " + scores)
    println("steps: ${3 |> increment |> add(4) |> (func(n) => n * 2)}")
    expectedKeys()
    println("sections: ${less(1, 2)}, ${equalApple("apple")}")
  }
}

type Sale = Sale{product: String, qty: Int, jpy: Int}

func productKey() Option[func(Sale) String] {
  Some(_.product)
}

func quantityKey(useQuantity Bool) func(Sale) Int {
  match useQuantity {
    true => _.qty
    false => _.jpy
  }
}

func expectedKeys() IO[Unit] {
  let sale = Sale{product: "tea", qty: 2, jpy: 300}
  let f: func(Sale) String = _.product
  let key: func(Sale) String = func(s) => s.product
  let sorted = list.sortOn([sale, Sale{product: "coffee", qty: 1, jpy: 200}], func(s) => s.jpy)
  let wrapped = match productKey() {
    Some(project) => project(sale)
    None => ""
  }
  println("keys: ${f(sale)}, ${key(sale)}, ${wrapped}; qty: ${quantityKey(true)(sale)}; sorted: ${map(sorted, _.product)}")
}
