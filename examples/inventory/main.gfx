package main

// ===== ドメイン =====

type Sku = Sku(String)
type Stock = Stock{sku: Sku, qty: Int}      // 在庫: sku, 数量
type Line = Line{sku: Sku, qty: Int}        // 注文明細: sku, 要求数

type Result[E, A] = Err(E) | Ok(A)         // 自前の Either

// ===== 型クラスのインスタンス =====

instance Show[Sku] {
  show(s) { match s { Sku(code) => code } }
}

instance Show[Stock] {
  show(s) { "${s.sku}=${s.qty}" }
}

instance Show[Line] {
  show(l) { "${l.qty}x${l.sku}" }
}

instance Show[Result[E, A]] given Show[E], Show[A] {
  show(r) {
    match r {
      Err(e) => "Err(${e})"
      Ok(a) => "Ok(${a})"
    }
  }
}

// Result[E, _] は Functor / Monad。Monad は Functor のサブクラスなので両方書く
instance Functor[Result[E]] {
  fmap(r, f) {
    match r {
      Err(e) => Err(e)
      Ok(a) => Ok(f(a))
    }
  }
}

instance Monad[Result[E]] {
  pure(a) { Ok(a) }
  bind(r, f) {
    match r {
      Err(e) => Err(e)
      Ok(a) => f(a)
    }
  }
}

// ===== 純粋ロジック =====

func sameSku(a Sku, b Sku) Bool {
  match (a, b) { (Sku(x), Sku(y)) => x == y }
}

// 複数倉庫の在庫を sku ごとに合算
func merge(stocks List[Stock]) List[Stock] {
  fold(stocks, [], func(acc, s) => addStock(acc, s))
}

func addStock(acc List[Stock], s Stock) List[Stock] {
  match (acc, s) {
    | (Nil, _) => [s]
    | (Cons(whole @ Stock(sku, qty), rest), Stock(sku2, qty2)) =>
        if sameSku(sku, sku2) { Cons(Stock(sku, qty + qty2), rest) }
        else { Cons(whole, addStock(rest, s)) }
  }
}

func available(stocks List[Stock], sku Sku) Int {
  fold(stocks, 0, func(acc, stock) => match stock {
    Stock{sku: s, ..} => if sameSku(sku, s) { acc + stock.qty } else { acc }
  })
}

// 1 明細の引当。失敗理由を Err に積む
func allocate(stocks List[Stock], line Line) Result[String, Line] {
  if line.qty <= 0 { Err("invalid quantity for ${line.sku}") }
  else if available(stocks, line.sku) < line.qty {
    Err("short of ${line.sku}: need ${line.qty}, have ${available(stocks, line.sku)}")
  }
  else { Ok(line) }
}

// 注文全体の引当: Result モナドで最初の失敗で止まる
func allocateAll(stocks List[Stock], lines List[Line]) Result[String, List[Line]] {
  match lines {
    | Nil => Ok([])
    | Cons(l, rest) => do {
        done <- allocate(stocks, l)
        others <- allocateAll(stocks, rest)
        pure(Cons(done, others))
      }
  }
}

// 引当後の在庫を減らす
func consume(stocks List[Stock], lines List[Line]) List[Stock] {
  fold(lines, stocks, func(acc, l) => fmap(acc, func(s) =>
    if sameSku(l.sku, s.sku) { s{qty: s.qty - l.qty} } else { s }
  ))
}

// HKT: Functor であれば何にでも適用できる汎用ヘルパ
func tag[F[_] Functor, A Show](fa F[A], prefix String) F[String] {
  fmap(fa, func(a) => "${prefix}${a}")
}

// ===== 効果 =====

extern func httpGet(url String) IO[Int] = "gofx/rt/stdhttp".GetStatus

func report(title String, r Result[String, List[Line]]) IO[Unit] {
  println("${title}: ${r}")
}

func notify(lines List[Line]) IO[Unit] {
  do {
    status <- httpGet("https://example.com")
    if status == 200 {
      println("  notified ${length(lines)} lines")
    }
    else {
      ioFail("notify failed: ${status}")
    }
  }
}

func main() IO[Unit] {
  let warehouseA = [Stock{sku: Sku("apple"), qty: 5}, Stock{sku: Sku("pear"), qty: 2}]
  let warehouseB = [Stock{sku: Sku("apple"), qty: 3}, Stock{sku: Sku("fig"), qty: 9}]
  let stocks = merge(append(warehouseA, warehouseB))
  let order1 = [Line{sku: Sku("apple"), qty: 7}, Line{sku: Sku("fig"), qty: 1}]
  let order2 = [Line{sku: Sku("apple"), qty: 7}, Line{sku: Sku("pear"), qty: 3}]
  let order3 = [Line{sku: Sku("apple"), qty: 0}]
  do {
    println("stocks:   ${stocks}")
    println("tagged:   ${tag(stocks, "stock:")}")
    println("tagged?:  ${tag(Some(42), "n=")}")
    report("order1", allocateAll(stocks, order1))
    report("order2", allocateAll(stocks, order2))
    report("order3", allocateAll(stocks, order3))
    match allocateAll(stocks, order1) {
      | Ok(lines) => do {
          notify(lines)
          println("  remaining ${consume(stocks, lines)}")
        }
      | Err(e) => println("  skipped: ${e}")
    }
    x <- tag(ioPure((1, true)), "io:")
    println(x)
  }
}
