package main

import "std/prelude"

type Tree[A] = Leaf | Node(Tree[A], A, Tree[A])

instance Functor[Tree] {
  fmap(t, f) {
    match t {
      Leaf => Leaf
      Node(left, a, right) => Node(prelude.fmap(left, f), f(a), prelude.fmap(right, f))
    }
  }
}

func render[A Show](t Tree[A]) String {
  match t {
    Leaf => "."
    Node(left, a, right) => "(" + render(left) + " " + show(a) + " " + render(right) + ")"
  }
}

func main() IO[Unit] {
  let t = Node(Node(Leaf, 1, Leaf), 2, Leaf)
  println(render(prelude.fmap(t, func(n) => n * 10)))
}
