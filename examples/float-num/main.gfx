package main
import "std/float"


func mean(xs List[Float]) Float {
  fold(xs, 0.0, func(total, x) => total + x) / toFloat(length(xs))
}

func stddev(xs List[Float]) Float {
  let average = mean(xs)
  float.sqrt(mean(map(xs, func(x) => (x - average) * (x - average))))
}

func main() IO[Unit] {
  let samples = [2.0, 4.0, 4.0, 4.0, 5.0, 5.0, 7.0, 9.0]
  do {
    println("mean=${float.showFloatFixed(mean(samples), 2)} stddev=${float.showFloatFixed(stddev(samples), 2)}")
    println("literals=${1.5}, ${2e3}, ${1.0e-3}")
    println("parse=${show(float.parseFloat("12.5"))} invalid=${show(float.parseFloat("oops"))}")
    println("pow=${float.pow(2.0, 3.0)} powInt=${float.powInt(3, 5)}")
    println("ints min=${min(8, 3)} max=${max(8, 3)}; floats min=${min(1.5, 2.5)} max=${max(1.5, 2.5)}")
    println("truncate=${float.truncate(-2.75)} floor=${float.floor(-2.75)} ceil=${float.ceil(-2.75)} round=${float.round(-2.5)} abs=${float.absFloat(-2.75)}")
    println("division=${1.0 / 0.0}, ${-1.0 / 0.0}; NaN=${float.isNaN(0.0 / 0.0)} ordered=${float.nan() < 0.0} equal=${float.nan() == float.nan()}")
  }
}
