package decide

// Payloads are named (`TtlNanos{nanos: Int}`), so the Go side reads
// `ttl.Nanos`, not a positional `F0`.
type Ttl = NoTtl | InvalidTtl | TtlNanos{nanos: Int} deriving Eq, Debug

type Timestamp = NoTimestamp | InvalidTimestamp | AtNanos{nanos: Int} deriving Eq, Debug

type Freshness = Fresh{remainingNanos: Int} | TtlInvalid | TimestampMissing | TimestampInvalid | Stale deriving Eq, Debug

func freshness(ttl Ttl, observedAt Timestamp, nowNanos Int) Freshness {
  match (ttl, observedAt) {
    (NoTtl, _) => Fresh(0)
    (InvalidTtl, _) => TtlInvalid
    (TtlNanos(_), NoTimestamp) => TimestampMissing
    (TtlNanos(_), InvalidTimestamp) => TimestampInvalid
    (TtlNanos(t), AtNanos(at)) if nowNanos >= at + t => Stale
    (TtlNanos(t), AtNanos(at)) => Fresh(at + t - nowNanos)
  }
}

// Every constructor is named: adding one to Freshness makes this fail to
// compile instead of silently counting as "not stale".
func isStale(value Freshness) Bool {
  match value {
    Stale => true
    Fresh(_) | TtlInvalid | TimestampMissing | TimestampInvalid => false
  }
}

// ---- Laws: checked by `go4t check` for every input, not generated into Go ----

// The cases that do not depend on time. A law with no proof is checked by refl.
law noTtlIsFresh(at Timestamp, now Int) {
  freshness(NoTtl, at, now) == Fresh(0)
}

law invalidTtlWins(at Timestamp, now Int) {
  freshness(InvalidTtl, at, now) == TtlInvalid
}

// The inputs the time laws talk about: a TTL up to 1000 s, and timestamps from
// the epoch to 2096 with the observation not in the future.
let maxTtlNanos = 1_000_000_000_000

let maxNowNanos = 4_000_000_000_000_000_000

func plausible(t Int, at Int, now Int) Bool {
  0 <= t && t <= maxTtlNanos && 0 <= at && at <= now && now <= maxNowNanos
}

// Stale exactly when the TTL has elapsed, the boundary included.
//
// `requires` states the range in which that sentence is true. Int wraps, so
// without a bound `at + t` can overflow and "elapsed" stops meaning what it
// says; delete the clause and the checker prints the overflowing input.
law staleOnceElapsed(t Int, at Int, now Int) requires plausible(t, at, now) {
  isStale(freshness(TtlNanos(t), AtNanos(at), now)) == (now - at >= t)
} proof {
  match now - at >= t
}

// Until then, the remaining time is the TTL minus the elapsed time.
law freshForTheRemainder(t Int, at Int, now Int)
  requires plausible(t, at, now)
  requires now - at < t
{
  freshness(TtlNanos(t), AtNanos(at), now) == Fresh(t - (now - at))
}

func main() IO[Unit] {
  ioPure(unit())
}
