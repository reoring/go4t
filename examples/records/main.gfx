package main

type User = User{name: String, age: Int, email: Option[String]}

instance Show[User] {
  show(u) { "${u.name} (${u.age}, ${u.email})" }
}

func contact(u User) Option[String] {
  do {
    email <- u.email
    pure("${u.name}: ${email}")
  }
}

func main() IO[Unit] {
  let users = [
    User{name: "Ada", age: 36, email: Some("ada@example.com")},
    User{name: "Bob", age: 28, email: None},
    User{name: "Cara", age: 41, email: Some("cara@example.com")}
  ]
  let older = func(u User) => u{age: u.age + 1}
  let x = None
  let pair = func(x) => (x, x)
  do {
    println("users:    ${users}")
    println("older:    ${fmap(users, older)}")
    println("ints:     ${pair(7)}")
    println("strings:  ${pair("hi")}")
    println("contacts: ${fmap(users, contact)}")
  }
}
