package prelude

class Functor[F[_]] {
  fmap[A, B](fa F[A], f func(A) B) F[B]
}

class Monad[M[_]] : Functor[M] {
  pure[A](a A) M[A]
  bind[A, B](ma M[A], f func(A) M[B]) M[B]
}

class Foldable[F[_]] {
  foldr[A, B](fa F[A], init B, f func(A, B) B) B
}

class Traversable[F[_]] : Functor[F] {
  traverse[M[_] Monad, A, B](fa F[A], f func(A) M[B]) M[F[B]]
}

class Show[A] {
  show(a A) String
}

class Debug[A] {
  debug(a A) String
}

class Eq[A] {
  eq(a A, b A) Bool
}

type Ordering = LT | EQ | GT deriving Eq, Ord, Debug

class Ord[A] : Eq[A] {
  compare(a A, b A) Ordering
}

type Option[A] = None | Some(A) deriving Eq, Ord, Debug

type Result[E, A] = Err(E) | Ok(A) deriving Eq, Ord, Debug

instance Show[Result[E, A]] given Show[E], Show[A] {
  show(r) { match r { Err(e) => "Err(" + show(e) + ")"; Ok(a) => "Ok(" + show(a) + ")" } }
}

type List[A] = Nil | Cons(A, List[A]) deriving Eq, Ord, Debug

type State[S, A] = State(func(S) (A, S))

instance Functor[Option] {
  fmap(fa, f) {
    match fa {
      None => None
      Some(a) => Some(f(a))
    }
  }
}

instance Monad[Option] {
  pure(a) { Some(a) }
  bind(ma, f) {
    match ma {
      None => None
      Some(a) => f(a)
    }
  }
}

instance Functor[Result[E]] {
  fmap(r, f) {
    match r { Err(e) => Err(e) | Ok(a) => Ok(f(a)) }
  }
}

instance Monad[Result[E]] {
  pure(a) { Ok(a) }
  bind(r, f) {
    match r { Err(e) => Err(e) | Ok(a) => f(a) }
  }
}

instance Functor[List] {
  fmap(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => Cons(f(x), fmap(rest, f))
    }
  }
}

instance Monad[List] {
  pure(a) { Cons(a, Nil) }
  bind(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => append(f(x), bind(rest, f))
    }
  }
}

instance Foldable[Option] {
  foldr(fa, init, f) {
    match fa { None => init; Some(a) => f(a, init) }
  }
}

instance Traversable[Option] {
  traverse(fa, f) {
    match fa {
      None => pure(None)
      Some(a) => fmap(f(a), func(b) => Some(b))
    }
  }
}

instance Foldable[List] {
  foldr(fa, init, f) {
    match fa {
      Nil => init
      Cons(a, rest) => f(a, foldr(rest, init, f))
    }
  }
}

instance Traversable[List] {
  traverse(fa, f) {
    match fa {
      Nil => pure(Nil)
      Cons(a, rest) => bind(f(a), func(b) => fmap(traverse(rest, f), func(bs) => Cons(b, bs)))
    }
  }
}

func foldl[F[_] Foldable, A, B](fa F[A], init B, f func(B, A) B) B {
  foldr(fa, func(b B) => b, func(a, next) => func(b) => next(f(b, a)))(init)
}

func toList[F[_] Foldable, A](fa F[A]) List[A] {
  foldr(fa, Nil, func(a, rest) => Cons(a, rest))
}

func foldMapList[F[_] Foldable, A, B](fa F[A], f func(A) List[B]) List[B] {
  foldr(fa, Nil, func(a, rest) => append(f(a), rest))
}

instance Functor[State[S]] {
  fmap(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => (f(a), s2) })
  }
}

instance Monad[State[S]] {
  pure(a) { State(func(s) => (a, s)) }
  bind(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => runState(f(a), s2) })
  }
}

func runState[S, A](st State[S, A], s S) (A, S) {
  match st { State(run) => run(s) }
}

func evalState[S, A](st State[S, A], s S) A {
  fst(runState(st, s))
}

func execState[S, A](st State[S, A], s S) S {
  snd(runState(st, s))
}

func get[S]() State[S, S] {
  State(func(s) => (s, s))
}

func put[S](s S) State[S, Unit] {
  State(func(_ignored) => (unit(), s))
}

func modify[S](f func(S) S) State[S, Unit] {
  State(func(s) => (unit(), f(s)))
}

func fromOption[A](o Option[A], d A) A {
  match o { None => d | Some(a) => a }
}

func maybe[A, B](o Option[A], d B, f func(A) B) B {
  match o { None => d | Some(a) => f(a) }
}

func isSome[A](o Option[A]) Bool {
  match o { None => false | Some(_) => true }
}

func isNone[A](o Option[A]) Bool {
  match o { None => true | Some(_) => false }
}

instance Show[Ordering] {
  show(a) { match a { LT => "LT"; EQ => "EQ"; GT => "GT" } }
}

instance Show[Option[A]] given Show[A] {
  show(a) { match a { None => "None"; Some(x) => "Some(" + show(x) + ")" } }
}

func mapErr[E, F, A](r Result[E, A], f func(E) F) Result[F, A] {
  match r { Err(e) => Err(f(e)) | Ok(a) => Ok(a) }
}

func fromResult[E, A](r Result[E, A], d A) A {
  match r { Err(_) => d | Ok(a) => a }
}

func okOr[E, A](o Option[A], e E) Result[E, A] {
  match o { None => Err(e) | Some(a) => Ok(a) }
}

func toOption[E, A](r Result[E, A]) Option[A] {
  match r { Err(_) => None | Ok(a) => Some(a) }
}

func isOk[E, A](r Result[E, A]) Bool {
  match r { Err(_) => false | Ok(_) => true }
}

func isErr[E, A](r Result[E, A]) Bool {
  match r { Err(_) => true | Ok(_) => false }
}

func either[E, A, B](r Result[E, A], onErr func(E) B, onOk func(A) B) B {
  match r { Err(e) => onErr(e) | Ok(a) => onOk(a) }
}

func liftResult[E Show, A](r Result[E, A]) IO[A] {
  match r { Err(e) => ioFail(show(e)) | Ok(a) => ioPure(a) }
}

func ioFailWith[E Show, A](e E) IO[A] {
  ioFail(show(e))
}

instance Show[List[A]] given Show[A] {
  show(xs) {
    match xs {
      Nil => "[]"
      Cons(x, rest) => "[" + fold(rest, show(x), func(acc, a) => acc + ", " + show(a)) + "]"
    }
  }
}

instance Show[(A, B)] given Show[A], Show[B] {
  show(p) {
    match p {
      (a, b) => "(" + show(a) + ", " + show(b) + ")"
    }
  }
}

instance Debug[(A, B)] given Debug[A], Debug[B] {
  debug(p) { match p { (a, b) => "(" + debug(a) + ", " + debug(b) + ")" } }
}

