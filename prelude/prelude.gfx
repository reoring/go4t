package prelude

class Functor[F[_]] {
  fmap[A, B](fa F[A], f func(A) B) F[B]
}

class Monad[M[_]] : Functor[M] {
  pure[A](a A) M[A]
  bind[A, B](ma M[A], f func(A) M[B]) M[B]
}

class Show[A] {
  show(a A) String
}

class Eq[A] {
  eq(a A, b A) Bool
}

type Ordering = LT | EQ | GT deriving Eq, Ord, Show

class Ord[A] : Eq[A] {
  compare(a A, b A) Ordering
}

type Option[A] = None | Some(A) deriving Eq, Ord, Show

type List[A] = Nil | Cons(A, List[A]) deriving Eq, Ord

type State[S, A] = State(func(S) (A, S))

instance Functor[Option] {
  fmap(fa, f) {
    match fa {
      None => None
      Some(a) => Some(f(a))
    }
  }
}

instance Monad[Option] {
  pure(a) { Some(a) }
  bind(ma, f) {
    match ma {
      None => None
      Some(a) => f(a)
    }
  }
}

instance Functor[List] {
  fmap(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => Cons(f(x), fmap(rest, f))
    }
  }
}

instance Monad[List] {
  pure(a) { Cons(a, Nil) }
  bind(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => append(f(x), bind(rest, f))
    }
  }
}

instance Functor[State[S]] {
  fmap(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => (f(a), s2) })
  }
}

instance Monad[State[S]] {
  pure(a) { State(func(s) => (a, s)) }
  bind(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => runState(f(a), s2) })
  }
}

func runState[S, A](st State[S, A], s S) (A, S) {
  match st { State(run) => run(s) }
}

func evalState[S, A](st State[S, A], s S) A {
  fst(runState(st, s))
}

func execState[S, A](st State[S, A], s S) S {
  snd(runState(st, s))
}

func get[S]() State[S, S] {
  State(func(s) => (s, s))
}

func put[S](s S) State[S, Unit] {
  State(func(ignored) => (unit(), s))
}

func modify[S](f func(S) S) State[S, Unit] {
  State(func(s) => (unit(), f(s)))
}

func fromOption[A](o Option[A], d A) A {
  match o { None => d | Some(a) => a }
}

func maybe[A, B](o Option[A], d B, f func(A) B) B {
  match o { None => d | Some(a) => f(a) }
}

func isSome[A](o Option[A]) Bool {
  match o { None => false | Some(_) => true }
}

func isNone[A](o Option[A]) Bool {
  match o { None => true | Some(_) => false }
}

instance Show[List[A]] given Show[A] {
  show(xs) {
    match xs {
      Nil => "[]"
      Cons(x, rest) => "[" + fold(rest, show(x), func(acc, a) => acc + ", " + show(a)) + "]"
    }
  }
}

instance Show[(A, B)] given Show[A], Show[B] {
  show(p) {
    match p {
      (a, b) => "(" + show(a) + ", " + show(b) + ")"
    }
  }
}

