package prelude

class Functor[F[_]] {
  fmap[A, B](fa F[A], f func(A) B) F[B]
}

class Monad[M[_]] : Functor[M] {
  pure[A](a A) M[A]
  bind[A, B](ma M[A], f func(A) M[B]) M[B]
}

class Show[A] {
  show(a A) String
}

class Eq[A] {
  eq(a A, b A) Bool
}

type Ordering = LT | EQ | GT deriving Eq, Ord, Show

class Ord[A] : Eq[A] {
  compare(a A, b A) Ordering
}

type Option[A] = None | Some(A) deriving Eq, Ord, Show

type Result[E, A] = Err(E) | Ok(A) deriving Eq, Ord, Show

type List[A] = Nil | Cons(A, List[A]) deriving Eq, Ord

type State[S, A] = State(func(S) (A, S))

instance Functor[Option] {
  fmap(fa, f) {
    match fa {
      None => None
      Some(a) => Some(f(a))
    }
  }
}

instance Monad[Option] {
  pure(a) { Some(a) }
  bind(ma, f) {
    match ma {
      None => None
      Some(a) => f(a)
    }
  }
}

instance Functor[Result[E]] {
  fmap(r, f) {
    match r { Err(e) => Err(e) | Ok(a) => Ok(f(a)) }
  }
}

instance Monad[Result[E]] {
  pure(a) { Ok(a) }
  bind(r, f) {
    match r { Err(e) => Err(e) | Ok(a) => f(a) }
  }
}

instance Functor[List] {
  fmap(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => Cons(f(x), fmap(rest, f))
    }
  }
}

instance Monad[List] {
  pure(a) { Cons(a, Nil) }
  bind(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => append(f(x), bind(rest, f))
    }
  }
}

instance Functor[State[S]] {
  fmap(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => (f(a), s2) })
  }
}

instance Monad[State[S]] {
  pure(a) { State(func(s) => (a, s)) }
  bind(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => runState(f(a), s2) })
  }
}

func runState[S, A](st State[S, A], s S) (A, S) {
  match st { State(run) => run(s) }
}

func evalState[S, A](st State[S, A], s S) A {
  fst(runState(st, s))
}

func execState[S, A](st State[S, A], s S) S {
  snd(runState(st, s))
}

func get[S]() State[S, S] {
  State(func(s) => (s, s))
}

func put[S](s S) State[S, Unit] {
  State(func(ignored) => (unit(), s))
}

func modify[S](f func(S) S) State[S, Unit] {
  State(func(s) => (unit(), f(s)))
}

func fromOption[A](o Option[A], d A) A {
  match o { None => d | Some(a) => a }
}

func maybe[A, B](o Option[A], d B, f func(A) B) B {
  match o { None => d | Some(a) => f(a) }
}

func isSome[A](o Option[A]) Bool {
  match o { None => false | Some(_) => true }
}

func isNone[A](o Option[A]) Bool {
  match o { None => true | Some(_) => false }
}

func mapErr[E, F, A](r Result[E, A], f func(E) F) Result[F, A] {
  match r { Err(e) => Err(f(e)) | Ok(a) => Ok(a) }
}

func fromResult[E, A](r Result[E, A], d A) A {
  match r { Err(_) => d | Ok(a) => a }
}

func okOr[E, A](o Option[A], e E) Result[E, A] {
  match o { None => Err(e) | Some(a) => Ok(a) }
}

func toOption[E, A](r Result[E, A]) Option[A] {
  match r { Err(_) => None | Ok(a) => Some(a) }
}

func isOk[E, A](r Result[E, A]) Bool {
  match r { Err(_) => false | Ok(_) => true }
}

func isErr[E, A](r Result[E, A]) Bool {
  match r { Err(_) => true | Ok(_) => false }
}

func either[E, A, B](r Result[E, A], onErr func(E) B, onOk func(A) B) B {
  match r { Err(e) => onErr(e) | Ok(a) => onOk(a) }
}

func liftResult[E Show, A](r Result[E, A]) IO[A] {
  match r { Err(e) => ioFail(show(e)) | Ok(a) => ioPure(a) }
}

func ioFailWith[E Show, A](e E) IO[A] {
  ioFail(show(e))
}

instance Show[List[A]] given Show[A] {
  show(xs) {
    match xs {
      Nil => "[]"
      Cons(x, rest) => "[" + fold(rest, show(x), func(acc, a) => acc + ", " + show(a)) + "]"
    }
  }
}

instance Show[(A, B)] given Show[A], Show[B] {
  show(p) {
    match p {
      (a, b) => "(" + show(a) + ", " + show(b) + ")"
    }
  }
}

extern func ioPure[A](a A) IO[A] = "gofx/rt".Pure
extern func ioBind[A, B](io IO[A], f func(A) IO[B]) IO[B] = "gofx/rt".Bind
extern func ioFail[A](msg String) IO[A] = "gofx/rt".Fail
extern func println(s String) IO[Unit] = "gofx/rt".Println
extern func showInt(n Int) String = "gofx/rt".ShowInt
extern func showBool(b Bool) String = "gofx/rt".ShowBool
extern func showString(s String) String = "gofx/rt".ShowString
extern func unit() Unit = "gofx/rt".UnitValue
extern func eqInt(a Int, b Int) Bool = "gofx/rt".EqInt
extern func ltInt(a Int, b Int) Bool = "gofx/rt".LtInt
extern func eqString(a String, b String) Bool = "gofx/rt".EqString
extern func ltString(a String, b String) Bool = "gofx/rt".LtString
extern func eqBool(a Bool, b Bool) Bool = "gofx/rt".EqBool
extern func minInt() Int = "gofx/rt".MinInt
extern func maxInt() Int = "gofx/rt".MaxInt
extern func abs(n Int) Int = "gofx/rt".AbsInt

extern func strLength(s String) Int = "gofx/rt".StrLength
extern func strConcat(xs List[String]) String = "gofx/rt".StrConcat
extern func join(sep String, xs List[String]) String = "gofx/rt".Join
extern func split(sep String, s String) List[String] = "gofx/rt".Split
extern func lines(s String) List[String] = "gofx/rt".Lines
extern func words(s String) List[String] = "gofx/rt".Words
extern func trim(s String) String = "gofx/rt".Trim
extern func toUpper(s String) String = "gofx/rt".ToUpper
extern func toLower(s String) String = "gofx/rt".ToLower
extern func startsWith(s String, prefix String) Bool = "gofx/rt".StartsWith
extern func endsWith(s String, suffix String) Bool = "gofx/rt".EndsWith
extern func contains(s String, sub String) Bool = "gofx/rt".Contains
extern func replace(s String, old String, new String) String = "gofx/rt".Replace
extern func substring(s String, start Int, end Int) String = "gofx/rt".Substring
extern func chars(s String) List[String] = "gofx/rt".Chars
extern func repeat(s String, n Int) String = "gofx/rt".Repeat
extern func parseInt(s String) Option[Int] = "gofx/rt".ParseInt
extern func showPadLeft(n Int, width Int) String = "gofx/rt".ShowPadLeft

extern func readLine() IO[Option[String]] = "gofx/rt".ReadLine
extern func readAll() IO[String] = "gofx/rt".ReadAll
extern func args() IO[List[String]] = "gofx/rt".Args
extern func exit[A](code Int) IO[A] = "gofx/rt".Exit
extern func getEnv(name String) IO[Option[String]] = "gofx/rt".GetEnv

extern func tryIO[A](io IO[A]) IO[Result[String, A]] = "gofx/rt".TryIO
extern func readFile(path String) IO[String] = "gofx/rt".ReadFile
extern func writeFile(path String, content String) IO[Unit] = "gofx/rt".WriteFile
extern func appendFile(path String, content String) IO[Unit] = "gofx/rt".AppendFile
extern func fileExists(path String) IO[Bool] = "gofx/rt".FileExists
extern func listDir(path String) IO[List[String]] = "gofx/rt".ListDir
extern func removeFile(path String) IO[Unit] = "gofx/rt".RemoveFile
extern func eprintln(s String) IO[Unit] = "gofx/rt".Eprintln
extern func print(s String) IO[Unit] = "gofx/rt".Print
extern func nowMillis() IO[Int] = "gofx/rt".NowMillis
extern func monotonicMillis() IO[Int] = "gofx/rt".MonotonicMillis
extern func formatTime(millis Int, layout String) String = "gofx/rt".FormatTime
extern func randomInt(lo Int, hi Int) IO[Int] = "gofx/rt".RandomInt
extern func sleep(millis Int) IO[Unit] = "gofx/rt".Sleep

instance Show[Int] {
  show(a) { showInt(a) }
}

instance Show[String] {
  show(a) { showString(a) }
}

instance Show[Bool] {
  show(a) { showBool(a) }
}

instance Eq[Int] {
  eq(a, b) { eqInt(a, b) }
}

instance Ord[Int] {
  compare(a, b) { if ltInt(a, b) { LT } else if eqInt(a, b) { EQ } else { GT } }
}

instance Eq[String] {
  eq(a, b) { eqString(a, b) }
}

instance Ord[String] {
  compare(a, b) { if ltString(a, b) { LT } else if eqString(a, b) { EQ } else { GT } }
}

instance Eq[Bool] {
  eq(a, b) { eqBool(a, b) }
}

instance Ord[Bool] {
  compare(a, b) { if eqBool(a, b) { EQ } else if a { GT } else { LT } }
}

instance Eq[Unit] {
  eq(a, b) { true }
}

instance Eq[(A, B)] given Eq[A], Eq[B] {
  eq(a, b) {
    match (a, b) { ((a1, a2), (b1, b2)) => eq(a1, b1) && eq(a2, b2) }
  }
}

instance Ord[(A, B)] given Ord[A], Ord[B] {
  compare(a, b) {
    match (a, b) {
      ((a1, a2), (b1, b2)) => match compare(a1, b1) {
        EQ => compare(a2, b2)
        order => order
      }
    }
  }
}

instance Functor[IO] {
  fmap(fa, f) { ioBind(fa, func(a) => ioPure(f(a))) }
}

instance Monad[IO] {
  pure(a) { ioPure(a) }
  bind(ma, f) { ioBind(ma, f) }
}

func map[F[_] Functor, A, B](fa F[A], f func(A) B) F[B] {
  fmap(fa, f)
}

func flatMap[M[_] Monad, A, B](ma M[A], f func(A) M[B]) M[B] {
  bind(ma, f)
}

func forEach[M[_] Monad, A](xs List[A], f func(A) M[Unit]) M[Unit] {
  match xs {
    Nil => pure(unit())
    Cons(x, rest) => bind(f(x), func(ignored) => forEach(rest, f))
  }
}

func mapM[M[_] Monad, A, B](xs List[A], f func(A) M[B]) M[List[B]] {
  match xs {
    Nil => pure(Nil)
    Cons(x, rest) => bind(f(x), func(y) => bind(mapM(rest, f), func(ys) => pure(Cons(y, ys))))
  }
}

func fold[A, B](xs List[A], init B, f func(B, A) B) B {
  match xs {
    Nil => init
    Cons(x, rest) => fold(rest, f(init, x), f)
  }
}

func length[A](xs List[A]) Int {
  fold(xs, 0, func(n, x) => n + 1)
}

func append[A](xs List[A], ys List[A]) List[A] {
  match xs {
    Nil => ys
    Cons(x, rest) => Cons(x, append(rest, ys))
  }
}

func filter[A](xs List[A], p func(A) Bool) List[A] {
  match xs {
    Nil => Nil
    Cons(x, rest) => if p(x) { Cons(x, filter(rest, p)) } else { filter(rest, p) }
  }
}

func reverse[A](xs List[A]) List[A] {
  fold(xs, Nil, func(acc, x) => Cons(x, acc))
}

func fst[A, B](p (A, B)) A {
  match p { (a, _) => a }
}

func snd[A, B](p (A, B)) B {
  match p { (_, b) => b }
}

func zip[A, B](xs List[A], ys List[B]) List[(A, B)] {
  match (xs, ys) {
    (Cons(x, restX), Cons(y, restY)) => Cons((x, y), zip(restX, restY))
    _ => Nil
  }
}

func head[A](xs List[A]) Option[A] {
  match xs {
    Nil => None
    Cons(x, _) => Some(x)
  }
}

func tail[A](xs List[A]) List[A] {
  match xs {
    Nil => Nil
    Cons(_, rest) => rest
  }
}

func take[A](n Int, xs List[A]) List[A] {
  if n <= 0 { Nil }
  else {
    match xs {
      Nil => Nil
      Cons(x, rest) => Cons(x, take(n - 1, rest))
    }
  }
}

func drop[A](n Int, xs List[A]) List[A] {
  if n <= 0 { xs }
  else {
    match xs {
      Nil => Nil
      Cons(_, rest) => drop(n - 1, rest)
    }
  }
}

func sum(xs List[Int]) Int {
  fold(xs, 0, func(acc, x) => acc + x)
}

func concatMap[A, B](xs List[A], f func(A) List[B]) List[B] {
  bind(xs, f)
}

func elem[A Eq](x A, xs List[A]) Bool {
  match xs {
    Nil => false
    Cons(y, rest) => eq(x, y) || elem(x, rest)
  }
}

func insertBy[A](x A, xs List[A], cmp func(A, A) Ordering) List[A] {
  match xs {
    Nil => Cons(x, Nil)
    Cons(y, rest) => match cmp(x, y) {
      GT => Cons(y, insertBy(x, rest, cmp))
      _ => Cons(x, xs)
    }
  }
}

func sortBy[A](xs List[A], cmp func(A, A) Ordering) List[A] {
  match xs {
    Nil => Nil
    Cons(x, rest) => insertBy(x, sortBy(rest, cmp), cmp)
  }
}

func sort[A Ord](xs List[A]) List[A] {
  sortBy(xs, compare)
}

func maximum[A Ord](xs List[A]) Option[A] {
  match xs {
    Nil => None
    Cons(x, rest) => Some(fold(rest, x, func(best, a) => match compare(a, best) {
      GT => a
      _ => best
    }))
  }
}

func minimum[A Ord](xs List[A]) Option[A] {
  match xs {
    Nil => None
    Cons(x, rest) => Some(fold(rest, x, func(best, a) => match compare(a, best) {
      LT => a
      _ => best
    }))
  }
}
