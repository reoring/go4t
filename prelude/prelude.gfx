package prelude

class Functor[F[_]] {
  fmap[A, B](fa F[A], f func(A) B) F[B]
}

class Monad[M[_]] : Functor[M] {
  pure[A](a A) M[A]
  bind[A, B](ma M[A], f func(A) M[B]) M[B]
}

class Show[A] {
  show(a A) String
}

type Option[A] = None | Some(A)

type List[A] = Nil | Cons(A, List[A])

type State[S, A] = State(func(S) (A, S))

instance Functor[Option] {
  fmap(fa, f) {
    match fa {
      None => None
      Some(a) => Some(f(a))
    }
  }
}

instance Monad[Option] {
  pure(a) { Some(a) }
  bind(ma, f) {
    match ma {
      None => None
      Some(a) => f(a)
    }
  }
}

instance Functor[List] {
  fmap(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => Cons(f(x), fmap(rest, f))
    }
  }
}

instance Monad[List] {
  pure(a) { Cons(a, Nil) }
  bind(xs, f) {
    match xs {
      Nil => Nil
      Cons(x, rest) => append(f(x), bind(rest, f))
    }
  }
}

instance Functor[State[S]] {
  fmap(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => (f(a), s2) })
  }
}

instance Monad[State[S]] {
  pure(a) { State(func(s) => (a, s)) }
  bind(st, f) {
    State(func(s) => match runState(st, s) { (a, s2) => runState(f(a), s2) })
  }
}

func runState[S, A](st State[S, A], s S) (A, S) {
  match st { State(run) => run(s) }
}

func evalState[S, A](st State[S, A], s S) A {
  fst(runState(st, s))
}

func execState[S, A](st State[S, A], s S) S {
  snd(runState(st, s))
}

func get[S]() State[S, S] {
  State(func(s) => (s, s))
}

func put[S](s S) State[S, Unit] {
  State(func(ignored) => (unit(), s))
}

func modify[S](f func(S) S) State[S, Unit] {
  State(func(s) => (unit(), f(s)))
}

instance Show[Option[A]] given Show[A] {
  show(o) {
    match o {
      None => "None"
      Some(a) => "Some(" + show(a) + ")"
    }
  }
}

instance Show[List[A]] given Show[A] {
  show(xs) {
    match xs {
      Nil => "[]"
      Cons(x, rest) => "[" + fold(rest, show(x), func(acc, a) => acc + ", " + show(a)) + "]"
    }
  }
}

instance Show[(A, B)] given Show[A], Show[B] {
  show(p) {
    match p {
      (a, b) => "(" + show(a) + ", " + show(b) + ")"
    }
  }
}

extern func ioPure[A](a A) IO[A] = "gofx/rt".Pure
extern func ioBind[A, B](io IO[A], f func(A) IO[B]) IO[B] = "gofx/rt".Bind
extern func ioFail[A](msg String) IO[A] = "gofx/rt".Fail
extern func println(s String) IO[Unit] = "gofx/rt".Println
extern func showInt(n Int) String = "gofx/rt".ShowInt
extern func showBool(b Bool) String = "gofx/rt".ShowBool
extern func showString(s String) String = "gofx/rt".ShowString
extern func unit() Unit = "gofx/rt".UnitValue

instance Show[Int] {
  show(a) { showInt(a) }
}

instance Show[String] {
  show(a) { showString(a) }
}

instance Show[Bool] {
  show(a) { showBool(a) }
}

instance Functor[IO] {
  fmap(fa, f) { ioBind(fa, func(a) => ioPure(f(a))) }
}

instance Monad[IO] {
  pure(a) { ioPure(a) }
  bind(ma, f) { ioBind(ma, f) }
}

func map[F[_] Functor, A, B](fa F[A], f func(A) B) F[B] {
  fmap(fa, f)
}

func flatMap[M[_] Monad, A, B](ma M[A], f func(A) M[B]) M[B] {
  bind(ma, f)
}

func forEach[M[_] Monad, A](xs List[A], f func(A) M[Unit]) M[Unit] {
  match xs {
    Nil => pure(unit())
    Cons(x, rest) => bind(f(x), func(ignored) => forEach(rest, f))
  }
}

func mapM[M[_] Monad, A, B](xs List[A], f func(A) M[B]) M[List[B]] {
  match xs {
    Nil => pure(Nil)
    Cons(x, rest) => bind(f(x), func(y) => bind(mapM(rest, f), func(ys) => pure(Cons(y, ys))))
  }
}

func fold[A, B](xs List[A], init B, f func(B, A) B) B {
  match xs {
    Nil => init
    Cons(x, rest) => fold(rest, f(init, x), f)
  }
}

func length[A](xs List[A]) Int {
  fold(xs, 0, func(n, x) => n + 1)
}

func append[A](xs List[A], ys List[A]) List[A] {
  match xs {
    Nil => ys
    Cons(x, rest) => Cons(x, append(rest, ys))
  }
}

func filter[A](xs List[A], p func(A) Bool) List[A] {
  match xs {
    Nil => Nil
    Cons(x, rest) => if p(x) { Cons(x, filter(rest, p)) } else { filter(rest, p) }
  }
}

func reverse[A](xs List[A]) List[A] {
  fold(xs, Nil, func(acc, x) => Cons(x, acc))
}

func fst[A, B](p (A, B)) A {
  match p { (a, _) => a }
}

func snd[A, B](p (A, B)) B {
  match p { (_, b) => b }
}

func zip[A, B](xs List[A], ys List[B]) List[(A, B)] {
  match (xs, ys) {
    (Cons(x, restX), Cons(y, restY)) => Cons((x, y), zip(restX, restY))
    _ => Nil
  }
}
