func testDifferentSubresourceTypeIsReturnedWithoutPersisting() IO[Bool] { do {
 fixture <- _fixtureDependencies()
 tracker <- newObjectTracker(fixture.0,fixture.1)
 tracker.create(_testResource(),_testPod("n","a"),"n",[])
 let other = core.configMapToRuntimeObject(core.configMapWithObjectMeta(core.newConfigMap(),meta.objectMetaWithNamespace(meta.objectMetaWithName(meta.newObjectMeta(),"a"),"n")))
 action <- sync.newRef(newCreateSubresourceActionWithOptions(_testResource(),"not-used","scale","n",other,meta.newCreateOptions()))
 reaction <- objectReaction(tracker)(action)
 returned <- _requireObject(reaction.result)
 stored <- tracker.get(_testResource(),"n","a",[])
 object <- _requireObject(stored)
 ioPure(native.sameObjectType(returned,other) && native.sameObjectType(object,_testPod("n","a")))
} }
func testWatchAbsenceDiffersFromEmptyOptions() IO[Bool] { do {
 fixture <- _fixtureDependencies()
 tracker <- newObjectTracker(fixture.0,fixture.1)
 tracker.create(_testResource(),_testPod("n","a"),"n",[])
 traditional <- tracker.watch(_testResource(),"n",[])
 latest <- tracker.watch(_testResource(),"n",[meta.newListOptions()])
 match (traditional.value,latest.value) {
  (Some(noReplay),Some(replay)) => do {
   watch.stop(noReplay)
   none <- watch.next(noReplay)
   added <- watch.next(replay)
   watch.stop(replay)
   ioPure((match none { None => true; Some(_) => false }) && (match added { Some(event) => event.eventType=="ADDED"; None => false }))
  }
  _ => ioPure(false)
 }
} }
