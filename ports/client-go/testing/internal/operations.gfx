extern func joinPath(parts List[String]) String = "github.com/reoring/gofx/ports/client-go/testing/host".JoinPath
extern func _parseLabels(value String) IO[(String,Option[errors.Error])] = "github.com/reoring/gofx/ports/client-go/testing/host".ParseLabels
extern func _parseFields(value String) IO[(String,Option[errors.Error])] = "github.com/reoring/gofx/ports/client-go/testing/host".ParseFields
extern func labelSelector(value String) IO[labels.Selector] = "github.com/reoring/gofx/ports/client-go/testing/host".LabelSelector
extern func fieldSelector(value String) IO[fields.Selector] = "github.com/reoring/gofx/ports/client-go/testing/host".FieldSelector
func _validSelector(raw String, parsed (String,Option[errors.Error])) IO[String] { match parsed.1 { None => ioPure(parsed.0); Some(error) => ioFail("invalid selector "+show(raw)+": "+errors.errorMessage(error)) } }
func validateSelectors(options meta.ListOptions) IO[Unit] { do { l <- _parseLabels(meta.listOptionsGetLabelSelector(options)); _validSelector(meta.listOptionsGetLabelSelector(options),l); f <- _parseFields(meta.listOptionsGetFieldSelector(options)); _validSelector(meta.listOptionsGetFieldSelector(options),f); ioPure(unit()) } }
func canonicalListOptions(options meta.ListOptions) IO[meta.ListOptions] { do { l <- _parseLabels(meta.listOptionsGetLabelSelector(options)); label <- _validSelector(meta.listOptionsGetLabelSelector(options),l); f <- _parseFields(meta.listOptionsGetFieldSelector(options)); field <- _validSelector(meta.listOptionsGetFieldSelector(options),f); ioPure(meta.listOptionsWithFieldSelector(meta.listOptionsWithLabelSelector(meta.newListOptions(),label),field)) } }
