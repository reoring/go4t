import native "testing/internal"
func newGetAction(resource schema.GroupVersionResource, namespace String, name String) Action { newGetActionWithOptions(resource,namespace,name,meta.newGetOptions()) }
func newRootGetActionWithOptions(resource schema.GroupVersionResource, name String, options meta.GetOptions) Action { newGetActionWithOptions(resource,"",name,options) }
func newRootGetAction(resource schema.GroupVersionResource, name String) Action { newRootGetActionWithOptions(resource,name,meta.newGetOptions()) }
func newGetSubresourceAction(resource schema.GroupVersionResource, namespace String, subresource String, name String) Action { newGetSubresourceActionWithOptions(resource,namespace,subresource,name,meta.newGetOptions()) }
func newRootGetSubresourceActionWithOptions(resource schema.GroupVersionResource, subresource String, name String, options meta.GetOptions) Action { newGetSubresourceActionWithOptions(resource,"",subresource,name,options) }
func newRootGetSubresourceAction(resource schema.GroupVersionResource, subresource String, name String) Action { newRootGetSubresourceActionWithOptions(resource,subresource,name,meta.newGetOptions()) }
