func newRootDeleteActionWithOptions(resource schema.GroupVersionResource, name String, options meta.DeleteOptions) Action { newDeleteActionWithOptions(resource,"",name,options) }
func newRootDeleteAction(resource schema.GroupVersionResource, name String) Action { newRootDeleteActionWithOptions(resource,name,meta.newDeleteOptions()) }
func newDeleteSubresourceAction(resource schema.GroupVersionResource, subresource String, namespace String, name String) Action { newDeleteSubresourceActionWithOptions(resource,subresource,namespace,name,meta.newDeleteOptions()) }
