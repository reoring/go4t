func newRootPatchSubresourceActionWithOptions(resource schema.GroupVersionResource, name String, patchType String, patch String, options meta.PatchOptions, subresources List[String]) Action { newPatchSubresourceActionWithOptions(resource,"",name,patchType,patch,options,subresources) }
func newRootPatchSubresourceAction(resource schema.GroupVersionResource, name String, patchType String, patch String, subresources List[String]) Action { newRootPatchSubresourceActionWithOptions(resource,name,patchType,patch,meta.newPatchOptions(),subresources) }
func newRootListActionWithOptions(resource schema.GroupVersionResource, kind schema.GroupVersionKind, options meta.ListOptions) IO[Action] { do { canonical <- native.canonicalListOptions(options); ioPure((newAction(ListAction,"list",resource,"")){listKind: kind,listOptions: canonical}) } }
func newListAction(resource schema.GroupVersionResource, kind schema.GroupVersionKind, namespace String, options meta.ListOptions) IO[Action] { do { canonical <- native.canonicalListOptions(options); ioPure((newAction(ListAction,"list",resource,namespace)){listKind: kind,listOptions: canonical}) } }
func newRootListAction(resource schema.GroupVersionResource, kind schema.GroupVersionKind, options meta.ListOptions) IO[Action] { newRootListActionWithOptions(resource,kind,options) }
func newWatchAction(resource schema.GroupVersionResource, namespace String, options meta.ListOptions) IO[Action] { newWatchActionWithOptions(resource,namespace,options) }
func newRootWatchActionWithOptions(resource schema.GroupVersionResource, options meta.ListOptions) IO[Action] { newWatchActionWithOptions(resource,"",options) }
func newRootWatchAction(resource schema.GroupVersionResource, options meta.ListOptions) IO[Action] { newRootWatchActionWithOptions(resource,options) }
func newDeleteCollectionAction(resource schema.GroupVersionResource, namespace String, options meta.ListOptions) IO[Action] { newDeleteCollectionActionWithOptions(resource,namespace,meta.newDeleteOptions(),options) }
func newRootDeleteCollectionActionWithOptions(resource schema.GroupVersionResource, options meta.DeleteOptions, listOptions meta.ListOptions) IO[Action] { newDeleteCollectionActionWithOptions(resource,"",options,listOptions) }
func newRootDeleteCollectionAction(resource schema.GroupVersionResource, options meta.ListOptions) IO[Action] { newRootDeleteCollectionActionWithOptions(resource,meta.newDeleteOptions(),options) }
