import objects "deps/objects"
import runtime "deps/k8s.io/apimachinery/pkg/runtime"
import apps "deps/k8s.io/api/apps/v1"
import core "deps/k8s.io/api/core/v1"
import meta "deps/k8s.io/apimachinery/pkg/apis/meta/v1"
import fixture "util/testing"
extern func decodeObject(template runtime.Object,data String) IO[runtime.Object] = "github.com/reoring/gofx/ports/client-go/examples/host".DecodeObject
func decode[A](descriptor objects.ObjectType[A],empty A,data String) IO[A] {
 do { object <- decodeObject(objects.toObject(descriptor,empty),data); match objects.fromObject(descriptor,Some(object)) { Some(value) => ioPure(value); None => ioFail("fixture decoder returned a different object type") } }
}
func deploymentJSON(replicas Int,image String) String {
 "{\"apiVersion\":\"apps/v1\",\"kind\":\"Deployment\",\"metadata\":{\"name\":\"demo-deployment\",\"namespace\":\"default\",\"resourceVersion\":\"17\"},\"spec\":{\"replicas\":"+show(replicas)+",\"selector\":{\"matchLabels\":{\"app\":\"demo\"}},\"template\":{\"metadata\":{\"labels\":{\"app\":\"demo\"}},\"spec\":{\"containers\":[{\"name\":\"web\",\"image\":"+quote(image)+",\"ports\":[{\"name\":\"http\",\"protocol\":\"TCP\",\"containerPort\":80}]}]}}}}"
}
func validateDeploymentRequest(request fixture.Request) IO[Unit] {
 if request.method=="POST" || request.method=="PUT" {
  do {
   value <- decode(apps.deploymentObjectType(),apps.newDeployment(),request.body)
   let updating = request.method=="PUT"
   let spec = apps.deploymentGetSpec(value)
   check(apps.deploymentSpecGetReplicas(spec)==Some(if updating { 1 } else { 2 }),"incorrect replicas in transmitted deployment")
   let containers = core.podSpecGetContainers(core.podTemplateSpecGetSpec(apps.deploymentSpecGetTemplate(spec)))
   check(match containers { Some(Cons(first,_)) => core.containerGetImage(first)==(if updating { "nginx:1.13" } else { "nginx:1.12" }); _ => false },"incorrect image in transmitted deployment")
   check(meta.objectMetaGetResourceVersion(apps.deploymentGetObjectMeta(value))=="17","deployment update did not preserve resource version")
  }
 } else if request.method=="DELETE" {
  do {
   options <- decode(meta.deleteOptionsObjectType(),meta.newDeleteOptions(),request.body)
   check(match meta.deleteOptionsGetPropagationPolicy(options) { Some(value) => meta.deletionPropagationValue(value)=="Foreground"; None => false },"delete did not send foreground propagation")
  }
 } else { ioPure(unit()) }
}
