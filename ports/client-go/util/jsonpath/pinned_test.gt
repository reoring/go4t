package jsonpath

import "std/prelude"
import "std/list"
import "std/result"
import "std/dyn"
import "std/map"
import "std/string"
import "github.com/reoring/gofx/ports/client-go/third_party/forked/golang/template"

type FixtureHost = FixtureRecord(List[Field[FixtureHost]]) | FixtureMap(List[(String,Value[FixtureHost])]) | FixtureSequence(List[Value[FixtureHost]])
func fixtureView(h FixtureHost) Shape[FixtureHost] {
  match h { FixtureRecord(fs) => RecordShape("fixture",fs) FixtureMap(xs) => MappingShape("map[string]int","string",true,xs) FixtureSequence(xs) => SequenceShape("[]fixture",xs) }
}
func fixtureRender(h FixtureHost,mode RenderMode) Result[String,String] {
  match h {
    FixtureRecord(fs) => renderShape(fixtureInspection(),MappingShape("fixture","string",true,prelude.fmap(fs,func(f) => (if f.jsonName == "" { f.name } else { f.jsonName },f.value))),mode,0)
    _ => renderShape(fixtureInspection(),fixtureView(h),mode,0)
  }
}
func fixtureInspection() Inspection[FixtureHost] { Inspection(fixtureView,fixtureRender) }
func fixtureCase(name String,expression String,input Value[FixtureHost],expected String,error Bool,missing Bool,exactError Bool) Bool {
  let j = allowMissingKeys(new(name),missing)
  match jsonPathParse(j,expression) {
    Err(_) => error
    Ok(path) => match execute(fixtureInspection(),path,input) {
      Err(e) => if exactError { e == expected } else { error }
      Ok(text) => !error && !exactError && (if name == "recursive name" { list.sort(string.words(text)) == list.sort(string.words(expected)) } else { text == expected })
    }
  }
}
