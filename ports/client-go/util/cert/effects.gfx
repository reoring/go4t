extern func _signCertificate(subject String, org List[String], dns List[String], ips List[net.IP], before Int, after Int, isCA Bool, serial Int, key crypto.PrivateKey, parent Option[x509.Certificate], parentKey crypto.PrivateKey, keyUsage x509.KeyUsage, extKeyUsage List[x509.ExtKeyUsage], basicConstraintsValid Bool) IO[(Option[x509.Certificate], Option[support.Error])] = "github.com/reoring/gofx/ports/client-go/util/cert/host".SignCertificate
// Pinned util/cert/cert.go: CA usages are 1|4|32; serving usages are 1|4
// with ServerAuth (1). These choices belong to native policy, not the signer.
func signCertificate(subject String, org List[String], dns List[String], ips List[net.IP], before Int, after Int, isCA Bool, serial Int, key crypto.PrivateKey, parent Option[x509.Certificate], parentKey crypto.PrivateKey) IO[(Option[x509.Certificate], Option[support.Error])] {
 let usages = x509.keyUsageFromValue(if isCA { 37 } else { 5 })
 let extended = if isCA { [] } else { [x509.extKeyUsageFromValue(1)] }
 _signCertificate(subject, org, dns, ips, before, after, isCA, serial, key, parent, parentKey, usages, extended, true)
}
