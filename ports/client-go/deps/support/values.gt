package support

// These handles are structural bridges, not replacements for named Go types.
type UInt64 = UInt64Handle
type ForeignMap[K, V] = ForeignMapHandle
type PointerKey[A] = PointerKeyHandle
type Channel[A] = ChannelHandle
type Any = AnyHandle
type Error = ErrorHandle

extern func uint64(high Int, low Int) UInt64 = "github.com/reoring/gofx/ports/client-go/host/deps".UInt64
extern func uint64High(value UInt64) Int = "github.com/reoring/gofx/ports/client-go/host/deps".UInt64High
extern func uint64Low(value UInt64) Int = "github.com/reoring/gofx/ports/client-go/host/deps".UInt64Low
extern func mapIsNil[K,V](value ForeignMap[K,V]) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".IsNil
extern func mapEmpty[K,V](prototype ForeignMap[K,V]) ForeignMap[K,V] = "github.com/reoring/gofx/ports/client-go/host/deps".MapEmpty
extern func mapLookup[K,V](value ForeignMap[K,V], key K) Option[V] = "github.com/reoring/gofx/ports/client-go/host/deps".MapLookup
extern func mapEntries[K,V](value ForeignMap[K,V]) List[(K,V)] = "github.com/reoring/gofx/ports/client-go/host/deps".MapEntries
extern func mapWith[K,V](value ForeignMap[K,V], key K, entry V) ForeignMap[K,V] = "github.com/reoring/gofx/ports/client-go/host/deps".MapWith
extern func mapWithout[K,V](value ForeignMap[K,V], key K) ForeignMap[K,V] = "github.com/reoring/gofx/ports/client-go/host/deps".MapWithout
extern func mapNewPointerKey[A,V](prototype ForeignMap[PointerKey[A],V], value A) IO[PointerKey[A]] = "github.com/reoring/gofx/ports/client-go/host/deps".MapNewPointerKey
extern func mapNilPointerKey[A,V](prototype ForeignMap[PointerKey[A],V]) PointerKey[A] = "github.com/reoring/gofx/ports/client-go/host/deps".MapNilPointerKey
extern func pointerKeyValue[A](key PointerKey[A]) Option[A] = "github.com/reoring/gofx/ports/client-go/host/deps".PointerKeyValue
extern func pointerKeyEqual[A](left PointerKey[A], right PointerKey[A]) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".PointerKeyEqual
extern func channelReceive[A](value Channel[A]) IO[Option[A]] = "github.com/reoring/gofx/ports/client-go/host/deps".ChannelReceive
extern func channelSend[A](value Channel[A], item A) IO[Unit] = "github.com/reoring/gofx/ports/client-go/host/deps".ChannelSend
extern func channelClose[A](value Channel[A]) IO[Unit] = "github.com/reoring/gofx/ports/client-go/host/deps".ChannelClose
extern func errorMessage(value Error) String = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorMessage
extern func errorIs(value Error, target Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIs
extern func errorIsNotFound(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsNotFound
extern func errorIsAlreadyExists(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsAlreadyExists
extern func errorNotFound(group String, resource String, name String) Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorNotFound
extern func errorIsConflict(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsConflict
extern func errorIsStrictDecoding(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsStrictDecoding
extern func errorIsNotRegistered(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsNotRegistered
extern func waitTimeoutError() Error = "github.com/reoring/gofx/ports/client-go/host/deps".WaitTimeoutError
extern func errorInterrupted(cause Option[Error]) Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorInterrupted
extern func errorIsInterrupted(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsInterrupted
extern func errorConflict(group String, resource String, name String, cause Option[Error]) Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorConflict
extern func errorCancelled() Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorCancelled
extern func raiseError[A](error Error) IO[A] = "github.com/reoring/gofx/ports/client-go/host/deps".RaiseError
extern func errorNew(message String) Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorNew
extern func errorTagged(domain String, key String, message String) Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorTagged
extern func errorWrap(message String, cause Error) Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorWrap
extern func errorIsResourceExpired(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsResourceExpired
extern func errorIsTimeout(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsTimeout
extern func errorIsTooManyRequests(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsTooManyRequests
extern func errorIsInternal(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsInternal
extern func errorIsConnectionRefused(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsConnectionRefused
extern func randomInt(bound Int) IO[Int] = "github.com/reoring/gofx/ports/client-go/host/deps".RandomInt
extern func errorInternal(cause Error) Error = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorInternal
extern func errorIsForbidden(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsForbidden
extern func errorIsUnauthorized(value Error) Bool = "github.com/reoring/gofx/ports/client-go/host/deps".ErrorIsUnauthorized
