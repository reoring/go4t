type CoreV1Interface = CoreV1Interface { restClient:Option[rest.Interface], componentStatuses:func() ComponentStatusInterface, configMaps:func(String) ConfigMapInterface, endpoints:func(String) EndpointsInterface, events:func(String) EventInterface, limitRanges:func(String) LimitRangeInterface, namespaces:func() NamespaceInterface, nodes:func() NodeInterface, persistentVolumes:func() PersistentVolumeInterface, persistentVolumeClaims:func(String) PersistentVolumeClaimInterface, pods:func(String) PodInterface, podTemplates:func(String) PodTemplateInterface, replicationControllers:func(String) ReplicationControllerInterface, resourceQuotas:func(String) ResourceQuotaInterface, secrets:func(String) SecretInterface, services:func(String) ServiceInterface, serviceAccounts:func(String) ServiceAccountInterface }

func newClient(environment rest.Environment,registry scheme.Registry,restClient rest.Interface) CoreV1Interface { CoreV1Interface { restClient:Some(restClient), componentStatuses:func() => newComponentStatuses(restClient,registry.parameterCodec,environment.features),configMaps:func(namespace) => newConfigMaps(restClient,registry.parameterCodec,environment.features,namespace),endpoints:func(namespace) => newEndpoints(restClient,registry.parameterCodec,environment.features,namespace),events:func(namespace) => newEvents(restClient,registry.parameterCodec,environment.features,namespace),limitRanges:func(namespace) => newLimitRanges(restClient,registry.parameterCodec,environment.features,namespace),namespaces:func() => newNamespaces(restClient,registry.parameterCodec,environment.features),nodes:func() => newNodes(restClient,registry.parameterCodec,environment.features),persistentVolumes:func() => newPersistentVolumes(restClient,registry.parameterCodec,environment.features),persistentVolumeClaims:func(namespace) => newPersistentVolumeClaims(restClient,registry.parameterCodec,environment.features,namespace),pods:func(namespace) => newPods(restClient,registry.parameterCodec,environment.features,namespace),podTemplates:func(namespace) => newPodTemplates(restClient,registry.parameterCodec,environment.features,namespace),replicationControllers:func(namespace) => newReplicationControllers(restClient,registry.parameterCodec,environment.features,namespace),resourceQuotas:func(namespace) => newResourceQuotas(restClient,registry.parameterCodec,environment.features,namespace),secrets:func(namespace) => newSecrets(restClient,registry.parameterCodec,environment.features,namespace),services:func(namespace) => newServices(restClient,registry.parameterCodec,environment.features,namespace),serviceAccounts:func(namespace) => newServiceAccounts(restClient,registry.parameterCodec,environment.features,namespace) } }

func setConfigDefaults(config rest.Config,registry scheme.Registry) rest.Config {
 let content = config.contentConfig{groupVersion:Some(schema.groupVersionWithVersion(schema.groupVersionWithGroup(schema.newGroupVersion(),""),"v1")),negotiatedSerializer:Some(registry.negotiatedSerializer)}
 rest.setKubernetesDefaults(config{apiPath:"/api",contentConfig:content})
}

func newForConfigAndClientWithRegistry(environment rest.Environment,registry scheme.Registry,config rest.Config,httpClient rest.HTTPClient) IO[outcome.Outcome[Option[CoreV1Interface]]] { do {
 result <- rest.restClientForConfigAndClient(environment,setConfigDefaults(config,registry),httpClient)
 ioPure(outcome.from(match result.value { None => None; Some(client) => Some(newClient(environment,registry,rest.clientInterface(client))) },result.error))
} }

func newForConfigAndClient(environment rest.Environment,config rest.Config,httpClient rest.HTTPClient) IO[outcome.Outcome[Option[CoreV1Interface]]] { do {
 registry <- scheme.newClientRegistry(environment.features)
 newForConfigAndClientWithRegistry(environment,registry,config,httpClient)
} }

func newForConfig(environment rest.Environment,config rest.Config) IO[outcome.Outcome[Option[CoreV1Interface]]] { do {
 registry <- scheme.newClientRegistry(environment.features)
 let config = setConfigDefaults(config,registry)
 http <- rest.httpClientFor(environment,config)
 match http.value { None => ioPure(outcome.from(None,http.error)); Some(client) => newForConfigAndClientWithRegistry(environment,registry,config,client) }
} }

func newForConfigOrDie(environment rest.Environment,config rest.Config) IO[CoreV1Interface] { do {
 result <- newForConfig(environment,config)
 match result.value { Some(client) => ioPure(client); None => ioFail(match result.error { Some(error) => errors.errorMessage(error); None => "client construction returned no client" }) }
} }
