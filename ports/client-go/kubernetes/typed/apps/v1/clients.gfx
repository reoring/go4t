func setConfigDefaults(config rest.Config,registry scheme.Registry) rest.Config {
 let content = config.contentConfig{groupVersion:Some(schema.groupVersionWithVersion(schema.groupVersionWithGroup(schema.newGroupVersion(),"apps"),"v1")),negotiatedSerializer:Some(registry.negotiatedSerializer)}
 rest.setKubernetesDefaults(config{apiPath:"/apis",contentConfig:content})
}

func newForConfigAndClientWithRegistry(environment rest.Environment,registry scheme.Registry,config rest.Config,httpClient rest.HTTPClient) IO[outcome.Outcome[Option[AppsV1Interface]]] { do {
 result <- rest.restClientForConfigAndClient(environment,setConfigDefaults(config,registry),httpClient)
 ioPure(outcome.from(match result.value { None => None; Some(client) => Some(newClient(environment,registry,rest.clientInterface(client))) },result.error))
} }

func newForConfigAndClient(environment rest.Environment,config rest.Config,httpClient rest.HTTPClient) IO[outcome.Outcome[Option[AppsV1Interface]]] { do {
 registry <- scheme.newClientRegistry(environment.features)
 newForConfigAndClientWithRegistry(environment,registry,config,httpClient)
} }

func newForConfig(environment rest.Environment,config rest.Config) IO[outcome.Outcome[Option[AppsV1Interface]]] { do {
 registry <- scheme.newClientRegistry(environment.features)
 let config = setConfigDefaults(config,registry)
 http <- rest.httpClientFor(environment,config)
 match http.value { None => ioPure(outcome.from(None,http.error)); Some(client) => newForConfigAndClientWithRegistry(environment,registry,config,client) }
} }

func newForConfigOrDie(environment rest.Environment,config rest.Config) IO[AppsV1Interface] { do {
 result <- newForConfig(environment,config)
 match result.value { Some(client) => ioPure(client); None => ioFail(match result.error { Some(error) => errors.errorMessage(error); None => "client construction returned no client" }) }
} }
