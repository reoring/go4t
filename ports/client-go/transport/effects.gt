extern func newError(message String) errors.Error = "github.com/reoring/gofx/ports/client-go/transport/host".NewError
extern func wrapError(message String, error errors.Error) errors.Error = "github.com/reoring/gofx/ports/client-go/transport/host".WrapError
extern func readFile(path String) IO[(Option[String], Option[errors.Error])] = "github.com/reoring/gofx/ports/client-go/transport/host".ReadFile
extern func cloneRequest(request http.Request) IO[http.Request] = "github.com/reoring/gofx/ports/client-go/transport/host".CloneRequest
extern func requestHeader(request http.Request, name String) IO[String] = "github.com/reoring/gofx/ports/client-go/transport/host".RequestHeader
extern func requestHeaders(request http.Request) IO[List[(String, List[String])]] = "github.com/reoring/gofx/ports/client-go/transport/host".RequestHeaders
extern func setRequestHeader(request http.Request, name String, value String) IO[Unit] = "github.com/reoring/gofx/ports/client-go/transport/host".SetRequestHeader
