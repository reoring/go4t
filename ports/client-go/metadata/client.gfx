  result <- rest.doRequest(r)
  decoded <- rest.resultGet(result)
  match decoded.error {
   Some(e) => if c.client.isNotRegistered(e) { do {
    let raw = rest.resultRaw(result)
    match raw.error { Some(e) => ioPure(outcome.failure(None,e)); None => do {
     fallback <- c.client.fallbackList(raw.value)
     ioPure(match fallback.error { Some(e) => outcome.failure(None,errors.errorWrap("unable to decode returned object as PartialObjectMetadataList",e)); None => outcome.success(Some(v1.partialObjectMetadataListWithTypeMeta(fallback.value,v1.newTypeMeta()))) })
    } }
   } } else { ioPure(outcome.failure(None,e)) }
   None => match decoded.value {
