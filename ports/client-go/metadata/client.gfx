func delete(c ResourceClient,name String,options v1.DeleteOptions,sub List[String]) IO[outcome.Outcome[Unit]] {
 if name == "" { ioPure(outcome.failure(unit(),errors.errorNew("name is required"))) } else { deleteRequest(c,name,options,sub,None) }
}
func deleteCollection(c ResourceClient,options v1.DeleteOptions,listOptions v1.ListOptions) IO[outcome.Outcome[Unit]] { deleteRequest(c,"",options,[],Some(listOptions)) }
func deleteRequest(c ResourceClient,name String,options v1.DeleteOptions,sub List[String],listOptions Option[v1.ListOptions]) IO[outcome.Outcome[Unit]] {
