func accept(list Bool) String {
 let kind = if list { "PartialObjectMetadataList" } else { "PartialObjectMetadata" }
 "application/vnd.kubernetes.protobuf;as="+kind+";g=meta.k8s.io;v=v1,application/json;as="+kind+";g=meta.k8s.io;v=v1,application/json"
}
func request(c ResourceClient,verb String,name String,sub List[String],options runtime.Object,list Bool) IO[rest.Request] {
 do {
  base <- c.client.rest.verb(verb)
