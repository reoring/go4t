func watch(c ResourceClient,options v1.ListOptions) IO[outcome.Outcome[Option[watch.Watch]]] {
 do {
  r <- request(c,"GET","",[],v1.listOptionsToRuntimeObject(v1.listOptionsWithWatch(options,true)),false)
  let duration = match v1.listOptionsGetTimeoutSeconds(options) { None => 0; Some(seconds) => seconds*1000000000 }
  rest.watch(rest.timeout(r,duration))
 }
}
func patch(c ResourceClient,name String,patchType String,data String,options v1.PatchOptions,sub List[String]) IO[outcome.Outcome[Option[v1.PartialObjectMetadata]]] {
 if name == "" { ioPure(outcome.failure(None,errors.errorNew("name is required"))) } else { do {
  base <- c.client.rest.patch(patchType)
  r <- rest.specificallyVersionedParams(rest.setHeader(rest.bodyBytes(rest.absPath(base,append(dynamic.makeURLSegments(c.gvr,c.namespace,name),sub)),data),"Accept",[accept(false)]),v1.patchOptionsToRuntimeObject(options),c.client.parameters,dynamic.versionV1())
  result <- rest.doRequest(r)
