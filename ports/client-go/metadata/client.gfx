 }
}
func isLikelyObjectMetadata(value v1.PartialObjectMetadata) IO[Bool] {
 let meta = v1.partialObjectMetadataGetObjectMeta(value)
 do {
  time <- v1.timeCallIsZero(v1.objectMetaGetCreationTimestamp(meta))
  ioPure(v1.objectMetaGetName(meta) != "" || v1.objectMetaGetGenerateName(meta) != "" || !time.1 || types.uidValue(v1.objectMetaGetUID(meta)) != "")
 }
}
func decodeObject(c ResourceClient,result rest.ResponseResult,patch Bool) IO[outcome.Outcome[Option[v1.PartialObjectMetadata]]] {
 do {
  decoded <- rest.resultGet(result)
  match decoded.error {
   Some(e) => if c.client.isNotRegistered(e) { do {
    let raw = rest.resultRaw(result)
    match raw.error { Some(e) => ioPure(outcome.failure(None,e)); None => do {
     fallback <- c.client.fallbackObject(raw.value)
     match fallback.error { Some(e) => ioPure(outcome.failure(None,errors.errorWrap("unable to decode returned object as PartialObjectMetadata",e))); None => do {
      likely <- isLikelyObjectMetadata(fallback.value)
      if likely { ioPure(outcome.success(Some(v1.partialObjectMetadataWithTypeMeta(fallback.value,v1.newTypeMeta())))) }
      else if patch { ioPure(outcome.failure(None,errors.errorNew("object does not appear to match the ObjectMeta schema"))) }
      else { do { description <- c.client.objectDescription(fallback.value); ioPure(outcome.failure(None,errors.errorNew("object does not appear to match the ObjectMeta schema: "+description))) } }
     } }
    } }
   } } else { ioPure(outcome.failure(None,e)) }
   None => match decoded.value {
    Some(object) => match v1.partialObjectMetadataFromRuntimeObject(object) { Some(value) => ioPure(outcome.success(Some(value))); None => unexpectedObject(c,decoded.value) }
    None => unexpectedObject(c,None)
   }
  }
 }
}
func unexpectedObject(c ResourceClient,object Option[runtime.Object]) IO[outcome.Outcome[Option[v1.PartialObjectMetadata]]] {
 do { kind <- c.client.objectTypeName(object); ioPure(outcome.failure(None,errors.errorNew("unexpected object, expected PartialObjectMetadata but got "+kind))) }
}
func get(c ResourceClient,name String,options v1.GetOptions,sub List[String]) IO[outcome.Outcome[Option[v1.PartialObjectMetadata]]] {
 if name == "" { ioPure(outcome.failure(None,errors.errorNew("name is required"))) } else { do { r <- request(c,"GET",name,sub,v1.getOptionsToRuntimeObject(options),false); result <- rest.doRequest(r); decodeObject(c,result,false) } }
}
