func testCertificateAndTokenRotateIndependently() IO[Bool] {do {
 clock <- sync.fakeClock(0);calls <- sync.newRef(0);cache <- newCache();rotations <- sync.newRef(0);expirations <- sync.newRef(None)
 let reply = "{\"apiVersion\":\"client.authentication.k8s.io/v1\",\"kind\":\"ExecCredential\",\"status\":{\"token\":\"fixture-token\",\"clientCertificateData\":"+fx.quote(_fixtureCertificate())+",\"clientKeyData\":"+fx.quote(_fixtureKey())+"}}"
 let base = _testEnvironment(clock,calls,reply)
 let metrics = Metrics(func(code,category) => ioPure(unit()),func(policy) => ioPure(unit()),func(age) => do {n <- sync.readRef(rotations);sync.writeRef(rotations,n+1)},func(expiration) => sync.writeRef(expirations,expiration))
 let environment = base{metrics:Some(metrics),run:func(command,env,interactive) => do {n <- sync.readRef(calls);sync.writeRef(calls,n+1);ioPure((if n < 2 {reply} else {_testWire("rotated-token","")},"",(0,None)))}}
 created <- getAuthenticator(cache,environment,_testConfig(),None);a <- _testAuthenticator(created);first <- getCreds(a)
 match first.value {None => ioPure(false);Some(c) => do {
  same <- maybeRefreshCreds(a,c);second <- getCreds(a);before <- sync.readRef(rotations)
  match second.value {None => ioPure(false);Some(d) => do {
   changed <- maybeRefreshCreds(a,d);last <- getCreds(a);after <- sync.readRef(rotations);expiry <- sync.readRef(expirations)
   ioPure(outcome.isSuccess(same) && outcome.isSuccess(changed) && before == 0 && after == 1 && (match (c.certificate,last.value,expiry) {(Some(_),Some(result),None) => result.token == "rotated-token" && (match result.certificate {None => true;Some(_) => false});_ => false}))
  }}
 }}
}}
func testExplicitTransportCredentialsBypassExec() IO[Bool] {do {
 clock <- sync.fakeClock(0);calls <- sync.newRef(0);cache <- newCache();created <- getAuthenticator(cache,_testEnvironment(clock,calls,"invalid"),_testConfig(),None);a <- _testAuthenticator(created)
 let base = transport.defaultConfig()
 token <- updateTransportConfig(a,base{bearerToken:"explicit"})
 basic <- updateTransportConfig(a,base{username:"user",password:"password"})
 cert <- updateTransportConfig(a,base{tls:base.tls{certData:Some("cert"),keyData:Some("key")}})
 count <- sync.readRef(calls)
 ioPure(outcome.isSuccess(token) && outcome.isSuccess(basic) && outcome.isSuccess(cert) && count == 0)
}}
