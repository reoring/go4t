package cache
import "std/map"
import lists "std/list"
import "github.com/reoring/gofx/ports/client-go/support/sync"
import "github.com/reoring/gofx/ports/client-go/support/outcome"

type TimestampedEntry[A] = TimestampedEntry { object: A, timestamp: sync.Instant, key: String }
type ExpirationPolicy[A] = ExpirationPolicy { isExpired: func(TimestampedEntry[A]) IO[Bool] }
type ExpirationCache[A] = ExpirationCache { storage: sync.Ref[Map[String,TimestampedEntry[A]]], mutex: sync.Mutex, clock: sync.Clock, policy: ExpirationPolicy[A], access: ObjectAccess[A], resourceVersion: sync.Ref[String], onExpire: func(String) IO[Unit] }
func ttlPolicy[A](clock sync.Clock, ttl Int) ExpirationPolicy[A] { ExpirationPolicy(func(entry) => do { current <- sync.now(clock); ioPure(ttl > 0 && sync.elapsed(entry.timestamp,current) > ttl) }) }
func newTTLStore[A](access ObjectAccess[A], ttl Int, clock sync.Clock) IO[Store[A]] { do { c <- newExpirationCache(access,ttlPolicy(clock,ttl),clock,func(_) => ioPure(unit())); ioPure(expirationStore(c)) } }
func newExpirationCache[A](access ObjectAccess[A], policy ExpirationPolicy[A], clock sync.Clock, onExpire func(String) IO[Unit]) IO[ExpirationCache[A]] { do { storage <- sync.newRef(map.emptyMap()); mutex <- sync.newMutex(); rv <- sync.newRef(""); ioPure(ExpirationCache(storage,mutex,clock,policy,access,rv,onExpire)) } }
func expirationGet[A](c ExpirationCache[A], key String) IO[outcome.Outcome[Option[A]]] { sync.withLock(c.mutex,do { entries <- sync.readRef(c.storage); match map.mapLookup(entries,key) { None => ioPure(outcome.success(None)); Some(entry) => do { expired <- c.policy.isExpired(entry); if expired { sync.uninterruptible(do { sync.writeRef(c.storage,map.mapDelete(entries,key)); c.onExpire(key); ioPure(outcome.success(None)) }) } else { ioPure(outcome.success(Some(entry.object))) } } } }) }
func expirationAdd[A](c ExpirationCache[A], object A) IO[outcome.Outcome[Unit]] { do { key <- c.access.key(object); match key.error { Some(e) => ioPure(outcome.failure(unit(),e)); None => sync.withLock(c.mutex,sync.uninterruptible(do { now <- sync.now(c.clock); entries <- sync.readRef(c.storage); sync.writeRef(c.storage,map.mapInsert(entries,key.value,TimestampedEntry(object,now,key.value))); ioPure(outcome.success(unit())) })) } } }
func expirationDelete[A](c ExpirationCache[A], object A) IO[outcome.Outcome[Unit]] { do { key <- c.access.key(object); rv <- c.access.resourceVersion(object); match key.error { Some(e) => ioPure(outcome.failure(unit(),e)); None => sync.withLock(c.mutex,sync.uninterruptible(do { entries <- sync.readRef(c.storage); sync.writeRef(c.storage,map.mapDelete(entries,key.value)); match rv { None => ioPure(unit()); Some(value) => sync.writeRef(c.resourceVersion,value) }; ioPure(outcome.success(unit())) })) } } }
func expirationKeys[A](c ExpirationCache[A]) IO[List[String]] { sync.withLock(c.mutex,do { entries <- sync.readRef(c.storage); ioPure(map.mapKeys(entries)) }) }
func expirationList[A](c ExpirationCache[A]) IO[List[A]] { do { keys <- expirationKeys(c); entries <- lists.mapM(keys,func(key) => expirationGet(c,key)); ioPure(fold(entries,Nil,func(acc,item) => match item.value { None => acc; Some(obj) => Cons(obj,acc) })) } }
func expirationReplace[A](c ExpirationCache[A], objects List[A], rv String) IO[outcome.Outcome[Unit]] { do { keyed <- keyedObjects(c.access,None,objects,map.emptyMap()); match keyed.error { Some(e) => ioPure(outcome.failure(unit(),e)); None => sync.withLock(c.mutex,sync.uninterruptible(do { now <- sync.now(c.clock); sync.writeRef(c.storage,map.mapFold(keyed.value,map.emptyMap(),func(acc,key,obj) => map.mapInsert(acc,key,TimestampedEntry(obj,now,key)))); sync.writeRef(c.resourceVersion,rv); ioPure(outcome.success(unit())) })) } } }
func expirationStore[A](c ExpirationCache[A]) Store[A] { Store(func(obj) => expirationAdd(c,obj),func(obj) => expirationAdd(c,obj),func(obj) => expirationDelete(c,obj),func() => expirationList(c),func() => expirationKeys(c),func(obj) => do { key <- c.access.key(obj); match key.error { Some(e) => ioPure(outcome.failure(None,e)); None => expirationGet(c,key.value) } },func(key) => expirationGet(c,key),func(objects,rv) => expirationReplace(c,objects,rv),func() => ioPure(outcome.success(unit())),func(rv) => sync.withLock(c.mutex,sync.writeRef(c.resourceVersion,rv)),func() => sync.withLock(c.mutex,sync.readRef(c.resourceVersion)),func(txns) => ioPure(Some(TransactionError(Nil,length(txns),[cacheError("transaction not supported")]))),None,func(key) => sync.withLock(c.mutex,sync.uninterruptible(do { entries <- sync.readRef(c.storage); sync.writeRef(c.storage,map.mapDelete(entries,key)); ioPure(outcome.success(unit())) }))) }
func newUndeltaStore[A](access ObjectAccess[A], push func(List[A]) IO[Unit]) IO[Store[A]] { do { store <- newStore(access); let change = func(action) => do { result <- action; if outcome.isSuccess(result) { do { objects <- store.list(); push(objects) } } else { ioPure(unit()) }; ioPure(result) }; ioPure(store { add: func(obj) => change(store.add(obj)), update: func(obj) => change(store.update(obj)), delete: func(obj) => change(store.delete(obj)), deleteByKey: func(key) => change(store.deleteByKey(key)), replace: func(objects,rv) => change(store.replace(objects,rv)) }) } }
