package cache
import "std/map"
import lists "std/list"
import strings "std/string"
import "github.com/reoring/gofx/ports/client-go/support/sync"
import "github.com/reoring/gofx/ports/client-go/support/outcome"
import errors "github.com/reoring/gofx/ports/client-go/deps/support"

type MutationEntry[A] = MutationEntry { object: A, tombstone: Bool, expires: sync.Instant, serial: Int, uid: String }
type MutationState[A] = MutationState { entries: Map[String,MutationEntry[A]], order: Map[Int,String], serial: Int }
alias ResourceVersionComparator[A] = func(A,A) IO[outcome.Outcome[Ordering]]
type MutationCache[A] = MutationCache { mutex: sync.Mutex, state: sync.Ref[MutationState[A]], backing: Store[A], indexer: Option[Indexer[A]], access: ObjectAccess[A], clock: sync.Clock, ttl: Int, capacity: Int, includeAdds: Bool, comparator: ResourceVersionComparator[A] }
func normalizedVersion(value String) outcome.Outcome[String] { let digits = if value == "" { "0" } else { value }; let normalized = stripVersionZeros(digits); if !fold(strings.chars(digits),true,func(ok,c) => ok && c >= "0" && c <= "9") || strings.strLength(normalized) > 20 || (strings.strLength(normalized) == 20 && normalized > "18446744073709551615") { outcome.failure("",cacheError("invalid unsigned resource version: " + show(value))) } else { outcome.success(normalized) } }
func stripVersionZeros(s String) String { if strings.strLength(s) > 1 && strings.startsWith(s,"0") { stripVersionZeros(strings.substring(s,1,strings.strLength(s))) } else { s } }
func compareResourceVersions(a String, b String) outcome.Outcome[Ordering] { let av = normalizedVersion(a); let bv = normalizedVersion(b); match av.error { Some(e) => outcome.failure(EQ,e); None => match bv.error { Some(e) => outcome.failure(EQ,e); None => outcome.success(if strings.strLength(av.value) == strings.strLength(bv.value) { compare(av.value,bv.value) } else { compare(strings.strLength(av.value),strings.strLength(bv.value)) }) } } }
func compareIntegerResourceVersion[A](access ObjectAccess[A], a A, b A) IO[outcome.Outcome[Ordering]] { do { av <- access.resourceVersion(a); bv <- access.resourceVersion(b); ioPure(compareResourceVersions(optionVersion(av),optionVersion(bv))) } }
func optionVersion(value Option[String]) String { match value { None => ""; Some(rv) => rv } }
func newIntegerResourceVersionMutationCache[A](backing Store[A], indexer Option[Indexer[A]], access ObjectAccess[A], clock sync.Clock, ttl Int, includeAdds Bool, capacity Int) IO[MutationCache[A]] { newMutationCache(backing,indexer,access,clock,ttl,includeAdds,capacity,func(a,b) => compareIntegerResourceVersion(access,a,b)) }
func newMutationCache[A](backing Store[A], indexer Option[Indexer[A]], access ObjectAccess[A], clock sync.Clock, ttl Int, includeAdds Bool, capacity Int, comparator ResourceVersionComparator[A]) IO[MutationCache[A]] { do { mutex <- sync.newMutex(); state <- sync.newRef(MutationState(map.emptyMap(),map.emptyMap(),0)); ioPure(MutationCache(mutex,state,backing,indexer,access,clock,if ttl == 0 { 300000000000 } else { ttl },if capacity == 0 { 100 } else { capacity },includeAdds,comparator)) } }
func mutationRemove[A](s MutationState[A], key String) MutationState[A] { match map.mapLookup(s.entries,key) { None => s; Some(entry) => s { entries: map.mapDelete(s.entries,key), order: map.mapDelete(s.order,entry.serial) } } }
func mutationLookup[A](c MutationCache[A], key String) IO[Option[MutationEntry[A]]] { do { s <- sync.readRef(c.state); now <- sync.now(c.clock); match map.mapLookup(s.entries,key) { None => ioPure(None); Some(entry) => if sync.compareInstant(now,entry.expires) == GT { do { sync.writeRef(c.state,mutationRemove(s,key)); ioPure(None) } } else { do { let next = entry { serial: s.serial+1 }; sync.writeRef(c.state,s { entries: map.mapInsert(s.entries,key,next), order: map.mapInsert(map.mapDelete(s.order,entry.serial),next.serial,key), serial: next.serial }); ioPure(Some(next)) } } } } }
func mutationInsert[A](c MutationCache[A], key String, object A, tombstone Bool, uid String) IO[Unit] { do { s <- sync.readRef(c.state); now <- sync.now(c.clock); let removed = mutationRemove(s,key); let serial = s.serial+1; let next = removed { entries: map.mapInsert(removed.entries,key,MutationEntry(object,tombstone,sync.add(now,c.ttl),serial,uid)), order: map.mapInsert(removed.order,serial,key), serial: serial }; let bounded = if map.mapSize(next.entries) > c.capacity { match map.mapToList(next.order) { Nil => next; Cons((_,oldest),_) => mutationRemove(next,oldest) } } else { next }; sync.writeRef(c.state,bounded) } }
func mutation[A](c MutationCache[A], object A) IO[Unit] { do { key <- c.access.key(object); uid <- c.access.uid(object); match key.error { Some(_) => ioPure(unit()); None => sync.withLock(c.mutex,sync.uninterruptible(do { previous <- mutationLookup(c,key.value); decision <- match previous { None => ioPure(outcome.success(true)); Some(old) => do { compared <- c.comparator(object,old.object); ioPure(outcome.mapValue(compared,func(order) => order != LT && !(old.tombstone && (order == EQ || old.uid == uid)))) } }; match decision.error { Some(e) => errors.raiseError(e); None => if decision.value { mutationInsert(c,key.value,object,false,uid) } else { ioPure(unit()) } } })) } } }
func mutationNewer[A](c MutationCache[A], key String, backing A) IO[A] { do { previous <- mutationLookup(c,key); match previous { None => ioPure(backing); Some(old) => do { compared <- c.comparator(backing,old.object); match compared.error { Some(e) => errors.raiseError(e); None => if compared.value != LT || old.tombstone { do { s <- sync.readRef(c.state); sync.writeRef(c.state,mutationRemove(s,key)); ioPure(backing) } } else { ioPure(old.object) } } } } } }
func mutationGetByKey[A](c MutationCache[A], key String) IO[outcome.Outcome[Option[A]]] { sync.withLock(c.mutex,sync.uninterruptible(do { backing <- c.backing.getByKey(key); match backing.error { Some(_) => ioPure(backing); None => match backing.value { Some(obj) => do { newer <- mutationNewer(c,key,obj); ioPure(outcome.success(Some(newer))) }; None => if !c.includeAdds { ioPure(backing) } else { do { entry <- mutationLookup(c,key); ioPure(outcome.success(match entry { None => None; Some(e) => if e.tombstone { None } else { Some(e.object) } })) } } } } })) }
func mutationOnAddOrUpdate[A](c MutationCache[A], object A) IO[Unit] { do { key <- c.access.key(object); match key.error { Some(_) => ioPure(unit()); None => sync.withLock(c.mutex,sync.uninterruptible(do { _ <- mutationNewer(c,key.value,object); ioPure(unit()) })) } } }
func mutationOnDelete[A](c MutationCache[A], object A) IO[Unit] { do { key <- c.access.key(object); uid <- c.access.uid(object); match key.error { Some(_) => ioPure(unit()); None => sync.withLock(c.mutex,sync.uninterruptible(do { old <- mutationLookup(c,key.value); decision <- match old { None => ioPure(outcome.success(true)); Some(entry) => do { compared <- c.comparator(object,entry.object); ioPure(outcome.mapValue(compared,func(order) => order != LT || uid == entry.uid)) } }; match decision.error { Some(e) => errors.raiseError(e); None => if decision.value { mutationInsert(c,key.value,object,true,uid) } else { ioPure(unit()) } } })) } } }
func mutationByIndex[A](c MutationCache[A], name String, value String) IO[outcome.Outcome[List[A]]] { match c.indexer { None => ioPure(outcome.failure(Nil,cacheError("no indexer has been provided to the mutation cache"))); Some(indexer) => sync.withLock(c.mutex,sync.uninterruptible(do {
 keys <- indexer.indexKeys(name,value)
 match keys.error { Some(e) => ioPure(outcome.failure(Nil,e)); None => do {
  objects <- lists.mapM(keys.value,func(key) => do { obj <- indexer.store.getByKey(key); match obj.value { None => ioPure(None); Some(item) => do { newer <- mutationNewer(c,key,item); ioPure(Some(newer)) } } })
  let found = fold(objects,Nil,func(acc,item) => match item { None => acc; Some(obj) => Cons(obj,acc) })
  if !c.includeAdds { ioPure(outcome.success(found)) } else { do {
   state <- sync.readRef(c.state)
   indexers <- indexer.getIndexers()
   let seen = fold(keys.value,map.emptyMap(),func(acc,k) => map.mapInsert(acc,k,unit()))
   extra <- lists.mapM(map.mapValues(state.order),func(key) => if map.mapMember(seen,key) { ioPure(None) } else { do { entry <- mutationLookup(c,key); match (entry,map.mapLookup(indexers,name)) { (Some(e),Some(f)) => if e.tombstone { ioPure(None) } else { do { values <- f(e.object); ioPure(if outcome.isSuccess(values) && lists.any(values.value,func(v) => v == value) { Some(e.object) } else { None }) } }; _ => ioPure(None) } } })
   ioPure(outcome.success(append(found,fold(extra,Nil,func(acc,item) => match item { None => acc; Some(obj) => Cons(obj,acc) }))))
  } }
 } }
 })) } }
