package cache
import lists "std/list"
import "github.com/reoring/gofx/ports/client-go/support/sync"
import errors "github.com/reoring/gofx/ports/client-go/deps/support"

type ComparedObject[A] = ComparedObject { cached: A, copied: A }
type DetectorState[A] = DetectorState { added: List[ComparedObject[A]], cached: List[ComparedObject[A]], retained: List[ComparedObject[A]], lastRotated: Option[sync.Instant] }
type MutationDetector[A] = MutationDetector { name: String, enabled: Bool, mutex: sync.Mutex, compareMutex: sync.Mutex, state: sync.Ref[DetectorState[A]], access: ObjectAccess[A], clock: sync.Clock, period: Int, retainDuration: Int, failure: func(String) IO[Unit] }
func newCacheMutationDetector[A](name String, enabled Bool, access ObjectAccess[A], clock sync.Clock, failure Option[func(String) IO[Unit]]) IO[MutationDetector[A]] { do { mutex <- sync.newMutex(); compareMutex <- sync.newMutex(); state <- sync.newRef(DetectorState(Nil,Nil,Nil,None)); ioPure(MutationDetector(name,enabled,mutex,compareMutex,state,access,clock,1000000000,120000000000,match failure { Some(f) => f; None => func(message) => ioFail(message) })) } }
func mutationDetectorAdd[A](detector MutationDetector[A], object Deleted[A]) IO[Unit] { if !detector.enabled { ioPure(unit()) } else { match object { DeletedFinalStateUnknown(_,_) => ioPure(unit()); DeletedObject(obj) => do { copy <- detector.access.deepCopy(obj); sync.withLock(detector.mutex,do { s <- sync.readRef(detector.state); sync.writeRef(detector.state,s { added: Cons(ComparedObject(obj,copy),s.added) }) }) } } } }
func compareObjects[A](detector MutationDetector[A]) IO[Unit] { if !detector.enabled { ioPure(unit()) } else { sync.withLock(detector.compareMutex,do { pairs <- sync.withLock(detector.mutex,sync.uninterruptible(do { s <- sync.readRef(detector.state); let cached = append(s.cached,reverse(s.added)); sync.writeRef(detector.state,s { cached: cached, added: Nil }); ioPure(append(cached,s.retained)) })); observations <- lists.mapM(pairs,func(pair) => detector.access.equal(pair.cached,pair.copied)); if lists.any(observations,func(equal) => !equal) { detector.failure("cache " + detector.name + " modified") } else { ioPure(unit()) } }) } }
func runMutationDetector[A](detector MutationDetector[A]) IO[Unit] { if !detector.enabled { ioPure(unit()) } else { do { sync.withLock(detector.compareMutex,sync.withLock(detector.mutex,do { s <- sync.readRef(detector.state); now <- sync.now(detector.clock); let rotate = match s.lastRotated { None => false; Some(last) => sync.elapsed(last,now) > detector.retainDuration }; sync.writeRef(detector.state,if rotate { s { cached: Nil, retained: s.cached, lastRotated: Some(now) } } else { match s.lastRotated { None => s { lastRotated: Some(now) }; Some(_) => s } }) })); compareObjects(detector); sleepClock(detector.clock,detector.period); runMutationDetector(detector) } } }
type RetryState = RetryState { first: Option[sync.Instant], last: Option[sync.Instant] }
type RetryWithDeadline = RetryWithDeadline { mutex: sync.Mutex, state: sync.Ref[RetryState], clock: sync.Clock, maxDuration: Int, resetPeriod: Int, retryable: func(errors.Error) Bool }
func newRetryWithDeadline(maxDuration Int, resetPeriod Int, retryable func(errors.Error) Bool, clock sync.Clock) IO[RetryWithDeadline] { do { mutex <- sync.newMutex(); state <- sync.newRef(RetryState(None,None)); ioPure(RetryWithDeadline(mutex,state,clock,maxDuration,resetPeriod,retryable)) } }
func retryAfter(retry RetryWithDeadline, error Option[errors.Error]) IO[Unit] { match error { None => ioPure(unit()); Some(e) => if !retry.retryable(e) { ioPure(unit()) } else { sync.withLock(retry.mutex,sync.uninterruptible(do { now <- sync.now(retry.clock); s <- sync.readRef(retry.state); let reset = match s.last { None => true; Some(last) => sync.elapsed(last,now) >= retry.resetPeriod }; sync.writeRef(retry.state,RetryState(if reset { Some(now) } else { match s.first { None => Some(now); Some(_) => s.first } },Some(now))) })) } } }
func shouldRetry(retry RetryWithDeadline) IO[Bool] { if retry.maxDuration <= 0 { ioPure(false) } else { sync.withLock(retry.mutex,do { s <- sync.readRef(retry.state); now <- sync.now(retry.clock); match s.first { None => ioPure(false); Some(first) => if sync.elapsed(first,now) <= retry.maxDuration { ioPure(true) } else { do { sync.writeRef(retry.state,RetryState(None,None)); ioPure(false) } } } }) } }
