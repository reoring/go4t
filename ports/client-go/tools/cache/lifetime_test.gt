package cache
import "std/map"
import "std/list"
import "std/io"
import "github.com/reoring/gofx/ports/client-go/support/sync"
import "github.com/reoring/gofx/ports/client-go/support/outcome"

func testExpirationStrictTTLAndRefresh() IO[Bool] { do { clock <- sync.fakeClock(0); store <- newTTLStore(cacheTestAccess(),10,clock); _ <- store.add(cacheTestObject("a",1)); sync.advance(clock,10); boundary <- store.getByKey("a"); sync.advance(clock,1); expired <- store.getByKey("a"); _ <- store.update(cacheTestObject("a",2)); refreshed <- store.getByKey("a"); ioPure(boundary.value == Some(cacheTestObject("a",1)) && expired.value == None && refreshed.value == Some(cacheTestObject("a",2))) } }
func testExpirationKeysDoNotExpireButListDoes() IO[Bool] { do { clock <- sync.fakeClock(0); store <- newTTLStore(cacheTestAccess(),1,clock); _ <- store.add(cacheTestObject("a",1)); sync.advance(clock,2); keys <- store.listKeys(); items <- store.list(); remaining <- store.listKeys(); ioPure(keys == ["a"] && items == [] && remaining == []) } }
func testMutationNewerAndBackingConvergence() IO[Bool] { do { clock <- sync.fakeClock(0); store <- newStore(cacheTestAccess()); _ <- store.add(cacheTestObject("a",1)); cache <- newIntegerResourceVersionMutationCache(store,None,cacheTestAccess(),clock,100,false,2); mutation(cache,cacheTestObject("a",3)); newer <- mutationGetByKey(cache,"a"); mutation(cache,cacheTestObject("a",2)); stillNewer <- mutationGetByKey(cache,"a"); _ <- store.update(cacheTestObject("a",4)); observed <- mutationGetByKey(cache,"a"); remaining <- sync.readRef(cache.state); ioPure(newer.value == Some(cacheTestObject("a",3)) && stillNewer.value == newer.value && observed.value == Some(cacheTestObject("a",4)) && map.mapSize(remaining.entries) == 0) } }
func testMutationDeletedUIDCannotResurrect() IO[Bool] { do { clock <- sync.fakeClock(0); store <- newStore(cacheTestAccess()); cache <- newIntegerResourceVersionMutationCache(store,None,cacheTestAccess(),clock,100,true,10); let deleted = cacheTestObject("a",2); mutationOnDelete(cache,deleted); mutation(cache,deleted { version: "3", value: 3 }); old <- mutationGetByKey(cache,"a"); mutation(cache,deleted { version: "4", value: 4, uid: "new" }); replacement <- mutationGetByKey(cache,"a"); ioPure(old.value == None && replacement.value == Some(deleted { version: "4", value: 4, uid: "new" })) } }
func testMutationLRUEvictionAndExpiration() IO[Bool] { do { clock <- sync.fakeClock(0); store <- newStore(cacheTestAccess()); cache <- newIntegerResourceVersionMutationCache(store,None,cacheTestAccess(),clock,10,true,2); mutation(cache,cacheTestObject("a",1)); mutation(cache,cacheTestObject("b",1)); _ <- mutationGetByKey(cache,"a"); mutation(cache,cacheTestObject("c",1)); evicted <- mutationGetByKey(cache,"b"); kept <- mutationGetByKey(cache,"a"); sync.advance(clock,11); expired <- mutationGetByKey(cache,"a"); ioPure(evicted.value == None && kept.value == Some(cacheTestObject("a",1)) && expired.value == None) } }
func testUnsignedResourceVersionsRemainExact() Bool { let compared = compareResourceVersions("18446744073709551615","9223372036854775808"); let tooLarge = compareResourceVersions("18446744073709551616","0"); outcome.isSuccess(compared) && compared.value == GT && !outcome.isSuccess(tooLarge) }
func testRealFIFOAtomicReplaceAndCallbackSync() IO[Bool] { do { fifo <- newRealFIFOWithOptions(RealFIFOOptions(cacheTestAccess(),None,None,true,true,true)); _ <- realReplace(fifo,[cacheTestObject("a",1),cacheTestObject("b",2)],"10"); seen <- sync.newRef(false); _ <- realPop(fifo,func(event,initial) => do { before <- queueHasSynced(fifo.queue); sync.writeRef(seen,initial && !before && (match event { ReplacedAll(items,rv) => length(items) == 2 && rv == "10"; _ => false })); ioPure(processSuccess()) }); inside <- sync.readRef(seen); after <- queueHasSynced(fifo.queue); _ <- realBookmark(fifo,"11"); bookmark <- realPop(fifo,func(_,_) => ioPure(processSuccess())); ioPure(inside && after && (match bookmark.value { Some(BookmarkInfo("11")) => true; _ => false })) } }
func testRealFIFOBatchStopsAtDuplicateAndInitialBoundary() IO[Bool] { do { known <- newStore(cacheTestAccess()); fifo <- newRealFIFOWithOptions(RealFIFOOptions(cacheTestAccess(),Some(known),None,false,false,false)); _ <- realReplace(fifo,[cacheTestObject("a",1),cacheTestObject("b",1)],"1"); _ <- realAdd(fifo,cacheTestObject("a",2)); count <- sync.newRef(0); batch <- realPopBatch(fifo,func(events,initial) => do { sync.writeRef(count,if initial { length(events) } else { -1 }); ioPure(processSuccess()) },func(_,_) => ioPure(processSuccess()),1000); n <- sync.readRef(count); remaining <- realPop(fifo,func(_,initial) => do { sync.writeRef(count,if initial { -1 } else { 1 }); ioPure(processSuccess()) }); after <- sync.readRef(count); ioPure(length(batch.value) == 2 && n == 2 && after == 1 && outcome.isSuccess(remaining)) } }
func testFilteringTransitions() IO[Bool] { do { calls <- sync.newRef([]); let record = func(name) => do { xs <- sync.readRef(calls); sync.writeRef(calls,Cons(name,xs)) }; let handler = filteringResourceEventHandler(func(obj Option[CacheTestObject]) => ioPure(match obj { None => false; Some(value) => value.value > 0 }),ResourceEventHandler(func(_,initial) => record(if initial { "initial" } else { "add" }),func(_,_) => record("update"),func(_) => record("delete"))); handler.onUpdate(cacheTestObject("a",0),cacheTestObject("a",1)); handler.onUpdate(cacheTestObject("a",1),cacheTestObject("a",2)); handler.onUpdate(cacheTestObject("a",2),cacheTestObject("a",0)); handler.onDelete(DeletedFinalStateUnknown("a",None)); history <- sync.readRef(calls); ioPure(reverse(history) == ["add","update","delete"]) } }
func testInformerNamesReleaseAndReuse() IO[Bool] { do { registry <- newInformerNameRegistry(); first <- newInformerName(registry,"controller"); duplicate <- newInformerName(registry,"controller"); match first.value { None => ioPure(false); Some(name) => do { releaseInformerName(name); reused <- newInformerName(registry,"controller"); releaseInformerName(name); third <- newInformerName(registry,"controller"); ioPure(!outcome.isSuccess(duplicate) && outcome.isSuccess(reused) && !outcome.isSuccess(third)) } } } }
func testWatchListGateObservedAtReflectorConstruction() IO[Bool] {
 do {
  clock <- sync.fakeClock(0)
  enabled <- sync.newRef(false)
  calls <- sync.newRef(0)
  informer <- newRawSharedIndexInformer(emptyRawListWatcher(),0,map.emptyMap(),clock)
  _ <- setWatchListGate(informer,func() => do { n <- sync.readRef(calls); sync.writeRef(calls,n+1); sync.readRef(enabled) })
  before <- sync.readRef(calls)
  sync.writeRef(enabled,true)
  state <- sync.readRef(informer.state)
  built <- buildSharedController(informer,state)
  after <- sync.readRef(calls)
  ioPure(before == 0 && after == 1 && (match built { (_,_,reflector) => reflector.options.watchList }))
 }
}
