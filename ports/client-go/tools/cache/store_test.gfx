package cache
import "std/map"
import lists "std/list"
import "std/io"
import "github.com/reoring/gofx/ports/client-go/support/sync"
import "github.com/reoring/gofx/ports/client-go/support/outcome"
import errors "github.com/reoring/gofx/ports/client-go/deps/support"

type CacheTestObject = CacheTestObject { key: String, namespace: String, value: Int, version: String, uid: String } deriving Eq
func cacheTestObject(key String, value Int) CacheTestObject { CacheTestObject(key,"",value,show(value),key) }
func cacheTestAccess() ObjectAccess[CacheTestObject] { ObjectAccess(func(obj) => ioPure(outcome.success(obj.key)),func(obj) => ioPure(Some(obj.version)),func(obj) => ioPure(obj.namespace),func(obj) => ioPure(map.mapInsert(map.emptyMap(),"value",show(obj.value))),func(obj) => ioPure(obj),func(a,b) => ioPure(a == b),func(obj) => ioPure(obj.uid)) }
func testStoreCRUDAndLastEventVersion() IO[Bool] { do { store <- newStoreWithOptions(cacheTestAccess(),None,defaultThreadSafeStoreOptions() { atomicFIFO: func() => ioPure(true) }); _ <- store.add(cacheTestObject("a",55)); _ <- store.update(cacheTestObject("b",32)); rv <- store.lastStoreSyncResourceVersion(); _ <- store.delete(cacheTestObject("a",1)); found <- store.getByKey("a"); _ <- store.replace([cacheTestObject("c",3)],"0"); items <- store.list(); store.bookmark("bookmark"); bookmark <- store.lastStoreSyncResourceVersion(); ioPure(rv == "32" && found.value == None && items == [cacheTestObject("c",3)] && bookmark == "bookmark") } }
func testTransactionPartialIndices() IO[Bool] { do { let access = cacheTestAccess(); let cause = cacheError("bad key"); let failing = access { key: func(obj) => ioPure(if obj.value == 3 || obj.value == 4 { outcome.failure("",cause) } else { outcome.success(obj.key) }) }; store <- newStore(failing); result <- store.transaction(map([1,3,2,4],func(i) => Transaction(cacheTestObject(show(i),i),TransactionTypeAdd))); keys <- store.listKeys(); ioPure(match result { None => false; Some(error) => error.successfulIndices == [0,2] && error.totalTransactions == 4 && length(error.errors) == 2 && length(keys) == 2 && lists.all(error.errors,func(e) => errors.errorIs(e,cause)) }) } }
func testIndexerUpdateAndLateIndex() IO[Bool] { do { indexer <- newIndexer(cacheTestAccess(),map.mapInsert(map.emptyMap(),"value",func(obj) => ioPure(outcome.success([show(obj.value),show(obj.value)])))); _ <- indexer.store.add(cacheTestObject("a",1)); _ <- indexer.store.add(cacheTestObject("b",1)); _ <- indexer.store.update(cacheTestObject("a",2)); old <- indexer.indexKeys("value","1"); now <- indexer.indexKeys("value","2"); _ <- indexer.addIndexers(map.mapInsert(map.emptyMap(),"name",func(obj) => ioPure(outcome.success([obj.key])))); late <- indexer.byIndex("name","a"); _ <- indexer.store.delete(cacheTestObject("a",2)); values <- indexer.listIndexFuncValues("value"); conflict <- indexer.addIndexers(map.mapInsert(map.emptyMap(),"name",func(obj) => ioPure(outcome.success([obj.key])))); ioPure(old.value == ["b"] && now.value == ["a"] && late.value == [cacheTestObject("a",2)] && values == ["1"] && !outcome.isSuccess(conflict)) } }
func testTransformAfterOriginalKey() IO[Bool] { do { indexer <- newIndexerWithTransformer(cacheTestAccess(),map.emptyMap(),Some(func(obj) => ioPure(outcome.success(obj { key: "changed", value: 99 })))); _ <- indexer.store.add(cacheTestObject("original",1)); original <- indexer.store.getByKey("original"); changed <- indexer.store.getByKey("changed"); ioPure(match original.value { Some(obj) => obj.value == 99 && changed.value == None; None => false }) } }
func testReplaceFailureLeavesStoreUnchanged() IO[Bool] { do { let access = cacheTestAccess(); store <- newStore(access { key: func(obj) => ioPure(if obj.key == "bad" { outcome.failure("",cacheError("bad")) } else { outcome.success(obj.key) }) }); _ <- store.add(cacheTestObject("old",1)); result <- store.replace([cacheTestObject("new",2),cacheTestObject("bad",3)],"9"); keys <- store.listKeys(); ioPure(!outcome.isSuccess(result) && keys == ["old"]) } }
func testFIFOCoalescesAndAcceptsAfterClose() IO[Bool] { do { f <- newFIFO(cacheTestAccess()); _ <- fifoAdd(f,cacheTestObject("a",1)); _ <- fifoUpdate(f,cacheTestObject("a",2)); _ <- fifoAdd(f,cacheTestObject("b",3)); queueClose(f.queue); first <- queuePop(f.queue,func(_,_) => ioPure(processSuccess())); second <- queuePop(f.queue,func(_,_) => ioPure(processSuccess())); closed <- queuePop(f.queue,func(_,_) => ioPure(processSuccess())); _ <- fifoAdd(f,cacheTestObject("c",4)); after <- queuePop(f.queue,func(_,_) => ioPure(processSuccess())); ioPure(first.value == Some(cacheTestObject("a",2)) && second.value == Some(cacheTestObject("b",3)) && !outcome.isSuccess(closed) && after.value == Some(cacheTestObject("c",4))) } }
func testFIFOSyncAfterCallback() IO[Bool] { do { f <- newFIFO(cacheTestAccess()); _ <- fifoReplace(f,[cacheTestObject("a",1)],""); inside <- sync.newRef(true); _ <- queuePop(f.queue,func(_,initial) => do { s <- sync.readRef(f.queue.state); sync.writeRef(inside,!s.synced && initial); ioPure(processSuccess()) }); before <- sync.readRef(inside); after <- queueHasSynced(f.queue); ioPure(before && after) } }
func testDeltaSyncBeforeCallback() IO[Bool] { do { f <- newDeltaFIFO(cacheTestAccess(),None); _ <- deltaReplace(f,[cacheTestObject("a",1),cacheTestObject("a",2)],"ignored"); inside <- sync.newRef(false); result <- queuePop(f.queue,func(deltas,initial) => do { s <- sync.readRef(f.queue.state); sync.writeRef(inside,s.synced && initial && length(deltas) == 2); ioPure(processSuccess()) }); seen <- sync.readRef(inside); ioPure(seen && outcome.isSuccess(result)) } }
func testDeltaDeletionDedupAndLineOrdering() IO[Bool] { do { f <- newDeltaFIFO(cacheTestAccess(),None); _ <- deltaAdd(f,cacheTestObject("a",10)); _ <- deltaAdd(f,cacheTestObject("b",1)); _ <- deltaUpdate(f,cacheTestObject("a",11)); _ <- deltaDelete(f,DeletedObject(cacheTestObject("a",15))); _ <- deltaDelete(f,DeletedFinalStateUnknown("a",None)); first <- queuePop(f.queue,func(_,_) => ioPure(processSuccess())); _ <- deltaAdd(f,cacheTestObject("a",16)); second <- queuePop(f.queue,func(_,_) => ioPure(processSuccess())); third <- queuePop(f.queue,func(_,_) => ioPure(processSuccess())); ioPure(match (first.value,second.value,third.value) { (Some(ds),Some(bs),Some(as)) => length(ds) == 3 && (match newest(ds) { Some(Delta(Deleted,DeletedObject(obj))) => obj.value == 15; _ => false }) && (match newest(bs) { Some(d) => deletionObject(d.object) == Some(cacheTestObject("b",1)); None => false }) && (match newest(as) { Some(d) => deletionObject(d.object) == Some(cacheTestObject("a",16)); None => false }); _ => false }) } }
func testDeltaReplaceMissingKnownAndResyncNoStale() IO[Bool] { do { store <- newStore(cacheTestAccess()); _ <- store.add(cacheTestObject("old",1)); f <- newDeltaFIFOWithOptions(DeltaFIFOOptions(cacheTestAccess(),Some(store),None,true)); _ <- deltaUpdate(f,cacheTestObject("old",2)); _ <- deltaResync(f); pending <- queueGet(f.queue,"old"); _ <- deltaReplace(f,[],"ignored"); missing <- queueGet(f.queue,"old"); ioPure(match (pending.value,missing.value) { (Some(before),Some(after)) => length(before) == 1 && (match newest(after) { Some(Delta(Deleted,DeletedFinalStateUnknown("old",Some(obj)))) => obj.value == 2; _ => false }); _ => false }) } }
func testFIFOConcurrentCloseWakesAll() IO[Bool] { do { f <- newFIFO(cacheTestAccess()); one <- sync.start(queuePop(f.queue,func(_,_) => ioPure(processSuccess()))); two <- sync.start(queuePop(f.queue,func(_,_) => ioPure(processSuccess()))); queueClose(f.queue); first <- sync.join(one); second <- sync.join(two); ioPure(!outcome.isSuccess(first) && !outcome.isSuccess(second)) } }
func testHeapOrderingUpdateAndClose() IO[Bool] { do { h <- newHeap(cacheTestAccess().key,func(a,b) => ioPure(a.value < b.value)); _ <- heapBulkAdd(h,[cacheTestObject("a",10),cacheTestObject("b",1),cacheTestObject("c",5)]); _ <- heapUpdate(h,cacheTestObject("a",2)); first <- heapPop(h); second <- heapPop(h); _ <- heapDelete(h,cacheTestObject("c",5)); heapClose(h); rejected <- heapAdd(h,cacheTestObject("d",0)); terminal <- heapPop(h); ioPure(first.value == Some(cacheTestObject("b",1)) && second.value == Some(cacheTestObject("a",2)) && !outcome.isSuccess(rejected) && !outcome.isSuccess(terminal)) } }
