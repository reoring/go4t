package cache
import "std/map"
import "std/list"
import "github.com/reoring/gofx/ports/client-go/support/sync"
import "github.com/reoring/gofx/ports/client-go/support/outcome"

type HeapState[A] = HeapState { items: Map[String,(A,Int)], order: Map[Int,String], size: Int, closed: Bool }
type Heap[A] = Heap { mutex: sync.Mutex, condition: sync.Condition, state: sync.Ref[HeapState[A]], key: KeyFunc[A], less: func(A,A) IO[Bool] }
func newHeap[A](key KeyFunc[A], less func(A,A) IO[Bool]) IO[Heap[A]] { do { mutex <- sync.newMutex(); condition <- sync.newCondition(mutex); state <- sync.newRef(HeapState(map.emptyMap(),map.emptyMap(),0,false)); ioPure(Heap(mutex,condition,state,key,less)) } }
func heapEntry[A](s HeapState[A], index Int) Option[(String,A)] { match map.mapLookup(s.order,index) { None => None; Some(key) => match map.mapLookup(s.items,key) { None => None; Some(pair) => Some((key,fst(pair))) } } }
func heapSwap[A](s HeapState[A], left Int, right Int) HeapState[A] { match (heapEntry(s,left),heapEntry(s,right)) { (Some((lk,lv)),Some((rk,rv))) => s { items: map.mapInsert(map.mapInsert(s.items,lk,(lv,right)),rk,(rv,left)), order: map.mapInsert(map.mapInsert(s.order,left,rk),right,lk) }; _ => s } }
func heapUp[A](s HeapState[A], index Int, less func(A,A) IO[Bool]) IO[(HeapState[A],Int)] { if index <= 0 { ioPure((s,index)) } else { let parent = (index-1)/2; match (heapEntry(s,index),heapEntry(s,parent)) { (Some((_,obj)),Some((_,above))) => do { before <- less(obj,above); if before { heapUp(heapSwap(s,index,parent),parent,less) } else { ioPure((s,index)) } }; _ => ioPure((s,index)) } } }
func heapDown[A](s HeapState[A], index Int, less func(A,A) IO[Bool]) IO[HeapState[A]] { let left = index*2+1; if left >= s.size { ioPure(s) } else { do { let right = left+1; child <- match (heapEntry(s,left),heapEntry(s,right)) { (Some((_,a)),Some((_,b))) => do { before <- less(b,a); ioPure(if before { right } else { left }) }; _ => ioPure(left) }; match (heapEntry(s,index),heapEntry(s,child)) { (Some((_,a)),Some((_,b))) => do { before <- less(b,a); if before { heapDown(heapSwap(s,index,child),child,less) } else { ioPure(s) } }; _ => ioPure(s) } } } }
func heapPut[A](s HeapState[A], key String, obj A, less func(A,A) IO[Bool], onlyAbsent Bool) IO[HeapState[A]] { match map.mapLookup(s.items,key) { Some((_,index)) => if onlyAbsent { ioPure(s) } else { do { let next = s { items: map.mapInsert(s.items,key,(obj,index)) }; up <- heapUp(next,index,less); heapDown(fst(up),snd(up),less) } }; None => do { up <- heapUp(s { items: map.mapInsert(s.items,key,(obj,s.size)), order: map.mapInsert(s.order,s.size,key), size: s.size+1 },s.size,less); ioPure(fst(up)) } } }
func heapRemove[A](s HeapState[A], key String, less func(A,A) IO[Bool]) IO[HeapState[A]] { match map.mapLookup(s.items,key) { None => ioPure(s); Some((_,index)) => do { let swapped = heapSwap(s,index,s.size-1); let removed = swapped { items: map.mapDelete(swapped.items,key), order: map.mapDelete(swapped.order,s.size-1), size: s.size-1 }; if index >= removed.size { ioPure(removed) } else { do { up <- heapUp(removed,index,less); heapDown(fst(up),snd(up),less) } } } } }
func heapAdd[A](h Heap[A], obj A) IO[outcome.Outcome[Unit]] { heapAddMode(h,obj,false) }
func heapUpdate[A](h Heap[A], obj A) IO[outcome.Outcome[Unit]] { heapAdd(h,obj) }
func heapAddIfNotPresent[A](h Heap[A], obj A) IO[outcome.Outcome[Unit]] { heapAddMode(h,obj,true) }
func heapAddMode[A](h Heap[A], obj A, onlyAbsent Bool) IO[outcome.Outcome[Unit]] { do { key <- h.key(obj); match key.error { Some(e) => ioPure(outcome.failure(unit(),e)); None => sync.withLock(h.mutex,sync.uninterruptible(do { s <- sync.readRef(h.state); if s.closed { ioPure(outcome.failure(unit(),cacheError("heap is closed"))) } else { do { next <- heapPut(s,key.value,obj,h.less,onlyAbsent); sync.writeRef(h.state,next); sync.broadcast(h.condition); ioPure(outcome.success(unit())) } } })) } } }
func heapBulkState[A](h Heap[A], s HeapState[A], objects List[A]) IO[outcome.Outcome[HeapState[A]]] { match objects { Nil => ioPure(outcome.success(s)); Cons(obj,rest) => do { key <- h.key(obj); match key.error { Some(e) => ioPure(outcome.failure(s,e)); None => do { next <- heapPut(s,key.value,obj,h.less,false); heapBulkState(h,next,rest) } } } } }
func heapBulkAdd[A](h Heap[A], objects List[A]) IO[outcome.Outcome[Unit]] { sync.withLock(h.mutex,sync.uninterruptible(do { s <- sync.readRef(h.state); next <- if s.closed { ioPure(outcome.failure(s,cacheError("heap is closed"))) } else { heapBulkState(h,s,objects) }; sync.writeRef(h.state,next.value); if outcome.isSuccess(next) { sync.broadcast(h.condition) } else { ioPure(unit()) }; ioPure(outcome.from(unit(),next.error)) })) }
func heapDelete[A](h Heap[A], obj A) IO[outcome.Outcome[Unit]] { do { key <- h.key(obj); match key.error { Some(e) => ioPure(outcome.failure(unit(),e)); None => sync.withLock(h.mutex,sync.uninterruptible(do { s <- sync.readRef(h.state); if !map.mapMember(s.items,key.value) { ioPure(outcome.failure(unit(),cacheError("object not found"))) } else { do { next <- heapRemove(s,key.value,h.less); sync.writeRef(h.state,next); ioPure(outcome.success(unit())) } } })) } } }
func heapPop[A](h Heap[A]) IO[outcome.Outcome[Option[A]]] { sync.withLock(h.mutex,heapPopLocked(h)) }
func heapPopLocked[A](h Heap[A]) IO[outcome.Outcome[Option[A]]] { do { s <- sync.readRef(h.state); match heapEntry(s,0) { Some((key,obj)) => sync.uninterruptible(do { next <- heapRemove(s,key,h.less); sync.writeRef(h.state,next); ioPure(outcome.success(Some(obj))) }); None => if s.closed { ioPure(outcome.failure(None,cacheError("heap is closed"))) } else { do { sync.wait(h.condition); heapPopLocked(h) } } } } }
func heapClose[A](h Heap[A]) IO[Unit] { sync.withLock(h.mutex,sync.uninterruptible(do { s <- sync.readRef(h.state); sync.writeRef(h.state,s { closed: true }); sync.broadcast(h.condition) })) }
func heapIsClosed[A](h Heap[A]) IO[Bool] { sync.withLock(h.mutex,do { s <- sync.readRef(h.state); ioPure(s.closed) }) }
func heapList[A](h Heap[A]) IO[List[A]] { sync.withLock(h.mutex,do { s <- sync.readRef(h.state); ioPure(map(map.mapValues(s.items),func(pair) => fst(pair))) }) }
func heapListKeys[A](h Heap[A]) IO[List[String]] { sync.withLock(h.mutex,do { s <- sync.readRef(h.state); ioPure(map.mapKeys(s.items)) }) }
func heapGetByKey[A](h Heap[A], key String) IO[outcome.Outcome[Option[A]]] { sync.withLock(h.mutex,do { s <- sync.readRef(h.state); ioPure(outcome.success(match map.mapLookup(s.items,key) { None => None; Some(pair) => Some(fst(pair)) })) }) }
