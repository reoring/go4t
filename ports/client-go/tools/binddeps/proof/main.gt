package main

import core "github.com/reoring/gofx/ports/client-go/deps/k8s.io/api/core/v1"
import meta "github.com/reoring/gofx/ports/client-go/deps/k8s.io/apimachinery/pkg/apis/meta/v1"
import schema "github.com/reoring/gofx/ports/client-go/deps/k8s.io/apimachinery/pkg/runtime/schema"
import smd "github.com/reoring/gofx/ports/client-go/deps/sigs.k8s.io/structured-merge-diff/v6/schema"
import support "github.com/reoring/gofx/ports/client-go/deps/support"
import codec "github.com/reoring/gofx/ports/client-go/deps/codec"
import left "github.com/reoring/gofx/ports/client-go/tools/binddeps/proof/left"
import right "github.com/reoring/gofx/ports/client-go/tools/binddeps/proof/right"
import runtimeApi "github.com/reoring/gofx/ports/client-go/deps/k8s.io/apimachinery/pkg/runtime"
import objects "github.com/reoring/gofx/ports/client-go/deps/objects"
import "std/io"
import autoscaling "github.com/reoring/gofx/ports/client-go/deps/k8s.io/api/autoscaling/v1"
import appsBeta "github.com/reoring/gofx/ports/client-go/deps/k8s.io/api/apps/v1beta2"
import sync "github.com/reoring/gofx/ports/client-go/support/sync"
import selectors "github.com/reoring/gofx/ports/client-go/deps/k8s.io/apimachinery/pkg/labels"
import time "github.com/reoring/gofx/ports/client-go/deps/time"
import unstructured "github.com/reoring/gofx/ports/client-go/deps/k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"

extern func aliasConvert(a Option[core.Pod], b Option[core.Pod]) IO[((Option[core.Pod], Option[core.Pod]), (Bool, Option[support.Error]))] = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".AliasConvert
extern func recursiveFixture() smd.TypeRef = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".RecursiveFixture
extern func sameMap(a Option[smd.MapGo], b Option[smd.MapGo]) IO[((Option[smd.MapGo], Option[smd.MapGo]), Bool)] = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".SameMap
extern func pointerMap() IO[support.ForeignMap[support.PointerKey[core.Pod],String]] = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".PointerMap
extern func metadataView(value runtimeApi.Object) IO[Option[meta.Object]] = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".MetadataView
extern func sameObjectStorage(left runtimeApi.Object, right runtimeApi.Object) Bool = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".SameObjectStorage
extern func sameDescriptor[A](left objects.ObjectType[A], right objects.ObjectType[A]) Bool = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".SameDescriptor
extern func typedNilObject() Option[runtimeApi.Object] = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".TypedNilObject
extern func alreadyExists() support.Error = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".AlreadyExists
extern func notRegistered() support.Error = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".NotRegistered
extern func largeIntegerObject() runtimeApi.Object = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".LargeIntegerObject
extern func hasLargeInteger(value runtimeApi.Object) Bool = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".HasLargeInteger
extern func cborHasLargeInteger(value String) IO[Bool] = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".CBORHasLargeInteger
extern func customJSON() runtimeApi.Object = "github.com/reoring/gofx/ports/client-go/tools/binddeps/proofhost".CustomJSON

func require(ok Bool, message String) IO[Unit] {
 if ok { ioPure(unit()) } else { ioFail(message) }
}
func expect[A](value Option[A], message String) IO[A] {
 match value {
  Some(x) => ioPure(x)
  None => ioFail(message)
 }
}
alias CallbackDecodeResult = ((Option[String], (Option[schema.GroupVersionKind], Option[runtimeApi.Object])), (Option[runtimeApi.Object], (Option[schema.GroupVersionKind], Option[support.Error])))
func callbackDecode(data Option[String], defaults Option[schema.GroupVersionKind], into Option[runtimeApi.Object]) IO[CallbackDecodeResult] {
 let pod = core.podWithObjectMeta(core.newPod(), meta.objectMetaWithName(meta.newObjectMeta(), "callback"))
 let kind = schema.groupVersionKindWithKind(schema.newGroupVersionKind(), "Pod")
 let err = support.errorConflict("", "pods", "callback", None)
 ioPure(((data, (defaults, into)), (Some(core.podToRuntimeObject(pod)), (Some(kind), Some(err)))))
}
func invalidUInt() IO[support.UInt64] {
 do {
  ioPure(unit())
  ioPure(support.uint64(4294967296, 0))
 }
}
func customKind(initial schema.GroupVersionKind) IO[schema.ObjectKind] {
 do {
  state <- sync.newRef(initial)
  schema.newObjectKind(
   func() => sync.readRef(state),
   func(value) => sync.writeRef(state, value),
   func() => do {
    current <- sync.readRef(state)
    copied <- customKind(current)
    ioPure(Some(copied))
   }
  )
 }
}
func main() IO[Unit] {
 do {
  let original = core.newPod()
  let originalMeta = core.podGetObjectMeta(original)
  let renamed = meta.objectMetaWithName(originalMeta, "typed-pod")
  let transported = right.metadata(left.metadata(renamed))
  let pod = core.podWithObjectMeta(original, transported)
  require(meta.objectMetaGetName(core.podGetObjectMeta(pod)) == "typed-pod", "typed metadata did not survive canonical imports")
  require(meta.objectMetaGetName(core.podGetObjectMeta(original)) == "", "immutable Pod input was mutated")
  let descriptor = core.podObjectType()
  require(sameDescriptor(descriptor, core.podObjectType()), "object descriptor was not cached")
  let objectView = objects.toObject(descriptor, pod)
  require(sameObjectStorage(objectView, core.podToRuntimeObject(pod)), "upcast copied the Pod snapshot")
  roundTrip <- expect(objects.fromObject(descriptor, Some(objectView)), "descriptor round trip failed")
  require(sameObjectStorage(objectView, objects.toObject(descriptor, roundTrip)), "cast allocated a replacement Pod")
  require(match objects.fromObject(core.podListObjectType(), Some(objectView)) {None => true Some(_) => false}, "descriptor accepted wrong concrete type")
  require(match objects.fromObject(descriptor, None) {None => true Some(_) => false}, "descriptor lost absent object")
  require(match objects.fromObject(descriptor, typedNilObject()) {None => true Some(_) => false}, "descriptor lost typed nil object")
  let betaScale = objects.toObject(appsBeta.scaleObjectType(), appsBeta.newScale())
  require(match objects.fromObject(autoscaling.scaleObjectType(), Some(betaScale)) {None => true Some(_) => false}, "descriptor conflated versioned Scale types")
  kindView <- runtimeApi.objectCallGetObjectKind(objectView)
  kindCapability <- expect(kindView.1, "object kind view missing")
  let requestedKind = schema.groupVersionKindWithKind(schema.newGroupVersionKind(), "Changed")
  changedKind <- schema.objectKindCallSetGroupVersionKind(kindCapability, requestedKind)
  kindReadback <- schema.objectKindCallGroupVersionKind(changedKind.0)
  require(schema.groupVersionKindGetKind(kindReadback.1) == "Changed", "kind mutation lost returned snapshot")
  require(meta.typeMetaGetKind(core.podGetTypeMeta(pod)) == "", "kind interface mutated original Pod")
  metadataCapability <- metadataView(objectView)
  mutableMetadata <- expect(metadataCapability, "metadata interface view missing")
  changedMetadata <- meta.objectCallSetName(mutableMetadata, "isolated-name")
  metadataReadback <- meta.objectCallGetName(changedMetadata.0)
  require(metadataReadback.1 == "isolated-name", "metadata mutation lost returned snapshot")
  require(meta.objectMetaGetName(core.podGetObjectMeta(pod)) == "typed-pod", "metadata interface mutated original Pod")
  let absentLabels = meta.objectMetaGetLabels(originalMeta)
  require(support.mapIsNil(absentLabels), "zero labels must remain nil")
  let emptyLabels = support.mapEmpty(absentLabels)
  let withEmptyLabels = meta.objectMetaWithLabels(originalMeta, emptyLabels)
  require(!support.mapIsNil(meta.objectMetaGetLabels(withEmptyLabels)), "empty labels were collapsed to nil")
  let labels = support.mapWith(emptyLabels, "app", "typed")
  label <- expect(support.mapLookup(labels, "app"), "typed map entry missing")
  require(label == "typed", "typed map value mismatch")
  let zeroList = core.newPodList()
  require(match core.podListGetItems(zeroList) {None => true Some(_) => false}, "zero PodList.Items must be nil")
  let emptyList = core.podListWithItems(zeroList, Some([]))
  require(match core.podListGetItems(emptyList) {Some(_) => true None => false}, "empty PodList.Items lost presence")
  let populated = core.podListWithItems(emptyList, Some([pod]))
  items <- expect(core.podListGetItems(populated), "typed PodList missing")
  require(match items {Cons(item, _) => meta.objectMetaGetName(core.podGetObjectMeta(item)) == "typed-pod" Nil => false}, "PodList lost typed item")
  let options = meta.newListOptions()
  require(match meta.listOptionsGetSendInitialEvents(options) {None => true Some(_) => false}, "initial events should be absent")
  let explicitFalse = meta.listOptionsWithSendInitialEvents(options, Some(false))
  require(match meta.listOptionsGetSendInitialEvents(explicitFalse) {Some(flag) => !flag None => false}, "explicit false lost presence")
  let large = 9007199254740993
  let largeOptions = meta.listOptionsWithLimit(explicitFalse, large)
  require(meta.listOptionsGetLimit(largeOptions) == large, "int64 precision lost above 2^53")
  let u = support.uint64(4294967295, 4294967295)
  require(support.uint64High(u) == 4294967295 && support.uint64Low(u) == 4294967295, "uint64 bits lost")
  let leaf = smd.typeRefWithNamedType(smd.newTypeRef(), Some("leaf"))
  let recursiveMap = smd.mapGoWithElementType(smd.newMapGo(), leaf)
  let atom = smd.atomWithMap(smd.newAtom(), Some(recursiveMap))
  let nested = smd.typeRefWithInlined(smd.newTypeRef(), atom)
  nestedMap <- expect(smd.atomGetMap(smd.typeRefGetInlined(nested)), "recursive map missing")
  leafName <- expect(smd.typeRefGetNamedType(smd.mapGoGetElementType(nestedMap)), "recursive leaf missing")
  require(leafName == "leaf", "recursive graph was flattened")
  aliasResult <- aliasConvert(Some(pod), Some(pod))
  require(aliasResult.1.0, "snapshot alias was lost across external Scheme.Convert")
  firstAlias <- expect(aliasResult.0.0, "first updated alias missing")
  secondAlias <- expect(aliasResult.0.1, "second updated alias missing")
  require(meta.objectMetaGetName(core.podGetObjectMeta(firstAlias)) == "alias-updated", "first updated input lost")
  require(meta.objectMetaGetName(core.podGetObjectMeta(secondAlias)) == "alias-updated", "second updated input lost")
  require(meta.objectMetaGetName(core.podGetObjectMeta(pod)) == "typed-pod", "external conversion mutated the input snapshot")
  let cycle = recursiveFixture()
  cycleMap <- expect(smd.atomGetMap(smd.typeRefGetInlined(cycle)), "cyclic map missing")
  repeatedMap <- expect(smd.atomGetMap(smd.typeRefGetInlined(smd.mapGoGetElementType(cycleMap))), "cyclic map edge missing")
  cycleResult <- sameMap(Some(cycleMap), Some(repeatedMap))
  require(cycleResult.1, "cyclic snapshot alias was not preserved")
  decoder <- codec.newJSONDecoder()
  decoded <- codec.decode(decoder, "{\"apiVersion\":\"v1\",\"kind\":\"Pod\",\"metadata\":{\"name\":\"decoded\"},\"unknownStrictField\":true}", None, None)
  object <- expect(decoded.object, "decode lost object on strict error")
  decodedPod <- expect(core.podFromRuntimeObject(object), "decode returned wrong concrete object")
  require(meta.objectMetaGetName(core.podGetObjectMeta(decodedPod)) == "decoded", "decoded typed fields lost")
  kind <- expect(decoded.gvk, "decode lost GVK on strict error")
  require(schema.groupVersionKindGetKind(kind) == "Pod", "decode GVK mismatch")
  err <- expect(decoded.error, "strict decoding error missing")
  require(support.errorIsStrictDecoding(err), "structured strict error identity lost")
  let resource = schema.groupResourceWithResource(schema.newGroupResource(), "pods")
  let notFound = codec.newNotFound(resource, "absent")
  require(support.errorIsNotFound(notFound), "API status predicate lost")
  status <- expect(codec.errorStatus(notFound), "API status payload missing")
  require(meta.statusGetCode(status) == 404, "API status code lost")
  proxy <- runtimeApi.newDecoder(callbackDecode)
  proxied <- codec.decode(proxy, "callback-input", None, None)
  proxyObject <- expect(proxied.object, "native decoder callback lost object")
  proxyPod <- expect(core.podFromRuntimeObject(proxyObject), "native decoder callback lost concrete type")
  require(meta.objectMetaGetName(core.podGetObjectMeta(proxyPod)) == "callback", "native decoder callback value mismatch")
  proxyKind <- expect(proxied.gvk, "native decoder callback lost GVK")
  require(schema.groupVersionKindGetKind(proxyKind) == "Pod", "native decoder callback GVK mismatch")
  proxyError <- expect(proxied.error, "native decoder callback lost partial-result error")
  require(support.errorIsConflict(proxyError), "native decoder callback erased API error")
  invalid <- io.tryIO(invalidUInt())
  require(match invalid {Err(_) => true Ok(_) => false}, "invalid uint64 components were accepted")
  pointerKeys <- pointerMap()
  key <- expect(match support.mapEntries(pointerKeys) {Cons(pair, _) => Some(pair.0) Nil => None}, "pointer map key missing")
  keyed <- expect(support.mapLookup(pointerKeys, key), "pointer key identity lost on lookup")
  require(keyed == "pointer-key", "pointer key map value mismatch")
  let nilKey = support.mapNilPointerKey(pointerKeys)
  require(!support.pointerKeyEqual(key, nilKey), "nonnull and nil pointer keys collapsed")
  nilPointer <- expect(support.mapLookup(support.mapWith(pointerKeys, nilKey, "nil"), nilKey), "nil pointer key missing")
  require(nilPointer == "nil", "nil pointer key value lost")
  copied <- objects.objectDeepCopy(object)
  equal <- objects.objectEqual(Some(object), copied)
  require(equal, "external object deepcopy equality lost")
  let raw = runtimeApi.rawExtensionWithRaw(runtimeApi.newRawExtension(), Some("{\"hello\":1}"))
  rawObject <- objects.rawExtensionToObject(raw)
  require(match rawObject.0 {Some(_) => true None => false}, "RawExtension failed to convert to Unknown")
  nullRaw <- objects.objectToRawExtension(None, runtimeApi.newRawExtension())
  require(match runtimeApi.rawExtensionGetRaw(nullRaw.0) {Some(value) => value == "null" None => false}, "nil *Object conversion lost")
  absentRaw <- objects.objectToRawExtension(Some(None), runtimeApi.newRawExtension())
  require(match runtimeApi.rawExtensionGetRaw(absentRaw.0) {None => true Some(_) => false}, "pointer-to-nil Object conversion lost")
  let leafError = support.errorNew("leaf")
  let wrappedError = support.errorWrap("context", leafError)
  require(support.errorIs(wrappedError, leafError), "error wrapping lost identity")
  require(support.errorMessage(wrappedError) == "context: leaf", "error wrapper message mismatch")
  version <- objects.objectResourceVersion(object)
  require(version.0 == "", "object metadata resourceVersion mismatch")
  statusObject <- meta.statusCallDeepCopyObject(meta.statusWithCode(meta.newStatus(), 503))
  statusValue <- expect(statusObject.1, "Status DeepCopyObject returned nil")
  typedStatus <- expect(objects.objectAsStatus(statusValue), "typed Status projection failed")
  require(meta.statusGetCode(typedStatus) == 503, "typed Status code lost")
  explicitKind <- customKind(schema.groupVersionKindWithKind(schema.newGroupVersionKind(), "original"))
  explicitChange <- schema.objectKindCallSetGroupVersionKind(explicitKind, schema.groupVersionKindWithKind(schema.newGroupVersionKind(), "copied"))
  explicitOld <- schema.objectKindCallGroupVersionKind(explicitKind)
  explicitNew <- schema.objectKindCallGroupVersionKind(explicitChange.0)
  require(schema.groupVersionKindGetKind(explicitOld.1) == "original", "custom copy adapter mutated old interface view")
  require(schema.groupVersionKindGetKind(explicitNew.1) == "copied", "custom copy adapter lost new interface state")
  copiedShallow <- objects.shallowCopy(core.podObjectType(), original)
  require(!sameObjectStorage(objects.toObject(core.podObjectType(), original), objects.toObject(core.podObjectType(), copiedShallow)), "shallow copy retained outer object identity")
  require(meta.objectMetaGetName(core.podGetObjectMeta(copiedShallow)) == meta.objectMetaGetName(core.podGetObjectMeta(original)), "shallow copy changed metadata")
  let missingError = support.errorNotFound("apps", "deployments", "missing")
  require(support.errorIsNotFound(missingError), "NotFound constructor lost status reason")
  require(!support.errorIsAlreadyExists(missingError), "NotFound misclassified AlreadyExists")
  require(support.errorIsAlreadyExists(support.errorWrap("wrapped", alreadyExists())), "AlreadyExists lost wrapped error reason")
  constructedTime <- time.timeCallUnix(time.unix(12, 2000000000))
  require(constructedTime.1 == 14, "Unix construction lost nanosecond normalization")
  nilSelectorResult <- objects.labelSelectorAsSelector(None)
  nilSelector <- expect(nilSelectorResult.0, "nil label selector lost Nothing")
  nilMatches <- selectors.selectorCallMatchesIdentity(nilSelector, None)
  require(!nilMatches, "nil label selector did not select Nothing")
  let emptySelector = meta.newLabelSelector()
  emptySelectorResult <- objects.labelSelectorAsSelector(Some(emptySelector))
  emptyParsed <- expect(emptySelectorResult.0, "empty label selector lost Everything")
  emptyMatches <- selectors.selectorCallMatchesIdentity(emptyParsed, None)
  require(emptyMatches, "empty label selector did not select Everything")
  let invalidRequirement = meta.labelSelectorRequirementWithOperator(meta.newLabelSelectorRequirement(), meta.labelSelectorOperatorFromValue("invalid"))
  invalidSelectorResult <- objects.labelSelectorAsSelector(Some(meta.labelSelectorWithMatchExpressions(emptySelector, Some([invalidRequirement]))))
  require(match invalidSelectorResult.0 {None => true Some(_) => false}, "invalid selector returned nonnil selector")
  require(match invalidSelectorResult.1 {Some(_) => true None => false}, "invalid selector lost error")
  require(support.mapIsNil(meta.labelSelectorGetMatchLabels(emptySelector)), "selector conversion mutated nil map")
  require(support.errorIsNotRegistered(notRegistered()), "registration predicate lost original error type")
  require(!support.errorIsNotRegistered(support.errorWrap("wrapped", notRegistered())), "registration predicate changed external wrapper semantics")
  absentType <- objects.objectTypeName(None)
  typedNilType <- objects.objectTypeName(typedNilObject())
  require(absentType == "<nil>" && typedNilType == "*v1.Pod", "object type name collapsed nil and typed nil")
  encodedInteger <- codec.encodeJSON(largeIntegerObject())
  integerJSON <- expect(encodedInteger.0, "integer JSON output missing")
  decodedInteger <- codec.decodeJSON(unstructured.unstructuredObjectType(), integerJSON)
  integerValue <- expect(decodedInteger.0, "integer JSON object missing")
  require(hasLargeInteger(unstructured.unstructuredToRuntimeObject(integerValue)), "JSON codec rounded int64 through float")
  encodedCBOR <- codec.encodeCBOR(largeIntegerObject())
  integerCBOR <- expect(encodedCBOR.0, "integer CBOR output missing")
  exactCBOR <- cborHasLargeInteger(integerCBOR)
  require(exactCBOR, "CBOR codec rounded int64 through float")
  customEncoded <- codec.encodeJSON(customJSON())
  require(match customEncoded.0 {Some(bytes) => bytes == "{\"custom\":9007199254740993}" None => false}, "JSON custom marshaler bypassed")
  partialJSON <- codec.decodeJSON(core.podObjectType(), "{\"metadata\":{\"name\":\"partial\"},\"spec\":{\"terminationGracePeriodSeconds\":\"bad\"}}")
  partialPod <- expect(partialJSON.0, "JSON error lost partial object")
  require(meta.objectMetaGetName(core.podGetObjectMeta(partialPod)) == "partial", "JSON error lost decoded fields")
  require(match partialJSON.1 {Some(_) => true None => false}, "JSON invalid int lost original error")
  println("dependency-proof: typed Pod/PodList/ListOptions; presence; int64/uint64; recursive schema; canonical identity; decode object+GVK+structured-error PASS")
 }
}
