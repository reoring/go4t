package clientcmd
import api "github.com/reoring/gofx/ports/client-go/tools/clientcmd/api"
import "std/map"
import "std/prelude"
func _string(dst String,src String) String { if src == "" { dst } else { src } }
func _pointer[A](dst Option[A],src Option[A]) Option[A] { match src { None => dst; Some(_) => src } }
func _slice[A](dst Option[List[A]],src Option[List[A]]) Option[List[A]] { if length(api.listOrEmpty(src)) == 0 { dst } else { src } }
func _bytes(dst Option[String],src Option[String]) Option[String] { if api.bytesOrEmpty(src) == "" { dst } else { src } }
func _map[A](dst Option[Map[String,A]],src Option[Map[String,A]]) Option[Map[String,A]] { match src { None => dst; Some(entries) => Some(map.mapFold(entries,api.mapOrEmpty(dst),func(result,key,value) => map.mapInsert(result,key,value))) } }
func mergeCluster(dst api.Cluster,src api.Cluster) api.Cluster { dst{locationOfOrigin:_string(dst.locationOfOrigin,src.locationOfOrigin),server:_string(dst.server,src.server),tlsServerName:_string(dst.tlsServerName,src.tlsServerName),insecureSkipTLSVerify:dst.insecureSkipTLSVerify || src.insecureSkipTLSVerify,certificateAuthority:_string(dst.certificateAuthority,src.certificateAuthority),certificateAuthorityData:_bytes(dst.certificateAuthorityData,src.certificateAuthorityData),proxyURL:_string(dst.proxyURL,src.proxyURL),disableCompression:dst.disableCompression || src.disableCompression,extensions:_map(dst.extensions,src.extensions)} }
func mergeContext(dst api.Context,src api.Context) api.Context { dst{locationOfOrigin:_string(dst.locationOfOrigin,src.locationOfOrigin),cluster:_string(dst.cluster,src.cluster),authInfo:_string(dst.authInfo,src.authInfo),namespace:_string(dst.namespace,src.namespace),extensions:_map(dst.extensions,src.extensions)} }
func mergeAuthInfo(dst api.AuthInfo,src api.AuthInfo) api.AuthInfo { dst{locationOfOrigin:_string(dst.locationOfOrigin,src.locationOfOrigin),clientCertificate:_string(dst.clientCertificate,src.clientCertificate),clientCertificateData:_bytes(dst.clientCertificateData,src.clientCertificateData),clientKey:_string(dst.clientKey,src.clientKey),clientKeyData:_bytes(dst.clientKeyData,src.clientKeyData),token:_string(dst.token,src.token),tokenFile:_string(dst.tokenFile,src.tokenFile),impersonate:_string(dst.impersonate,src.impersonate),impersonateUID:_string(dst.impersonateUID,src.impersonateUID),impersonateGroups:_slice(dst.impersonateGroups,src.impersonateGroups),impersonateUserExtra:_map(dst.impersonateUserExtra,src.impersonateUserExtra),username:_string(dst.username,src.username),password:_string(dst.password,src.password),authProvider:_pointer(dst.authProvider,src.authProvider),exec:_pointer(dst.exec,src.exec),extensions:_map(dst.extensions,src.extensions)} }
func mergePreferences(dst api.Preferences,src api.Preferences) api.Preferences { dst{colors:dst.colors || src.colors,extensions:_map(dst.extensions,src.extensions)} }
func mergeConfig(dst api.Config,src api.Config) api.Config { dst{kind:_string(dst.kind,src.kind),apiVersion:_string(dst.apiVersion,src.apiVersion),preferences:mergePreferences(dst.preferences,src.preferences),clusters:_map(dst.clusters,src.clusters),authInfos:_map(dst.authInfos,src.authInfos),contexts:_map(dst.contexts,src.contexts),currentContext:_string(dst.currentContext,src.currentContext),extensions:_map(dst.extensions,src.extensions)} }
func mergeConfigs(configs List[api.Config]) api.Config { fold(reverse(configs),api.newConfig(),mergeConfig) }
