func jsonObjectFields(text String) IO[Map[String,String]] { do { fields <- _splitObject(text); ioPure(map.mapFromList(fields)) } }
func jsonField(fields Map[String,String], name String) String { match map.mapLookup(fields,name) { None => "null"; Some(value) => value } }
func jsonObject(fields List[(String,String)]) String { "{" + string.join(",",prelude.fmap(fields,func((key,value)) => quoteJSON(key)+":"+value))+"}" }
func decodeOptional[A](text String, decode func(String) IO[A]) IO[Option[A]] { if text == "null" { ioPure(None) } else { do { value <- decode(text); ioPure(Some(value)) } } }
func _encodeOption[A](value Option[A], encode func(A) IO[String]) IO[String] { match value { None => ioPure("null"); Some(value) => encode(value) } }
func _decodeList[A](text String, decode func(String) IO[A]) IO[List[A]] { do { values <- _splitArray(text); prelude.traverse(values,decode) } }
func _encodeList[A](values List[A], encode func(A) IO[String]) IO[String] { do { values <- prelude.traverse(values,encode); ioPure("["+string.join(",",values)+"]") } }
func _decodeMap[A](text String, decode func(String) IO[A]) IO[Map[String,A]] { do { fields <- _splitObject(text); entries <- prelude.traverse(fields,func((key,value)) => do { v <- decode(value); ioPure((key,v)) }); ioPure(map.mapFromList(entries)) } }
func _encodeMap[A](value Map[String,A], encode func(A) IO[String]) IO[String] { do { fields <- prelude.traverse(map.mapToList(value),func((key,value)) => do { encoded <- encode(value); ioPure((key,encoded)) }); ioPure(jsonObject(fields)) } }
func _encodeString(value String) IO[String] { ioPure(quoteJSON(value)) }
func _encodeBool(value Bool) IO[String] { ioPure(if value { "true" } else { "false" }) }
func _encodeBytes(value String) IO[String] { ioPure(quoteJSON(encodeBytes(value))) }
func _decodeBytes(text String) IO[String] { do { encoded <- jsonStringValue(text); decodeBytes(encoded) } }
func decodeWireConfig(text String) IO[WireConfig] { do {
 fields <- jsonObjectFields(text)
 kind <- jsonStringValue(jsonField(fields,"kind"))
 apiVersion <- jsonStringValue(jsonField(fields,"apiVersion"))
 preferences <- decodeWirePreferences(jsonField(fields,"preferences"))
 clusters <- decodeOptional(jsonField(fields,"clusters"),func(value) => _decodeList(value,func(value) => decodeNamedCluster(value)))
 authInfos <- decodeOptional(jsonField(fields,"users"),func(value) => _decodeList(value,func(value) => decodeNamedAuthInfo(value)))
 contexts <- decodeOptional(jsonField(fields,"contexts"),func(value) => _decodeList(value,func(value) => decodeNamedContext(value)))
 currentContext <- jsonStringValue(jsonField(fields,"current-context"))
 extensions <- decodeOptional(jsonField(fields,"extensions"),func(value) => _decodeList(value,func(value) => decodeNamedExtension(value)))
 ioPure(WireConfig(kind,apiVersion,preferences,clusters,authInfos,contexts,currentContext,extensions))
} }
func encodeWireConfig(value WireConfig) IO[String] { do {
 kind <- _encodeString(value.kind)
 apiVersion <- _encodeString(value.apiVersion)
 preferences <- encodeWirePreferences(value.preferences)
 clusters <- _encodeOption(value.clusters,func(value) => _encodeList(value,func(value) => encodeNamedCluster(value)))
 authInfos <- _encodeOption(value.authInfos,func(value) => _encodeList(value,func(value) => encodeNamedAuthInfo(value)))
 contexts <- _encodeOption(value.contexts,func(value) => _encodeList(value,func(value) => encodeNamedContext(value)))
 currentContext <- _encodeString(value.currentContext)
 extensions <- _encodeOption(value.extensions,func(value) => _encodeList(value,func(value) => encodeNamedExtension(value)))
 let fields: List[(String,String)] = Nil
 let fields = if value.kind != "" { list.append(fields,[("kind",kind)]) } else { fields }
 let fields = if value.apiVersion != "" { list.append(fields,[("apiVersion",apiVersion)]) } else { fields }
 let fields = if !value.preferences.colors && (match value.preferences.extensions { None => true; Some(_) => false }) { fields } else { list.append(fields,[("preferences",preferences)]) }
 let fields = list.append(fields,[("clusters",clusters)])
 let fields = list.append(fields,[("users",authInfos)])
 let fields = list.append(fields,[("contexts",contexts)])
 let fields = list.append(fields,[("current-context",currentContext)])
 let fields = if extensions != "null" && extensions != "[]" && extensions != "{}" && extensions != "\"\"" { list.append(fields,[("extensions",extensions)]) } else { fields }
 ioPure(jsonObject(fields))
} }
func decodeWirePreferences(text String) IO[WirePreferences] { do {
