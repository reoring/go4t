func decodeWireCluster(text String) IO[WireCluster] { do {
 fields <- jsonObjectFields(text)
 server <- jsonStringValue(jsonField(fields,"server"))
 tlsServerName <- jsonStringValue(jsonField(fields,"tls-server-name"))
 insecureSkipTLSVerify <- jsonBoolValue(jsonField(fields,"insecure-skip-tls-verify"))
 certificateAuthority <- jsonStringValue(jsonField(fields,"certificate-authority"))
