package api
import runtime "github.com/reoring/gofx/ports/client-go/deps/k8s.io/apimachinery/pkg/runtime"
import objects "github.com/reoring/gofx/ports/client-go/deps/objects"
import "std/map"
import "std/prelude"
func equalOption[A](a Option[A],b Option[A],equal func(A,A) IO[Bool]) IO[Bool] { match a { None => ioPure(match b { None => true; Some(_) => false }); Some(a) => match b { None => ioPure(false); Some(b) => equal(a,b) } } }
func equalList[A](a List[A],b List[A],equal func(A,A) IO[Bool]) IO[Bool] { match a { Nil => ioPure(match b { Nil => true; _ => false }); Cons(a,as) => match b { Nil => ioPure(false); Cons(b,bs) => do { same <- equal(a,b); if same { equalList(as,bs,equal) } else { ioPure(false) } } } } }
func equalMap[A](a Map[String,A],b Map[String,A],equal func(A,A) IO[Bool]) IO[Bool] { if map.mapSize(a) != map.mapSize(b) { ioPure(false) } else { _equalEntries(map.mapToList(a),b,equal) } }
func _equalEntries[A](entries List[(String,A)],b Map[String,A],equal func(A,A) IO[Bool]) IO[Bool] { match entries { Nil => ioPure(true); Cons((key,value),rest) => match map.mapLookup(b,key) { None => ioPure(false); Some(other) => do { same <- equal(value,other); if same { _equalEntries(rest,b,equal) } else { ioPure(false) } } } } }
func equalCluster(a Cluster,b Cluster) IO[Bool] { do { same <- ioPure(a.locationOfOrigin == b.locationOfOrigin); if same { do { same <- ioPure(a.server == b.server); if same { do { same <- ioPure(a.tlsServerName == b.tlsServerName); if same { do { same <- ioPure(a.insecureSkipTLSVerify == b.insecureSkipTLSVerify); if same { do { same <- ioPure(a.certificateAuthority == b.certificateAuthority); if same { do { same <- equalOption(a.certificateAuthorityData,b.certificateAuthorityData,func(x,y) => ioPure(x == y)); if same { do { same <- ioPure(a.proxyURL == b.proxyURL); if same { do { same <- ioPure(a.disableCompression == b.disableCompression); if same { do { same <- equalOption(a.extensions,b.extensions,func(x,y) => equalMap(x,y,func(x,y) => objects.objectEqual(x,y))); if same { ioPure(true) } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } }
func equalContext(a Context,b Context) IO[Bool] { do { same <- ioPure(a.locationOfOrigin == b.locationOfOrigin); if same { do { same <- ioPure(a.cluster == b.cluster); if same { do { same <- ioPure(a.authInfo == b.authInfo); if same { do { same <- ioPure(a.namespace == b.namespace); if same { do { same <- equalOption(a.extensions,b.extensions,func(x,y) => equalMap(x,y,func(x,y) => objects.objectEqual(x,y))); if same { ioPure(true) } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } }
func equalAuthInfo(a AuthInfo,b AuthInfo) IO[Bool] { do { same <- ioPure(a.locationOfOrigin == b.locationOfOrigin); if same { do { same <- ioPure(a.clientCertificate == b.clientCertificate); if same { do { same <- equalOption(a.clientCertificateData,b.clientCertificateData,func(x,y) => ioPure(x == y)); if same { do { same <- ioPure(a.clientKey == b.clientKey); if same { do { same <- equalOption(a.clientKeyData,b.clientKeyData,func(x,y) => ioPure(x == y)); if same { do { same <- ioPure(a.token == b.token); if same { do { same <- ioPure(a.tokenFile == b.tokenFile); if same { do { same <- ioPure(a.impersonate == b.impersonate); if same { do { same <- ioPure(a.impersonateUID == b.impersonateUID); if same { do { same <- equalOption(a.impersonateGroups,b.impersonateGroups,func(x,y) => equalList(x,y,func(x,y) => ioPure(x == y))); if same { do { same <- equalOption(a.impersonateUserExtra,b.impersonateUserExtra,func(x,y) => equalMap(x,y,func(x,y) => equalOption(x,y,func(x,y) => equalList(x,y,func(x,y) => ioPure(x == y))))); if same { do { same <- ioPure(a.username == b.username); if same { do { same <- ioPure(a.password == b.password); if same { do { same <- equalOption(a.authProvider,b.authProvider,func(x,y) => equalAuthProviderConfig(x,y)); if same { do { same <- equalOption(a.exec,b.exec,func(x,y) => equalExecConfig(x,y)); if same { do { same <- equalOption(a.extensions,b.extensions,func(x,y) => equalMap(x,y,func(x,y) => objects.objectEqual(x,y))); if same { ioPure(true) } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } }
func equalPreferences(a Preferences,b Preferences) IO[Bool] { do { same <- ioPure(a.colors == b.colors); if same { do { same <- equalOption(a.extensions,b.extensions,func(x,y) => equalMap(x,y,func(x,y) => objects.objectEqual(x,y))); if same { ioPure(true) } else { ioPure(false) } } } else { ioPure(false) } } }
func equalConfig(a Config,b Config) IO[Bool] { do { same <- ioPure(a.kind == b.kind); if same { do { same <- ioPure(a.apiVersion == b.apiVersion); if same { do { same <- equalPreferences(a.preferences,b.preferences); if same { do { same <- equalOption(a.clusters,b.clusters,func(x,y) => equalMap(x,y,func(x,y) => equalOption(x,y,func(x,y) => equalCluster(x,y)))); if same { do { same <- equalOption(a.authInfos,b.authInfos,func(x,y) => equalMap(x,y,func(x,y) => equalOption(x,y,func(x,y) => equalAuthInfo(x,y)))); if same { do { same <- equalOption(a.contexts,b.contexts,func(x,y) => equalMap(x,y,func(x,y) => equalOption(x,y,func(x,y) => equalContext(x,y)))); if same { do { same <- ioPure(a.currentContext == b.currentContext); if same { do { same <- equalOption(a.extensions,b.extensions,func(x,y) => equalMap(x,y,func(x,y) => objects.objectEqual(x,y))); if same { ioPure(true) } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } }
func equalExecConfig(a ExecConfig,b ExecConfig) IO[Bool] { do { same <- ioPure(a.command == b.command); if same { do { same <- equalOption(a.args,b.args,func(x,y) => equalList(x,y,func(x,y) => ioPure(x == y))); if same { do { same <- equalOption(a.env,b.env,func(x,y) => equalList(x,y,func(x,y) => ioPure(x == y))); if same { do { same <- ioPure(a.apiVersion == b.apiVersion); if same { do { same <- ioPure(a.installHint == b.installHint); if same { do { same <- ioPure(a.provideClusterInfo == b.provideClusterInfo); if same { do { same <- objects.objectEqual(a.config,b.config); if same { do { same <- ioPure(a.interactiveMode == b.interactiveMode); if same { do { same <- ioPure(a.stdinUnavailable == b.stdinUnavailable); if same { do { same <- ioPure(a.stdinUnavailableMessage == b.stdinUnavailableMessage); if same { do { same <- ioPure(a.pluginPolicy == b.pluginPolicy); if same { ioPure(true) } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } } else { ioPure(false) } } }
func equalAuthProviderConfig(a AuthProviderConfig,b AuthProviderConfig) IO[Bool] { do { same <- ioPure(a.name == b.name); if same { do { same <- equalOption(a.config,b.config,func(x,y) => equalMap(x,y,func(x,y) => ioPure(x == y))); if same { ioPure(true) } else { ioPure(false) } } } else { ioPure(false) } } }
