package api
import schema "github.com/reoring/gofx/ports/client-go/deps/k8s.io/apimachinery/pkg/runtime/schema"
extern func _groupVersionKind(version String,kind String) schema.GroupVersionKind = "github.com/reoring/gofx/ports/client-go/tools/clientcmd/api/host".GroupVersionKind
extern func _versionAndKind(value schema.GroupVersionKind) (String,String) = "github.com/reoring/gofx/ports/client-go/tools/clientcmd/api/host".VersionAndKind
func groupVersionKind(value Config) schema.GroupVersionKind { _groupVersionKind(value.apiVersion,value.kind) }
func setGroupVersionKind(value Config,gvk schema.GroupVersionKind) Config { let pair = _versionAndKind(gvk); value{apiVersion:pair.0,kind:pair.1} }
func getObjectKind(value Config) Config { value }
func wireGroupVersionKind(value WireConfig) schema.GroupVersionKind { _groupVersionKind(value.apiVersion,value.kind) }
func wireSetGroupVersionKind(value WireConfig,gvk schema.GroupVersionKind) WireConfig { let pair = _versionAndKind(gvk); value{apiVersion:pair.0,kind:pair.1} }
func schemeGroupVersion() schema.GroupVersion { schema.groupVersionWithVersion(schema.newGroupVersion(),internalVersion()) }
