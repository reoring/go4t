func concatRawRecord(primary String,secondary String) String { primary + "," + secondary }
func multiLock(primary Interface,secondary Interface) Interface {
 Interface(func() => _multiGet(primary,secondary),func(r) => do { e <- primary.create(r); if _alreadyExistsOrNone(e) { secondary.create(r) } else { ioPure(e) } },func(r) => do { e <- primary.update(r); match e { Some(_) => ioPure(e); None => do { found <- secondary.get(); match found.error { Some(err) => if errors.errorIsNotFound(err) { secondary.create(r) } else { secondary.update(r) }; None => secondary.update(r) } } } },func(s) => do { primary.recordEvent(s); secondary.recordEvent(s) },primary.identity,primary.describe)
