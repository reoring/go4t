func _multiGet(primary Interface,secondary Interface) IO[outcome.Outcome[Option[(LeaderElectionRecord,String)]]] {
 do { a <- primary.get(); match a.error { Some(_) => ioPure(a); None => match a.value {
  None => ioPure(a)
  Some(first) => do { b <- secondary.get(); match b.error {
   Some(e) => if errors.errorIsNotFound(e) && first.0.holderIdentity != primary.identity { ioPure(a) } else { ioPure(outcome.failure(None,e)) }
   None => match b.value {
    None => ioPure(b)
    Some(second) => if first.0.holderIdentity == second.0.holderIdentity { ioPure(outcome.success(Some((first.0,concatRawRecord(first.1,second.1))))) }
     else { do { let record = first.0 { holderIdentity:unknownLeader() }; encoded <- encodeRecord(record); ioPure(outcome.Outcome(Some((record,concatRawRecord(encoded.value,second.1))),encoded.error)) } }
   }
  } }
