}
func _mergeLabels(base errors.ForeignMap[String,String],items List[(String,String)]) errors.ForeignMap[String,String] {
 match items { Nil => base; Cons(entry,rest) => _mergeLabels(errors.mapWith(base,entry.0,entry.1),rest) }
}
func update(lock LeaseLock,record LeaderElectionRecord) IO[Option[errors.Error]] {
 do { old <- sync.readRef(lock.lease); match old {
  None => ioPure(Some(errors.errorNew("lease not initialized, call get or create first")))
  Some(value) => do {
   let metadata = coord.leaseGetObjectMeta(value)
   let existing = meta.objectMetaGetLabels(metadata)
   let base = if !errors.mapIsNil(lock.labels) && errors.mapIsNil(existing) { errors.mapEmpty(existing) } else { existing }
   let labels = _mergeLabels(base,errors.mapEntries(lock.labels))
   let next = coord.leaseWithSpec(coord.leaseWithObjectMeta(value,meta.objectMetaWithLabels(metadata,labels)),leaderElectionRecordToLeaseSpec(record))
   // Keep the attempted spec even on conflict, but retain the last resourceVersion.
   sync.writeRef(lock.lease,Some(next)); result <- lock.client.update(next)
   match result.error { None => sync.writeRef(lock.lease,result.value); Some(_) => ioPure(unit()) }
   ioPure(result.error)
