func newWithLabels(kind String,namespace String,name String,client LeaseClient,config ResourceLockConfig,labels errors.ForeignMap[String,String]) IO[outcome.Outcome[Option[Interface]]] {
 if kind == "leases" { do { lock <- newLeaseLock(meta.objectMetaWithNamespace(meta.objectMetaWithName(meta.newObjectMeta(),name),namespace),client,config,labels); ioPure(outcome.success(Some(asInterface(lock)))) } }
 else { let message = match kind {
  "endpoints" => "endpoints lock is removed, migrate to leases"
  "configmaps" => "configmaps lock is removed, migrate to leases"
  "endpointsleases" => "endpointsleases lock is removed, migrate to leases"
  "configmapsleases" => "configmapsleases lock is removed, migrated to leases"
  _ => "Invalid lock-type " + kind
 }; ioPure(outcome.failure(None,errors.errorNew(message))) }
}
