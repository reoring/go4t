func recordEvent(lock LeaseLock,message String) IO[Unit] {
 match lock.lockConfig.eventRecorder {
  None => ioPure(unit())
  Some(recorder) => do {
   cached <- sync.readRef(lock.lease)
   let metadata = match cached { Some(value) => coord.leaseGetObjectMeta(value); None => lock.leaseMeta }
   let tm = meta.typeMetaWithAPIVersion(meta.typeMetaWithKind(meta.newTypeMeta(),"Lease"),"coordination.k8s.io/v1")
   let subject = coord.leaseWithTypeMeta(coord.leaseWithObjectMeta(coord.newLease(),metadata),tm)
   recorder.event(coord.leaseToRuntimeObject(subject),"Normal","LeaderElection",lock.lockConfig.identity + " " + message)
