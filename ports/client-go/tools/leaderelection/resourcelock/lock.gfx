func leaseSpecToLeaderElectionRecord(spec coord.LeaseSpec) LeaderElectionRecord {
 LeaderElectionRecord(_or(coord.leaseSpecGetHolderIdentity(spec),""),_or(coord.leaseSpecGetLeaseDurationSeconds(spec),0),_time(coord.leaseSpecGetAcquireTime(spec)),_time(coord.leaseSpecGetRenewTime(spec)),_or(coord.leaseSpecGetLeaseTransitions(spec),0),_or(coord.leaseSpecGetStrategy(spec),coord.newCoordinatedLeaseStrategy()),_or(coord.leaseSpecGetPreferredHolder(spec),""))
