func get(lock LeaseLock) IO[outcome.Outcome[Option[(LeaderElectionRecord,String)]]] {
 do { result <- lock.client.get(meta.objectMetaGetName(lock.leaseMeta));
  match result.error {
   Some(e) => ioPure(outcome.failure(None,e))
   None => match result.value {
    None => ioPure(outcome.failure(None,errors.errorNew("lease client returned no object")))
    Some(value) => do { sync.writeRef(lock.lease,Some(value)); let record = leaseSpecToLeaderElectionRecord(coord.leaseGetSpec(value)); encoded <- encodeRecord(record); ioPure(outcome.Outcome(Some((record,encoded.value)),encoded.error)) }
   }
  }
 }
}
func create(lock LeaseLock,record LeaderElectionRecord) IO[Option[errors.Error]] {
