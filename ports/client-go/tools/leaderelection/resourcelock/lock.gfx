  let metadata = meta.objectMetaWithLabels(meta.objectMetaWithNamespace(meta.objectMetaWithName(meta.newObjectMeta(),meta.objectMetaGetName(lock.leaseMeta)),meta.objectMetaGetNamespace(lock.leaseMeta)),lock.labels)
  let value = coord.leaseWithSpec(coord.leaseWithObjectMeta(coord.newLease(),metadata),leaderElectionRecordToLeaseSpec(record))
  result <- lock.client.create(value); sync.writeRef(lock.lease,result.value); ioPure(result.error)
