func _micro(value meta.Time) meta.MicroTime { meta.microTimeWithTime(meta.newMicroTime(),meta.timeGetTime(value)) }
func _nonempty(value String) Option[String] { if value == "" { None } else { Some(value) } }
func leaderElectionRecordToLeaseSpec(record LeaderElectionRecord) coord.LeaseSpec {
 let a = coord.leaseSpecWithHolderIdentity(coord.newLeaseSpec(),Some(record.holderIdentity))
 let b = coord.leaseSpecWithLeaseDurationSeconds(a,Some(_int32(record.leaseDurationSeconds)))
 let c = coord.leaseSpecWithAcquireTime(b,Some(_micro(record.acquireTime)))
 let d = coord.leaseSpecWithRenewTime(c,Some(_micro(record.renewTime)))
 let e = coord.leaseSpecWithLeaseTransitions(d,Some(_int32(record.leaderTransitions)))
 let f = coord.leaseSpecWithPreferredHolder(e,_nonempty(record.preferredHolder))
 coord.leaseSpecWithStrategy(f,if coord.coordinatedLeaseStrategyValue(record.strategy) == "" { None } else { Some(record.strategy) })
}
func _int32(value Int) Int { let low = value % 4294967296; let positive = if low < 0 { low + 4294967296 } else { low }; if positive >= 2147483648 { positive - 4294967296 } else { positive } }
// Marshal times through the canonical metav1 codec; integer fields never pass through Float.
func encodeRecord(record LeaderElectionRecord) IO[outcome.Outcome[String]] {
 do {
  a <- meta.timeCallMarshalJSON(record.acquireTime); b <- meta.timeCallMarshalJSON(record.renewTime)
  let err = match a.1.1 { Some(e) => Some(e); None => b.1.1 }
  let raw = "{\"holderIdentity\":" + json.toJson(json.JStr(record.holderIdentity)) + ",\"leaseDurationSeconds\":" + show(record.leaseDurationSeconds) + ",\"acquireTime\":" + _or(a.1.0,"null") + ",\"renewTime\":" + _or(b.1.0,"null") + ",\"leaderTransitions\":" + show(record.leaderTransitions) + ",\"strategy\":" + json.toJson(json.JStr(coord.coordinatedLeaseStrategyValue(record.strategy))) + ",\"preferredHolder\":" + json.toJson(json.JStr(record.preferredHolder)) + "}"
  ioPure(outcome.Outcome(raw,err))
