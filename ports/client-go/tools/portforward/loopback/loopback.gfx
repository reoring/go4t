package loopback
import forward "github.com/reoring/gofx/ports/client-go/tools/portforward"
import spdy "github.com/reoring/gofx/ports/client-go/transport/spdy"
import raw "github.com/reoring/gofx/ports/client-go/deps/k8s.io/streaming/pkg/httpstream"
import outcome "github.com/reoring/gofx/ports/client-go/support/outcome"
import errors "github.com/reoring/gofx/ports/client-go/deps/support"
import sync "github.com/reoring/gofx/ports/client-go/support/sync"
import io "std/io"

type Fixture = FixtureHandle
extern func _open(fail Bool) IO[Fixture] = "github.com/reoring/gofx/ports/client-go/tools/portforward/loopback/host".Open
extern func _connection(fixture Fixture) IO[raw.Connection] = "github.com/reoring/gofx/ports/client-go/tools/portforward/loopback/host".Connection
extern func _exchange(port Int) IO[Bool] = "github.com/reoring/gofx/ports/client-go/tools/portforward/loopback/host".Exchange
extern func _result(fixture Fixture) IO[Bool] = "github.com/reoring/gofx/ports/client-go/tools/portforward/loopback/host".Result
extern func _close(fixture Fixture) IO[Unit] = "github.com/reoring/gofx/ports/client-go/tools/portforward/loopback/host".Close
func runCase(fail Bool) IO[Bool] {sync.bracket(_open(fail),func(fixture)=>do {
 raw<-_connection(fixture)
 let connection=spdy.fromConnection(raw)
 let dialer=spdy.Dialer {dial:func(_)=>ioPure(outcome.success(spdy.DialResult {connection:Some(connection),protocol:forward.portForwardProtocolV1Name()}))}
 stop<-sync.newChannel(0)
 ready<-sync.newChannel(0)
 made<-forward.newOnAddresses(dialer,["127.0.0.1"],["0:80"],stop,Some(ready),None,None)
 match made.value {None=>ioPure(false);Some(f)=>sync.bracket(sync.start(forward.forwardPorts(f)),func(task)=>do {
  _ <- sync.receive(ready)
  ports<-forward.getPorts(f)
  match ports.value {Nil=>ioPure(false);Cons(port,_)=>do {
   exchanged<-_exchange(port.local)
   server<-_result(fixture)
   if fail {ioPure(unit())} else {sync.send(stop,unit())}
   result<-sync.join(task)
   ioPure(exchanged && server && (if fail {match result.error {Some(e)=>errors.errorMessage(e)=="lost connection to pod";None=>false}} else {match result.error {None=>true;Some(_)=>false}}))
  }}
 },func(task)=>do {sync.close(stop);sync.cancelTask(task);connection.close();forward.close(f);_ <- io.tryIO(sync.join(task));ioPure(unit())})}
},_close)}
func run() IO[Bool] {do {success<-runCase(false);failure<-runCase(true);tunnel<-runTunnel();ioPure(success && failure && tunnel)}}
